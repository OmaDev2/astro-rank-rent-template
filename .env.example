# Environment Variables Template
# Copy this file to .env and fill in your values

# Site Configuration
PUBLIC_SITE_URL=https://yourdomain.com

# Google Analytics (Optional)
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Netlify (Automatically set in production)
# NETLIFY=true

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# IndexNow (Optional) — notifica a Bing/Yandex/buscadores de IA tras el deploy.
# Genera una clave con `openssl rand -hex 16` y ejecuta `npm run indexnow`.
INDEXNOW_KEY=

