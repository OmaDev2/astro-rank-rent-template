---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/layout/Footer.astro";
import type { Block } from "../types";
import FinalCTA from "../components/sections/FinalCTA.astro";
import { getCollection, getEntry } from "astro:content";
import {
  MapPin,
  ArrowRight,
  Home,
  Building2,
  Factory,
  Search,
  CheckCircle2,
  Phone,
  MessageCircle,
  Wrench,
} from "lucide-react";
import { buildBlogListGraph } from "@/lib/seo";

const locations = await getCollection("locations");
const services = await getCollection("services");

// Fetch Global Settings (Dinámico)
import { getSettings } from "@/lib/settings";
const settings = await getSettings();
const { siteName, city, niche, phone, whatsapp, areaServed } = settings;

const normalizeAreaName = (value: string) =>
  value.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").trim();

const linkedLocationNames = new Set(
  locations.map((loc) => normalizeAreaName(loc.data.name)),
);
const unlinkedCoverageAreas = (areaServed as string[]).filter(
  (area) => !linkedLocationNames.has(normalizeAreaName(area)),
);

// Agrupar por tipo
const residenciales = locations.filter(
  (loc) => loc.data.type === "residencial",
);
const industriales = locations.filter((loc) => loc.data.type === "industrial");
const centros = locations.filter((loc) => loc.data.type === "centro");

// Quitar referencia a la ciudad principal de los títulos de servicio
const _escapeRE = (v: string) => v.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const cleanServiceTitle = (title: string) => {
  if (!city) return title.trim();
  const e = _escapeRE(city);
  return title
    .replace(new RegExp(`\\s+en\\s+${e}\\b`, "gi"), "")
    .replace(new RegExp(`\\s+${e}\\b`, "gi"), "")
    .replace(/\s+/g, " ")
    .trim();
};

// Orden configurable desde global.yaml → servicePriority; fallback: orden natural
const SERVICE_PRIORITY: string[] = settings.servicePriority?.length
  ? settings.servicePriority
  : [];

const sortedServices = [...services]
  .sort((a, b) => {
    const ia = SERVICE_PRIORITY.indexOf(a.slug);
    const ib = SERVICE_PRIORITY.indexOf(b.slug);
    if (ia !== -1 && ib !== -1) return ia - ib;
    if (ia !== -1) return -1;
    if (ib !== -1) return 1;
    return 0;
  })
  .slice(0, 6);

const getSeoDesc = (seoStr: string | undefined, defaultDesc: string) => {
  try {
    return JSON.parse(seoStr || "{}").description || defaultDesc;
  } catch {
    return defaultDesc;
  }
};

// 3. Page Builder Data
const zonasPage = await getEntry("pages", "zonas");
type ZonasPageData = NonNullable<typeof zonasPage>["data"];
const zonasPageData = (zonasPage?.data ?? {}) as Partial<ZonasPageData>;

const parsePreview = (json: string) => {
  try {
    return json ? JSON.parse(json) : null;
  } catch (_) {
    return null;
  }
};

const seoPreviewData = parsePreview(zonasPageData.seoControls as string);
const seoTitle =
  seoPreviewData?.title || `Zonas de Servicio en ${city} | ${siteName}`;
const seoDescription =
  seoPreviewData?.description ||
  `${niche} en ${city} y provincia. Presupuesto sin compromiso.`;

const defaultBlocks = [{ discriminant: "hero" }];

const fallbackBlocks = [
  {
    discriminant: "hero",
    value: {},
  },
] satisfies Block[];

const finalBlocks: Block[] =
  zonasPageData.blocks && zonasPageData.blocks.length > 0
    ? zonasPageData.blocks
    : fallbackBlocks;

import BlockRenderer from "../components/BlockRenderer.astro";
import Breadcrumbs from "../components/navigation/Breadcrumbs.astro";

const siteUrl = settings.siteUrl || Astro.site?.href || "";
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = buildBlogListGraph({
  settings,
  siteUrl,
  pageUrl,
  title: seoTitle,
  description: seoDescription,
  breadcrumbs: [
    { name: "Inicio", item: new URL("/", Astro.site).href },
    { name: "Zonas", item: pageUrl },
  ],
  posts: locations.map((loc) => ({
    url: `${siteUrl.replace(/\/$/, "")}/zona/${loc.slug}/`,
    title: loc.data.name,
  })),
});
---

<Layout title={seoTitle} description={seoDescription} schema={schema}>
  <Breadcrumbs pageName="Zonas" noSchema />

  {/* --- BLOQUES CMS (hero, stats, cta desde zonas.mdx) --- */}
  <BlockRenderer
    blocks={finalBlocks}
    config={settings}
    city={city}
    locationName={city}
    niche={niche}
    phone={phone}
    whatsapp={whatsapp}
  />

  {/* --- ZONAS LIST --- */}
  <section id="zonas-list" class="py-16 bg-secondary relative overflow-hidden">
    {/* Decorative background blurs */}
    <div
      class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/2"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] pointer-events-none translate-y-1/2 -translate-x-1/2"
    >
    </div>

    <div class="container mx-auto px-4 relative z-10 space-y-16">
      {/* ── Zonas Residenciales ────────────────────────────── */}
      {
        residenciales.length > 0 && (
          <div id="zonas-principales">
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 border-b border-white/5 pb-6">
              <div>
                <div class="flex items-center gap-3 mb-3 text-primary">
                  <span class="p-2 rounded-lg bg-primary/10 border border-primary/20">
                    <Home className="w-5 h-5" />
                  </span>
                  <span class="text-sm font-bold tracking-[0.2em] uppercase text-text/70">
                    Zonas principales
                  </span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-heading tracking-tight">
                  Zonas principales donde trabajamos
                </h2>
              </div>
              <p class="text-text/70 text-base md:text-lg max-w-xl leading-relaxed lg:text-right text-pretty">
                Selecciona tu zona para ver información específica sobre{" "}
                {niche.toLowerCase()} y presupuesto personalizado.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {residenciales.map((location) => (
                <a
                  href={`/zona/${location.slug}/`}
                  class="group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-6 transition-all duration-300 hover:bg-white/10 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-0.5"
                >
                  <div>
                    <div class="flex justify-between items-start mb-4">
                      <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 group-hover:bg-primary/20 group-hover:border-primary/30 transition-colors">
                        <MapPin className="w-5 h-5 text-text/50 group-hover:text-primary transition-colors" />
                      </div>
                      <ArrowRight className="w-6 h-6 text-text/50 group-hover:text-primary transform -translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300" />
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-heading mb-2 group-hover:text-primary transition-colors">
                      {location.data.name}
                    </h3>
                    <p class="text-text/60 text-sm line-clamp-2 mb-4">
                      {getSeoDesc(
                        location.data.seo,
                        `${niche} en ${location.data.name}. Presupuesto sin compromiso.`,
                      )}
                    </p>
                  </div>
                  <div class="border-t border-white/5 pt-4 flex items-center justify-between">
                    <span class="text-sm font-bold text-primary group-hover:text-accent transition-colors">
                      Ver servicios en {location.data.name}
                    </span>
                    <ArrowRight className="w-4 h-4 text-primary group-hover:text-accent group-hover:translate-x-1 transition-all duration-200 shrink-0" />
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* ── Zonas Industriales ────────────────────────────── */}
      {
        industriales.length > 0 && (
          <div>
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 border-b border-white/5 pb-6">
              <div>
                <div class="flex items-center gap-3 mb-3 text-primary">
                  <span class="p-2 rounded-lg bg-primary/10 border border-primary/20">
                    <Factory className="w-5 h-5" />
                  </span>
                  <span class="text-sm font-bold tracking-[0.2em] uppercase text-text/70">
                    Industrial y comercial
                  </span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-heading tracking-tight">
                  Zonas industriales y comerciales
                </h2>
              </div>
              <p class="text-text/70 text-base md:text-lg max-w-xl leading-relaxed lg:text-right text-pretty">
                {niche} para naves industriales, locales y espacios comerciales.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {industriales.map((location) => (
                <a
                  href={`/zona/${location.slug}/`}
                  class="group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-6 transition-all duration-300 hover:bg-white/10 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-0.5"
                >
                  <div>
                    <div class="flex justify-between items-start mb-4">
                      <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 group-hover:bg-primary/20 group-hover:border-primary/30 transition-colors">
                        <Factory className="w-5 h-5 text-text/50 group-hover:text-primary transition-colors" />
                      </div>
                      <ArrowRight className="w-6 h-6 text-text/50 group-hover:text-primary transform -translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300" />
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-heading mb-2 group-hover:text-primary transition-colors">
                      {location.data.name}
                    </h3>
                    <p class="text-text/60 text-sm line-clamp-2 mb-4">
                      {getSeoDesc(
                        location.data.seo,
                        `${niche} industrial en ${location.data.name}.`,
                      )}
                    </p>
                  </div>
                  <div class="border-t border-white/5 pt-4 flex items-center justify-between">
                    <span class="text-sm font-bold text-primary group-hover:text-accent transition-colors">
                      Ver servicios en {location.data.name}
                    </span>
                    <ArrowRight className="w-4 h-4 text-primary group-hover:text-accent group-hover:translate-x-1 transition-all duration-200 shrink-0" />
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* ── Centros Urbanos ───────────────────────────────── */}
      {
        centros.length > 0 && (
          <div>
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 border-b border-white/5 pb-6">
              <div>
                <div class="flex items-center gap-3 mb-3 text-primary">
                  <span class="p-2 rounded-lg bg-primary/10 border border-primary/20">
                    <Building2 className="w-5 h-5" />
                  </span>
                  <span class="text-sm font-bold tracking-[0.2em] uppercase text-text/70">
                    Centro urbano
                  </span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-heading tracking-tight">
                  Centro y zonas urbanas
                </h2>
              </div>
              <p class="text-text/70 text-base md:text-lg max-w-xl leading-relaxed lg:text-right text-pretty">
                {niche} en el centro de la ciudad. Instalación profesional en
                locales, viviendas y edificios con mínimas molestias.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {centros.map((location) => (
                <a
                  href={`/zona/${location.slug}/`}
                  class="group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-6 transition-all duration-300 hover:bg-white/10 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-0.5"
                >
                  <div>
                    <div class="flex justify-between items-start mb-4">
                      <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 group-hover:bg-primary/20 group-hover:border-primary/30 transition-colors">
                        <Building2 className="w-5 h-5 text-text/50 group-hover:text-primary transition-colors" />
                      </div>
                      <ArrowRight className="w-6 h-6 text-text/50 group-hover:text-primary transform -translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300" />
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-heading mb-2 group-hover:text-primary transition-colors">
                      {location.data.name}
                    </h3>
                    <p class="text-text/60 text-sm line-clamp-2 mb-4">
                      {getSeoDesc(
                        location.data.seo,
                        `${niche} en ${location.data.name}. Instalación profesional a medida.`,
                      )}
                    </p>
                  </div>
                  <div class="border-t border-white/5 pt-4 flex items-center justify-between">
                    <span class="text-sm font-bold text-primary group-hover:text-accent transition-colors">
                      Ver servicios en {location.data.name}
                    </span>
                    <ArrowRight className="w-4 h-4 text-primary group-hover:text-accent group-hover:translate-x-1 transition-all duration-200 shrink-0" />
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* ── Otras poblaciones (sin página propia) ─────────── */}
      {
        unlinkedCoverageAreas.length > 0 && (
          <div>
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 border-b border-white/5 pb-6">
              <div>
                <div class="flex items-center gap-3 mb-3 text-primary">
                  <span class="p-2 rounded-lg bg-primary/10 border border-primary/20">
                    <MapPin className="w-5 h-5" />
                  </span>
                  <span class="text-sm font-bold tracking-[0.2em] uppercase text-text/70">
                    Más zonas
                  </span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-heading tracking-tight">
                  Otras poblaciones donde trabajamos
                </h2>
              </div>
              <p class="text-text/70 text-base md:text-lg max-w-xl leading-relaxed lg:text-right text-pretty">
                También realizamos trabajos de {niche.toLowerCase()} en otros
                municipios de {city} y alrededores. Si no ves tu zona,
                consúltanos y te confirmamos disponibilidad.
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              {unlinkedCoverageAreas.slice(0, 20).map((area) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/8 text-text/60 text-sm cursor-default select-none">
                  <MapPin className="w-3 h-3 text-primary/40 shrink-0" />
                  {area}
                </span>
              ))}
              {unlinkedCoverageAreas.length > 20 && (
                <span class="inline-flex items-center px-3 py-1.5 text-text/40 text-sm italic">
                  y otros municipios cercanos
                </span>
              )}
            </div>
          </div>
        )
      }

      {/* ── Servicios disponibles en todas las zonas ──────── */}
      {
        sortedServices.length > 0 && (
          <div>
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 border-b border-white/5 pb-6">
              <div>
                <div class="flex items-center gap-3 mb-3 text-primary">
                  <span class="p-2 rounded-lg bg-primary/10 border border-primary/20">
                    <Wrench className="w-5 h-5" />
                  </span>
                  <span class="text-sm font-bold tracking-[0.2em] uppercase text-text/70">
                    Qué instalamos
                  </span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-heading tracking-tight">
                  Servicios disponibles en nuestras zonas de cobertura
                </h2>
              </div>
              <p class="text-text/70 text-base max-w-xl leading-relaxed lg:text-right text-pretty">
                {niche} disponible en todas nuestras zonas. Presupuesto
                personalizado sin compromiso.
              </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {sortedServices.map((service) => (
                <a
                  href={`/servicios/${service.slug}/`}
                  class="group flex items-center gap-4 p-5 rounded-xl bg-white/5 border border-white/10 hover:border-primary/40 hover:bg-white/10 transition-all duration-200"
                >
                  <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                    <Wrench className="w-4 h-4 text-primary" />
                  </div>
                  <span class="font-semibold text-heading group-hover:text-primary transition-colors text-sm md:text-base">
                    {cleanServiceTitle(service.data.title)}
                  </span>
                  <ArrowRight className="w-4 h-4 text-text/30 group-hover:text-primary ml-auto shrink-0 transition-colors" />
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* ── CTA final ─────────────────────────────────────── */}
      <div
        class="relative overflow-hidden rounded-3xl bg-surface/50 border border-white/10 p-12 lg:p-24 text-center"
      >
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-r from-secondary via-transparent to-secondary pointer-events-none"
        >
        </div>

        <div class="relative z-10 max-w-3xl mx-auto">
          <div
            class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-8 border border-white/10 shadow-xl shadow-black/50"
          >
            <MapPin className="w-8 h-8 text-heading" />
          </div>

          <h3
            class="text-3xl md:text-5xl font-black text-heading mb-6 tracking-tight"
          >
            ¿No ves tu municipio?
          </h3>
          <p class="text-xl text-text/80 mb-10 leading-relaxed text-pretty">
            Trabajamos en {city} y alrededores. Escríbenos y te confirmamos disponibilidad
            para tu zona sin compromiso.
          </p>

          <div
            class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-2"
          >
            <a
              href={`https://wa.me/${whatsapp.replace(/\s/g, "")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full sm:w-auto inline-flex items-center justify-center gap-2 py-4 px-8 text-base font-bold"
            >
              <MessageCircle className="w-5 h-5 shrink-0" />
              WhatsApp
            </a>
            <a
              href={`tel:${phone.replace(/\s/g, "")}`}
              class="btn-secondary w-full sm:w-auto inline-flex items-center justify-center gap-2 py-4 px-8 text-base font-bold"
            >
              <Phone className="w-5 h-5 shrink-0" />
              Llamar ahora
            </a>
            <a
              href="/contacto/"
              class="btn-cta w-full sm:w-auto inline-flex items-center justify-center gap-2 py-4 px-8 text-base font-bold"
            >
              Pedir presupuesto
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
