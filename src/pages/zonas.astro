---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { getCollection, getEntry } from "astro:content";
import { MapPin, ArrowRight, Home, Building2, Factory } from "lucide-react";
import type { WithContext, CollectionPage } from "schema-dts";

const locations = await getCollection("locations");

// Fetch Global Settings (Dinámico)
const business = await getEntry("business", "global");
const { siteName, city, niche } = business?.data || {
    siteName: "Nombre Negocio",
    city: "Ciudad",
    niche: "Servicio Profesional",
};

// Agrupar por tipo
const residenciales = locations.filter(
    (loc) => loc.data.type === "residencial",
);
const industriales = locations.filter((loc) => loc.data.type === "industrial");
const centros = locations.filter((loc) => loc.data.type === "centro");

const schema: WithContext<CollectionPage> = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Zonas de Servicio - ${siteName}`,
    description: `Servicio de ${niche} en ${city} y alrededores. Consulta cobertura.`,
};
---

<Layout
    title={`Cobertura Premium | ${siteName}`}
    description={`Servicio de ${niche} líder en ${city} y toda la provincia. Consulta nuestras zonas de cobertura especializada.`}
    schema={schema}
>
    {/* --- HERO SECTION PREMIUM --- */}
    <section
        class="relative min-h-[50vh] flex items-center justify-center overflow-hidden bg-zinc-950"
    >
        <div class="absolute inset-0 z-0">
            <div
                class="absolute inset-0 bg-gradient-to-b from-zinc-950/50 via-zinc-950/80 to-zinc-950 z-10"
            >
            </div>
            <img
                src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2301&auto=format&fit=crop"
                alt="Fondo Abstracto"
                class="w-full h-full object-cover opacity-30 mix-blend-overlay grayscale"
            />
        </div>

        <div class="container mx-auto px-4 relative z-20 text-center">
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 backdrop-blur-md border border-white/10 mb-8 animate-fade-in-up"
            >
                <MapPin className="w-4 h-4 text-primary-400" />
                <span
                    class="text-xs font-bold tracking-[0.2em] text-white/80 uppercase"
                    >Cobertura Oficial</span
                >
            </div>

            <h1
                class="text-5xl md:text-7xl font-black text-white mb-6 tracking-tight leading-tight uppercase animate-fade-in-up delay-100"
            >
                Donde Tú <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-indigo-400"
                    >Estás</span
                >
            </h1>

            <p
                class="text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto leading-relaxed animate-fade-in-up delay-200"
            >
                Desplegamos nuestros equipos de {niche} en {city} capital y los principales
                distritos. Servicio rápido, discreto y de alta gama.
            </p>
        </div>
    </section>

    {/* --- ZONAS CONTENT --- */}
    <section class="py-24 bg-zinc-950 border-t border-white/5 relative">
        {/* Decorative elements */}
        <div
            class="absolute top-0 left-1/4 w-96 h-96 bg-primary-500/10 rounded-full blur-[100px] pointer-events-none"
        >
        </div>
        <div
            class="absolute bottom-0 right-1/4 w-96 h-96 bg-indigo-500/10 rounded-full blur-[100px] pointer-events-none"
        >
        </div>

        <div class="container mx-auto px-4 relative z-10 space-y-24">
            {/* Zonas Residenciales */}
            {
                residenciales.length > 0 && (
                    <div class="group/section">
                        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-white/10 pb-8">
                            <div>
                                <div class="flex items-center gap-3 mb-2 text-primary-400">
                                    <Home className="w-6 h-6" />
                                    <span class="text-sm font-bold tracking-widest uppercase">
                                        Barrios Exclusivos
                                    </span>
                                </div>
                                <h2 class="text-4xl font-bold text-white">
                                    Residencial
                                </h2>
                            </div>
                            <p class="text-zinc-500 text-sm max-w-md text-right md:text-left">
                                Atención prioritaria en urbanizaciones privadas
                                y domicilios particulares.
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {residenciales.map((location) => (
                                <a
                                    href={`/zona/${location.slug}/`}
                                    class="group relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-8 transition-all hover:bg-white/10 hover:border-primary-500/50 hover:shadow-2xl hover:shadow-primary-500/10 hover:-translate-y-1"
                                >
                                    <div class="absolute top-0 right-0 p-6 opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-0 translate-x-4">
                                        <ArrowRight className="w-6 h-6 text-primary-400" />
                                    </div>

                                    <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-primary-400 transition-colors">
                                        {location.data.name}
                                    </h3>

                                    <div class="flex flex-wrap gap-2 mt-4">
                                        {location.data.zipCodes
                                            .slice(0, 3)
                                            .map((zip) => (
                                                <span class="text-xs font-mono px-2 py-1 bg-black/30 text-zinc-400 rounded border border-white/5">
                                                    {zip}
                                                </span>
                                            ))}
                                        {location.data.zipCodes.length > 3 && (
                                            <span class="text-xs font-mono px-2 py-1 bg-black/30 text-zinc-500 rounded border border-white/5">
                                                +
                                                {location.data.zipCodes.length -
                                                    3}
                                            </span>
                                        )}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            {/* Zonas Industriales */}
            {
                industriales.length > 0 && (
                    <div class="group/section">
                        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-white/10 pb-8">
                            <div>
                                <div class="flex items-center gap-3 mb-2 text-amber-400">
                                    <Factory className="w-6 h-6" />
                                    <span class="text-sm font-bold tracking-widest uppercase">
                                        Empresas y Naves
                                    </span>
                                </div>
                                <h2 class="text-4xl font-bold text-white">
                                    Industrial
                                </h2>
                            </div>
                            <p class="text-zinc-500 text-sm max-w-md text-right md:text-left">
                                Soluciones de gran escala para polígonos y
                                centros logísticos.
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {industriales.map((location) => (
                                <a
                                    href={`/zona/${location.slug}/`}
                                    class="group relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-8 transition-all hover:bg-white/10 hover:border-amber-500/50 hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1"
                                >
                                    <div class="absolute top-0 right-0 p-6 opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-0 translate-x-4">
                                        <ArrowRight className="w-6 h-6 text-amber-400" />
                                    </div>
                                    <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-amber-400 transition-colors">
                                        {location.data.name}
                                    </h3>
                                    <div class="flex flex-wrap gap-2 mt-4">
                                        {location.data.zipCodes
                                            .slice(0, 3)
                                            .map((zip) => (
                                                <span class="text-xs font-mono px-2 py-1 bg-black/30 text-zinc-400 rounded border border-white/5">
                                                    {zip}
                                                </span>
                                            ))}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            {/* Centros Urbanos */}
            {
                centros.length > 0 && (
                    <div class="group/section">
                        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-white/10 pb-8">
                            <div>
                                <div class="flex items-center gap-3 mb-2 text-emerald-400">
                                    <Building2 className="w-6 h-6" />
                                    <span class="text-sm font-bold tracking-widest uppercase">
                                        Centro Ciudad
                                    </span>
                                </div>
                                <h2 class="text-4xl font-bold text-white">
                                    Distritos Centro
                                </h2>
                            </div>
                            <p class="text-zinc-500 text-sm max-w-md text-right md:text-left">
                                Operativa adaptada a zonas de tráfico
                                restringido y horarios comerciales.
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {centros.map((location) => (
                                <a
                                    href={`/zona/${location.slug}/`}
                                    class="group relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-8 transition-all hover:bg-white/10 hover:border-emerald-500/50 hover:shadow-2xl hover:shadow-emerald-500/10 hover:-translate-y-1"
                                >
                                    <div class="absolute top-0 right-0 p-6 opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-0 translate-x-4">
                                        <ArrowRight className="w-6 h-6 text-emerald-400" />
                                    </div>
                                    <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-emerald-400 transition-colors">
                                        {location.data.name}
                                    </h3>
                                    <div class="flex flex-wrap gap-2 mt-4">
                                        {location.data.zipCodes
                                            .slice(0, 3)
                                            .map((zip) => (
                                                <span class="text-xs font-mono px-2 py-1 bg-black/30 text-zinc-400 rounded border border-white/5">
                                                    {zip}
                                                </span>
                                            ))}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            {/* Empty State / CTA Final */}
            <div
                class="mt-24 rounded-3xl bg-gradient-to-r from-zinc-900 to-black border border-white/10 p-12 text-center relative overflow-hidden group"
            >
                <div
                    class="absolute inset-0 bg-grid-white/[0.02] bg-[size:32px_32px] pointer-events-none"
                >
                </div>
                <div class="relative z-10">
                    <h3 class="text-3xl font-bold text-white mb-4">
                        ¿Tu zona no aparece en la lista?
                    </h3>
                    <p class="text-zinc-400 mb-8 max-w-2xl mx-auto">
                        Cubrimos prácticamente toda la región. Si no ves tu
                        barrio o código postal, contáctanos directamente para
                        confirmar disponibilidad.
                    </p>
                    <a
                        href="/contacto/"
                        class="inline-flex items-center gap-3 px-8 py-4 bg-white text-black font-bold text-sm tracking-widest uppercase rounded-full hover:bg-zinc-200 transition-colors"
                    >
                        Consultar Disponibilidad <ArrowRight
                            className="w-4 h-4"
                        />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <FinalCTA />
    <Footer />
</Layout>
