---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { getCollection, getEntry } from "astro:content";
import { MapPin, ArrowRight, Home, Building2, Factory } from "lucide-react";
import type { WithContext, CollectionPage } from "schema-dts";

const locations = await getCollection("locations");

// Fetch Global Settings (Dinámico)
const settings = await getEntry("settings", "global");
const { siteName, city, niche } = settings?.data || {
    siteName: "Nombre Negocio",
    city: "Ciudad",
    niche: "Servicio Profesional",
};

// Agrupar por tipo
const residenciales = locations.filter(
    (loc) => loc.data.type === "residencial",
);
const industriales = locations.filter((loc) => loc.data.type === "industrial");
const centros = locations.filter((loc) => loc.data.type === "centro");

const schema: WithContext<CollectionPage> = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Zonas de Servicio - ${siteName}`,
    description: `Servicio de ${niche} en ${city} y alrededores. Consulta cobertura.`,
};
---

<Layout
    title={`Zonas de Servicio | ${siteName}`}
    description={`Cobertura de ${niche} en ${city} y provincia.`}
    schema={schema}
>
    <section class="relative py-20 bg-secondary overflow-hidden">
        <div
            class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=2074&auto=format&fit=crop')] bg-cover bg-center opacity-10"
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-b from-secondary via-secondary/90 to-secondary"
        >
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl mx-auto text-center">
                <div class="flex items-center justify-center gap-2 mb-6">
                    <MapPin className="w-8 h-8 text-primary" />
                    <span
                        class="text-primary font-bold uppercase tracking-widest text-sm"
                        >Cobertura Total</span
                    >
                </div>
                <h1
                    class="text-5xl lg:text-6xl font-heading font-bold text-white mb-6"
                >
                    Zonas de Servicio
                </h1>
                <p class="text-xl text-slate-300 leading-relaxed">
                    Ofrecemos servicios de {niche} profesional en {city} capital
                    y toda la provincia. Consulta si llegamos a tu zona.
                </p>
            </div>
        </div>
    </section>

    <section class="py-20 bg-secondary border-t border-white/5">
        <div class="container mx-auto px-4">
            {
                residenciales.length > 0 && (
                    <div class="mb-16">
                        <div class="flex items-center gap-3 mb-8">
                            <div class="p-3 bg-primary/20 rounded-lg">
                                <Home className="w-6 h-6 text-primary" />
                            </div>
                            <div>
                                <h2 class="text-3xl font-heading font-bold text-white">
                                    Zonas Residenciales
                                </h2>
                                <p class="text-slate-400 text-sm">
                                    Viviendas y comunidades
                                </p>
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {residenciales.map((location) => (
                                <a
                                    href={`/zona/${location.slug}/`}
                                    class="group p-6 bg-slate-900/50 border border-white/10 rounded-lg hover:border-primary/50 transition-all hover:shadow-xl hover:shadow-primary/10"
                                >
                                    <div class="flex items-start justify-between mb-4">
                                        <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">
                                            {location.data.name}
                                        </h3>
                                        <ArrowRight className="w-5 h-5 text-slate-500 group-hover:text-primary group-hover:translate-x-1 transition-all" />
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {location.data.zipCodes.map((zip) => (
                                            <span class="text-xs px-2 py-1 bg-white/5 text-slate-400 rounded">
                                                CP {zip}
                                            </span>
                                        ))}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            {
                industriales.length > 0 && (
                    <div class="mb-16">
                        <div class="flex items-center gap-3 mb-8">
                            <div class="p-3 bg-primary/20 rounded-lg">
                                <Factory className="w-6 h-6 text-primary" />
                            </div>
                            <div>
                                <h2 class="text-3xl font-heading font-bold text-white">
                                    Polígonos Industriales
                                </h2>
                                <p class="text-slate-400 text-sm">
                                    Empresas y naves
                                </p>
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {industriales.map((location) => (
                                <a
                                    href={`/zona/${location.slug}/`}
                                    class="group p-6 bg-slate-900/50 border border-white/10 rounded-lg hover:border-primary/50 transition-all hover:shadow-xl hover:shadow-primary/10"
                                >
                                    <div class="flex items-start justify-between mb-4">
                                        <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">
                                            {location.data.name}
                                        </h3>
                                        <ArrowRight className="w-5 h-5 text-slate-500 group-hover:text-primary group-hover:translate-x-1 transition-all" />
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {location.data.zipCodes.map((zip) => (
                                            <span class="text-xs px-2 py-1 bg-white/5 text-slate-400 rounded">
                                                CP {zip}
                                            </span>
                                        ))}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            {
                centros.length > 0 && (
                    <div>
                        <div class="flex items-center gap-3 mb-8">
                            <div class="p-3 bg-primary/20 rounded-lg">
                                <Building2 className="w-6 h-6 text-primary" />
                            </div>
                            <div>
                                <h2 class="text-3xl font-heading font-bold text-white">
                                    Centros Urbanos
                                </h2>
                                <p class="text-slate-400 text-sm">
                                    Zonas céntricas
                                </p>
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {centros.map((location) => (
                                <a
                                    href={`/zona/${location.slug}/`}
                                    class="group p-6 bg-slate-900/50 border border-white/10 rounded-lg hover:border-primary/50 transition-all hover:shadow-xl hover:shadow-primary/10"
                                >
                                    <div class="flex items-start justify-between mb-4">
                                        <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">
                                            {location.data.name}
                                        </h3>
                                        <ArrowRight className="w-5 h-5 text-slate-500 group-hover:text-primary group-hover:translate-x-1 transition-all" />
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {location.data.zipCodes.map((zip) => (
                                            <span class="text-xs px-2 py-1 bg-white/5 text-slate-400 rounded">
                                                CP {zip}
                                            </span>
                                        ))}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            <div
                class="mt-16 p-8 bg-gradient-to-r from-primary/20 to-accent/20 border border-primary/30 rounded-xl text-center"
            >
                <h3 class="text-2xl font-bold text-white mb-3">
                    ¿No encuentras tu zona?
                </h3>
                <p class="text-slate-300 mb-6">
                    Aunque no esté listada, es probable que lleguemos. Consulta
                    sin compromiso.
                </p>
                <a
                    href="/contacto/"
                    class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-accent text-white font-bold rounded transition-colors shadow-lg hover:shadow-primary/20"
                >
                    Contactar Ahora
                    <ArrowRight className="w-5 h-5 ml-2" />
                </a>
            </div>
        </div>
    </section>

    <FinalCTA />
    <Footer />
</Layout>
