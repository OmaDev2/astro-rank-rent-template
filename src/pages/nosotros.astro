---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/layout/Footer.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
import Breadcrumbs from "../components/navigation/Breadcrumbs.astro";
import { getEntry } from "astro:content";
import {
    Award,
    Users,
    Shield,
    Wrench,
    CheckCircle,
    Clock,
    Target,
    Heart,
    Calculator,
    Star
} from "lucide-react";

// 1. Fetch Global Settings & Singleton
import { getSettings } from "@/lib/settings";
const settings = await getSettings();
const { siteName, city, niche, phone, whatsapp } = settings;

const aboutEntry = await getEntry("about", "index");
const aboutData = aboutEntry?.data;

// 2. Import History MDX Content
// For singletons with MDX fields, static import is the most reliable way in Astro.
import HistoryContent from "../content/about/index/history/content.mdx";

// Dynamic template variables
const historyVars = {
    year: new Date().getFullYear() - 10,
    years: 10,
    projects: 100,
    niche: niche.toLowerCase(),
    city: city,
};

// Process MDX with dynamic variables
let historyHtml = '';
try {
    const HistoryContentModule = HistoryContent as any;
    let content = HistoryContentModule.default?.content || '';
    Object.entries(historyVars).forEach(([key, value]) => {
        content = content.replace(new RegExp(`\\{${key}\\}`, 'g'), String(value));
    });
    historyHtml = content;
} catch {
    historyHtml = defaults.history.title;
}

// 3. Defaults & Fallbacks (Placeholders genéricos)
const defaults = {
    hero: {
        eyebrow: "Sobre Nosotros",
        title: `Sobre Nosotros | ${siteName}`,
        description: `Profesionales especializados en ${niche.toLowerCase()} en ${city}. Calidad garantizada y atención personalizada.`,
        image: "/images/about-hero.webp",
    },
    mainImage: {
        image: "/images/about-main.webp",
        experienceBadge: undefined as string | undefined,
        mainImageAlt: undefined as string | undefined,
    },
    history: {
        subtitle: "Nuestra Historia",
        title: `Profesionales en ${niche.toLowerCase()} con experiencia`,
        stats: [],
    },
    values: {
        title: "Nuestros Valores",
        description: "Los principios que guían nuestro trabajo diario para ofrecer el mejor servicio.",
        items: [
            { icon: "Shield", title: "Confianza", description: "Transparencia total en cada presupuesto y proyecto." },
            { icon: "Award", title: "Calidad", description: "Solo utilizamos materiales certificados de alta gama." },
            { icon: "Clock", title: "Puntualidad", description: "Respetamos los plazos acordados con el cliente." },
            { icon: "Heart", title: "Pasión", description: "Cuidamos cada detalle como si fuera para nuestra propia casa." },
        ],
    },
    whyChooseUs: {
        title: "¿Por Qué Elegirnos?",
        items: [
            { title: "Profesionales Cualificados", description: `Equipo con amplia experiencia en ${niche.toLowerCase()} en ${city}.` },
            { title: "Sin Intermediarios", description: "Trato directo con los técnicos encargados de la ejecución." },
            { title: "Presupuesto Cerrado", description: "Sin sorpresas ni costes ocultos al finalizar el trabajo." },
        ],
    },
    team: {
        title: "Nuestro Equipo",
        description: `Contamos con técnicos cualificados con amplia experiencia en el sector de ${niche.toLowerCase()}.`,
        members: [] as { name: string; role: string; image?: string; imageAlt?: string }[],
    },
    cta: {
        title: "¿Tienes un proyecto en mente?",
        text: "Pide presupuesto sin compromiso y te asesoraremos sobre la mejor solución.",
        primaryText: "Pedir Presupuesto",
        primaryLink: "/contacto/",
        secondaryText: "WhatsApp",
        secondaryLink: `https://wa.me/${whatsapp.replace(/\s/g, "")}`,
    },
    seo: {
        title: `Sobre Nosotros | ${siteName} — ${niche} en ${city}`,
        description: `Conoce a ${siteName}, tu empresa de confianza de ${niche.toLowerCase()} en ${city}.`,
    },
};

// 4. Merge Data with Fallbacks
const hero = { ...defaults.hero, ...aboutData?.hero };
const mainImage = { ...defaults.mainImage, ...aboutData?.mainImage };
const history = { ...defaults.history, ...aboutData?.history };
const values = { ...defaults.values, ...aboutData?.values };
const whyChooseUs = { ...defaults.whyChooseUs, ...aboutData?.whyChooseUs };
const team = { ...defaults.team, ...aboutData?.team };
const cta = { ...defaults.cta, ...aboutData?.cta };
const seo = { ...defaults.seo, ...aboutData?.seo };

// 5. Icons Mapping
const iconMap: Record<string, any> = {
    Shield, Heart, Clock, Target, Users, Wrench, Award, CheckCircle, Calculator, Star
};

import { buildGenericGraph } from "@/lib/seo";
const siteUrl = settings.siteUrl || Astro.site?.href || '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = buildGenericGraph({
    settings,
    siteUrl,
    pageUrl,
    title: seo.title,
    description: seo.description,
    breadcrumbs: [
        { name: "Inicio", item: `${siteUrl.replace(/\/$/, '')}/` },
        { name: "Sobre Nosotros", item: pageUrl },
    ],
});
---

<Layout
    title={seo.title}
    description={seo.description}
    schema={schema}
>
    <div class="pt-24 md:pt-32 pb-12">
    <!-- HERO SECTION -->
    <section class="relative py-20 bg-secondary overflow-hidden">
        <div
            class="absolute inset-0 bg-cover bg-center opacity-20"
            style={`background-image: url('${hero.image}')`}
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-b from-secondary via-secondary/90 to-secondary"
        >
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl mx-auto text-center">
                {hero.eyebrow && (
                    <span class="inline-block text-primary font-bold uppercase tracking-[0.3em] text-sm mb-4">
                        {hero.eyebrow}
                    </span>
                )}
                <h1
                    class="text-5xl lg:text-7xl font-heading font-black text-heading mb-6 tracking-tight"
                >
                    {hero.title}
                </h1>
                <p class="text-xl text-body leading-relaxed max-w-2xl mx-auto">
                    {hero.description}
                </p>
            </div>
        </div>
    </section>

    <Breadcrumbs pageName="Nosotros" noSchema={true} />

    <!-- HISTORY & STATS SECTION -->
    <section class="py-20 bg-surface/30 relative overflow-hidden">
        <div class="container mx-auto px-4">
            <div
                class="grid lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto"
            >
                <!-- Image Column -->
                <div class="relative">
                    <div
                        class="aspect-[4/3] rounded-2xl overflow-hidden border border-heading/10 shadow-2xl"
                    >
                        <img
                            src={mainImage.image}
                            alt={mainImage.mainImageAlt || `Sobre nosotros - ${siteName}`}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    {
                        mainImage.experienceBadge && (
                            <div class="absolute -bottom-6 -right-6 bg-primary text-white p-6 rounded-xl shadow-2xl">
                                <div class="text-center">
                                    <div class="text-xl font-heading font-bold uppercase tracking-wider">
                                        {mainImage.experienceBadge}
                                    </div>
                                </div>
                            </div>
                        )
                    }
                </div>

                <!-- Text Column -->
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <div class="h-1 w-12 bg-primary"></div>
                        <span
                            class="text-primary font-bold uppercase tracking-wider text-sm"
                        >
                            {history.subtitle}
                        </span>
                    </div>
                    <h2
                        class="text-4xl font-heading font-bold text-heading mb-6 tracking-tight"
                    >
                        {history.title}
                    </h2>

                    <div
                        class="prose prose-lg prose-headings:text-heading prose-p:text-body prose-strong:text-primary max-w-none mb-10"
                    >
                        <Fragment set:html={historyHtml} />
                    </div>

                    {
                        history.stats && history.stats.length > 0 && (
                            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-6 pt-6 border-t border-heading/5">
                                {history.stats.map((stat) => (
                                    <div>
                                        <div class="text-3xl font-bold text-primary mb-1">
                                            {stat.value}
                                        </div>
                                        <div class="text-xs text-body/70 uppercase font-bold tracking-widest">
                                            {stat.label}
                                        </div>
                                        {stat.description && (
                                            <p class="text-[10px] text-body/50 mt-1 leading-tight">
                                                {stat.description}
                                            </p>
                                        )}
                                    </div>
                                ))}
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- VALUES SECTION -->
    <section class="py-24 bg-secondary">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl lg:text-5xl font-heading font-bold text-heading mb-6 tracking-tight">
                    {values.title}
                </h2>
                <div class="w-24 h-1 bg-primary mx-auto mb-6"></div>
                <p class="text-body text-lg max-w-2xl mx-auto">
                    {values.description}
                </p>
            </div>

            <div
                class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto"
            >
                {
                    (values.items || []).map((item) => {
                        const Icon = iconMap[item.icon] || Shield;
                        return (
                            <div class="p-8 bg-surface/40 border border-heading/10 rounded-2xl hover:border-primary/50 transition-all group hover:shadow-xl hover:shadow-primary/5">
                                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-primary/20 transition-all">
                                    <Icon className="w-8 h-8 text-primary" />
                                </div>
                                <h3 class="text-2xl font-bold text-heading mb-4">
                                    {item.title}
                                </h3>
                                <p class="text-body leading-relaxed">
                                    {item.description}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="py-24 bg-surface/30 relative overflow-hidden">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <div class="text-center mb-16">
                    <h2
                        class="text-4xl lg:text-5xl font-heading font-bold text-heading mb-6 tracking-tight"
                    >
                        {whyChooseUs.title}
                    </h2>
                    <div class="w-24 h-1 bg-primary mx-auto"></div>
                </div>

                <div class="grid gap-6">
                    {
                        (whyChooseUs.items || []).map(
                            (item) => (
                                <div class="flex items-start gap-6 p-8 bg-surface border border-heading/10 shadow-sm rounded-2xl hover:border-primary/50 transition-all group">
                                    <div class="shrink-0">
                                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
                                            <CheckCircle className="w-6 h-6 text-primary group-hover:text-white" />
                                        </div>
                                    </div>
                                    <div>
                                        <h3 class="text-2xl font-bold text-heading mb-2">
                                            {item.title}
                                        </h3>
                                        <p class="text-body text-lg leading-relaxed">
                                            {item.description}
                                        </p>
                                    </div>
                                </div>
                            ),
                        )
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- TEAM SECTION -->
    <section class="py-24 bg-secondary border-t border-heading/5">
        <div class="container mx-auto px-4">
            <div class="max-w-5xl mx-auto">
                <div class="text-center mb-16">
                    <div
                        class="inline-flex items-center justify-center w-24 h-24 bg-primary/10 rounded-full mb-8"
                    >
                        <Users className="w-12 h-12 text-primary" />
                    </div>
                    <h2 class="text-4xl lg:text-5xl font-heading font-bold text-heading mb-6 tracking-tight">
                        {team.title}
                    </h2>
                    <p class="text-body text-xl leading-relaxed max-w-3xl mx-auto">
                        {team.description}
                    </p>
                </div>

                {team.members && team.members.length > 0 && (
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
                        {team.members.map((member) => (
                            <div class="group text-center">
                                <div class="aspect-square rounded-2xl overflow-hidden mb-6 border border-heading/10 shadow-lg">
                                    <img 
                                        src={member.image || "https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400&h=400&auto=format&fit=crop"} 
                                        alt={member.imageAlt || member.name}
                                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
                                    />
                                </div>
                                <h3 class="text-2xl font-bold text-heading mb-1">{member.name}</h3>
                                <p class="text-primary font-bold uppercase tracking-widest text-sm">{member.role}</p>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </section>

    </div>
    <FinalCTA 
        title={cta.title}
        subtitle={cta.text}
        buttonText={cta.primaryText}
        buttonLink={cta.primaryLink}
    />
    <Footer />
</Layout>
