---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { getEntry } from "astro:content";
import {
    Award,
    Users,
    Shield,
    Wrench,
    CheckCircle,
    Clock,
    Target,
    Heart,
} from "lucide-react";
import type { WithContext, AboutPage } from "schema-dts";

// Fetch Global Settings
const settings = await getEntry("settings", "global");
const { siteName, city, niche } = settings?.data || {
    siteName: "Nombre Negocio",
    city: "Ciudad",
    niche: "Servicio Profesional",
};

const schema: WithContext<AboutPage> = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: `Sobre Nosotros - ${siteName}`,
    description: `Conoce la historia y valores de ${siteName}. Más de 15 años ofreciendo servicios de ${niche} profesional en ${city}.`,
};
---

<Layout
    title={`Sobre Nosotros | ${siteName}`}
    description={`${niche} profesionales en ${city} desde 2010. Conoce nuestra historia, valores y compromiso con la calidad.`}
    schema={schema}
>
    <section class="relative py-20 bg-secondary overflow-hidden">
        <div
            class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-20"
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-b from-secondary via-secondary/90 to-secondary"
        >
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl mx-auto text-center">
                <h1
                    class="text-5xl lg:text-6xl font-heading font-bold text-white mb-6"
                >
                    Sobre <span class="text-primary">Nosotros</span>
                </h1>
                <p class="text-xl text-slate-300 leading-relaxed">
                    {niche} profesionales en {city} comprometidos con la calidad,
                    la seguridad y la satisfacción del cliente.
                </p>
            </div>
        </div>
    </section>

    <section class="py-20 bg-body">
        <div class="container mx-auto px-4">
            <div
                class="grid lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto"
            >
                <div class="relative">
                    <div
                        class="aspect-[4/3] rounded-2xl overflow-hidden border border-slate-700 shadow-2xl"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=2070&auto=format&fit=crop"
                            alt={`Taller de ${niche} ${city}`}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <div
                        class="absolute -bottom-6 -right-6 bg-primary text-white p-6 rounded-xl shadow-2xl"
                    >
                        <div class="text-center">
                            <div class="text-4xl font-heading font-bold">
                                +15
                            </div>
                            <div class="text-sm uppercase tracking-wider">
                                Años
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <div class="h-1 w-12 bg-primary"></div>
                        <span
                            class="text-primary font-bold uppercase tracking-wider text-sm"
                            >Nuestra Historia</span
                        >
                    </div>
                    <h2
                        class="text-4xl font-heading font-bold text-heading mb-6"
                    >
                        {niche} Profesional desde 2010
                    </h2>

                    <p class="text-slate-600 mb-6 leading-relaxed text-lg">
                        Desde nuestros inicios, nos hemos dedicado a ofrecer
                        servicios de {niche.toLowerCase()} de la más alta calidad
                        en {city} y provincia. Lo que comenzó como un pequeño taller
                        familiar ha crecido hasta convertirse en una referencia en
                        el sector.
                    </p>

                    <p class="text-slate-600 mb-8 leading-relaxed">
                        Nuestro compromiso es simple pero firme: <strong
                            class="text-heading"
                            >ofrecer trabajos que combinen seguridad,
                            durabilidad y diseño</strong
                        >. Cada proyecto, grande o pequeño, recibe la misma
                        atención al detalle y profesionalidad.
                    </p>

                    <div class="grid grid-cols-3 gap-6">
                        <div class="text-center">
                            <div class="text-3xl font-bold text-primary mb-1">
                                500+
                            </div>
                            <div class="text-xs text-slate-500 uppercase">
                                Proyectos
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="text-3xl font-bold text-primary mb-1">
                                100%
                            </div>
                            <div class="text-xs text-slate-500 uppercase">
                                Satisfacción
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="text-3xl font-bold text-primary mb-1">
                                15+
                            </div>
                            <div class="text-xs text-slate-500 uppercase">
                                Años
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-20 bg-secondary">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-heading font-bold text-white mb-4">
                    Nuestros Valores
                </h2>
                <div class="w-24 h-1 bg-primary mx-auto mb-4"></div>
                <p class="text-slate-400 max-w-2xl mx-auto">
                    Los principios que guían nuestro trabajo cada día
                </p>
            </div>

            <div
                class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto"
            >
                {/* Array de valores para iterar y no repetir código */}
                {
                    [
                        {
                            icon: Shield,
                            title: "Calidad",
                            desc: "Materiales certificados y técnicas profesionales.",
                        },
                        {
                            icon: Heart,
                            title: "Compromiso",
                            desc: "Superamos las expectativas en cada proyecto.",
                        },
                        {
                            icon: Clock,
                            title: "Puntualidad",
                            desc: "Respetamos los plazos y urgencias.",
                        },
                        {
                            icon: Target,
                            title: "Transparencia",
                            desc: "Presupuestos claros sin sorpresas.",
                        },
                    ].map((item) => (
                        <div class="p-6 bg-slate-900/50 border border-white/10 rounded-xl hover:border-primary/50 transition-all group">
                            <div class="w-14 h-14 bg-primary/20 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                                <item.icon className="w-7 h-7 text-primary" />
                            </div>
                            <h3 class="text-xl font-bold text-white mb-3">
                                {item.title}
                            </h3>
                            <p class="text-slate-400 text-sm leading-relaxed">
                                {item.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-20 bg-body">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <div class="text-center mb-16">
                    <h2
                        class="text-4xl font-heading font-bold text-heading mb-4"
                    >
                        ¿Por Qué Elegirnos?
                    </h2>
                    <div class="w-24 h-1 bg-primary mx-auto"></div>
                </div>

                <div class="space-y-6">
                    {
                        [
                            {
                                title: `Taller Propio en ${city}`,
                                desc: "Fabricamos sin intermediarios para controlar la calidad.",
                            },
                            {
                                title: "Experiencia Demostrable",
                                desc: "Años perfeccionando nuestras técnicas y conociendo el sector.",
                            },
                            {
                                title: "Garantía por Escrito",
                                desc: "Todos nuestros trabajos incluyen garantía y factura reglamentaria.",
                            },
                            {
                                title: "Atención Personalizada",
                                desc: "Nos tomamos el tiempo necesario para entender tus necesidades.",
                            },
                        ].map((item) => (
                            <div class="flex items-start gap-4 p-6 bg-white border border-slate-200 shadow-sm rounded-lg hover:border-primary/50 transition-colors">
                                <div class="shrink-0">
                                    <CheckCircle className="w-6 h-6 text-primary mt-1" />
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-heading mb-2">
                                        {item.title}
                                    </h3>
                                    <p class="text-slate-600 leading-relaxed">
                                        {item.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="py-20 bg-secondary border-t border-white/5">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <div
                    class="inline-flex items-center justify-center w-20 h-20 bg-primary/20 rounded-full mb-8"
                >
                    <Users className="w-10 h-10 text-primary" />
                </div>
                <h2 class="text-4xl font-heading font-bold text-white mb-6">
                    Equipo Profesional
                </h2>
                <p class="text-slate-300 text-lg leading-relaxed mb-8">
                    Nuestro equipo está formado por técnicos certificados y con
                    años de experiencia en el sector del {niche.toLowerCase()}.
                    Nos mantenemos actualizados con las últimas técnicas y
                    normativas para ofrecer siempre el mejor servicio en {city}.
                </p>
            </div>
        </div>
    </section>

    <FinalCTA />
    <Footer />
</Layout>
