---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getEntry } from "astro:content";
import {
    Award,
    Users,
    Shield,
    Wrench,
    CheckCircle,
    Clock,
    Target,
    Heart,
} from "lucide-react";

// Fetch Global Settings
import { getSettings } from "@/lib/settings";
const settings = await getSettings();
const { siteName, city, niche } = settings;

// Fetch About Content
const aboutEntry = await getEntry("about", "index");
const aboutData = aboutEntry?.data;

// Default Values (Fallback)
const defaults = {
    hero: {
        title: "METALISUR — Carpintería de Aluminio en Málaga",
        description: `Fabricamos e instalamos ventanas, puertas, persianas, mosquiteras, mamparas y cerramientos de aluminio en ${city}. Más de 15 años con taller propio, sin intermediarios y con garantía en cada instalación.`,
        image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2070&auto=format&fit=crop",
    },
    mainImage: {
        image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2070&auto=format&fit=crop",
        experienceBadge: "+15 Años",
    },
    history: {
        subtitle: "Quiénes Somos",
        title: `De taller local a referencia en carpintería de aluminio en ${city}`,
        content: `METALISUR nació como un taller de carpintería de aluminio en Málaga con un planteamiento muy claro: fabricar e instalar con el mismo equipo, sin subcontratar, con control total del resultado de principio a fin.\n\nCon los años hemos ampliado la gama de servicios — ventanas, puertas, persianas, mosquiteras, mamparas y cerramientos — pero sin perder ese enfoque: cada trabajo lo hacemos nosotros, medimos nosotros e instalamos nosotros. Eso nos permite garantizar el resultado de una forma que un intermediario no puede.\n\nConocemos bien la particularidad del parque inmobiliario malagueño: los edificios de los años 70 del centro con huecos fuera de estándar, las viviendas de la costa donde el salitre deteriora los acabados de baja calidad, y las promociones nuevas donde el detalle del acabado marca la diferencia. Ese conocimiento local se traduce en asesoramiento real, no en catálogos.`,
        stats: [
            { value: "2.000+", label: "Instalaciones" },
            { value: "15+", label: "Años de Experiencia" },
            { value: "100%", label: "Fabricación Propia" },
            { value: "6", label: "Servicios Especializados" },
        ],
    },
    values: {
        title: "Nuestros Compromisos",
        description: "Los principios que no negociamos en ningún trabajo, sea grande o pequeño.",
        items: [
            {
                icon: "Wrench",
                title: "Fabricación a Medida",
                description: "Fabricamos en nuestro taller con las medidas exactas de cada hueco. Sin estándares que no encajan, sin holguras, sin remates que quedan mal.",
            },
            {
                icon: "Award",
                title: "Materiales con Garantía",
                description: "Solo trabajamos con perfiles de aluminio y herrajes de primera calidad, con marcado CE y garantía del fabricante. Lo que instalamos dura.",
            },
            {
                icon: "Users",
                title: "Instalación Propia",
                description: "Instalamos nosotros, sin subcontratar. El resultado de una carpintería depende tanto del producto como del montaje — por eso controlamos los dos.",
            },
            {
                icon: "Calculator",
                title: "Precio Cerrado",
                description: "Presupuesto con medidas reales antes de empezar. El precio que aceptas es el precio final. Sin letra pequeña, sin sorpresas al terminar.",
            },
        ],
    },
    whyChooseUs: {
        title: "¿Por Qué Elegir METALISUR?",
        items: [
            {
                title: `Taller propio en ${city}`,
                description: `Fabricamos directamente en nuestro taller de ${city}. Sin intermediarios, con control total de materiales, tiempos y calidad de ejecución.`,
            },
            {
                title: "Especialistas, no generalistas",
                description: "No hacemos de todo. Nos especializamos en carpintería de aluminio y llevamos más de 15 años perfeccionando la instalación de ventanas, puertas, persianas, mosquiteras, mamparas y cerramientos.",
            },
            {
                title: "Coordinación en una sola visita",
                description: "Si cambias ventanas, persianas y mosquiteras a la vez, lo coordinamos todo en una sola intervención. Menos molestias, resultado más integrado.",
            },
            {
                title: `Sabemos lo que aguanta en ${city}`,
                description: "Conocemos qué perfiles, lacados y herrajes resisten mejor el ambiente marino de la costa malagueña y las temperaturas extremas del interior. Te asesoramos en función de dónde está tu vivienda.",
            },
            {
                title: "Garantía por escrito en todos los trabajos",
                description: "Cada instalación incluye garantía documentada. Si algo no funciona como debe, volvemos a resolverlo sin coste adicional.",
            },
            {
                title: "Presupuesto con medidas reales",
                description: "No damos precios de catálogo. Visitamos, medimos y presupuestamos en función de tus huecos y necesidades reales. Sin sorpresas al terminar.",
            },
        ],
    },
    team: {
        title: "El Equipo METALISUR",
        description: `El equipo de METALISUR está formado por instaladores especializados en carpintería de aluminio con años de experiencia en ${city} y provincia. Cada persona que entra en tu vivienda sabe lo que hace: mide con precisión, instala sin atajos y te explica cómo funciona lo que ha instalado. Sin comerciales que prometen y técnicos que improvisan — el mismo equipo que presupuesta es el que instala.`,
    },
    seo: {
        title: `Quiénes Somos | ${siteName} — Carpintería de Aluminio en ${city}`,
        description: `Conoce a METALISUR, especialistas en carpintería de aluminio en ${city}. Fabricación propia, instalación profesional y más de 15 años de experiencia en ventanas, puertas, persianas y cerramientos.`,
    },
};

// Merge data
const hero = aboutData?.hero || defaults.hero;
const mainImage = aboutData?.mainImage || defaults.mainImage;
const history = aboutData?.history || defaults.history;
const values = aboutData?.values || defaults.values;
const whyChooseUs = aboutData?.whyChooseUs || defaults.whyChooseUs;
const team = aboutData?.team || defaults.team;
const seo = aboutData?.seo || defaults.seo;

// Icon Map
const iconMap: Record<string, any> = {
    Shield,
    Heart,
    Clock,
    Target,
    Users,
    Wrench,
    Award,
    CheckCircle,
};

import { buildGenericGraph } from "@/lib/seo";

const siteUrl = settings.siteUrl || Astro.site?.href || '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = buildGenericGraph({
    settings,
    siteUrl,
    pageUrl,
    title: seo.title || defaults.seo.title,
    description: seo.description || defaults.seo.description,
    breadcrumbs: [
        { name: "Inicio", item: `${siteUrl.replace(/\/$/, '')}/` },
        { name: "Sobre Nosotros", item: pageUrl },
    ],
});
---

<Layout
    title={seo.title || defaults.seo.title}
    description={seo.description || defaults.seo.description}
    schema={schema}
>
    <div class="pt-24 md:pt-32 pb-12">
    <!-- HERO SECTION -->
    <section class="relative py-20 bg-secondary overflow-hidden">
        <div
            class="absolute inset-0 bg-cover bg-center opacity-20"
            style={`background-image: url('${hero.image || defaults.hero.image}')`}
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-b from-secondary via-secondary/90 to-secondary"
        >
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl mx-auto text-center">
                <h1
                    class="text-5xl lg:text-6xl font-heading font-bold text-heading mb-6"
                >
                    {hero.title || defaults.hero.title}
                </h1>
                <p class="text-xl text-body leading-relaxed">
                    {hero.description || defaults.hero.description}
                </p>
            </div>
        </div>
    </section>

    <Breadcrumbs pageName="Nosotros" />

    <!-- HISTORY & STATS SECTION -->
    <section class="py-20 bg-surface/30">
        <div class="container mx-auto px-4">
            <div
                class="grid lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto"
            >
                <!-- Image Column -->
                <div class="relative">
                    <div
                        class="aspect-[4/3] rounded-2xl overflow-hidden border border-heading/10 shadow-2xl"
                    >
                        <img
                            src={mainImage.image || defaults.mainImage.image}
                            alt={`Sobre nosotros - ${siteName}`}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    {
                        mainImage.experienceBadge && (
                            <div class="absolute -bottom-6 -right-6 bg-primary text-white p-6 rounded-xl shadow-2xl">
                                <div class="text-center">
                                    <div class="text-xl font-heading font-bold uppercase tracking-wider">
                                        {mainImage.experienceBadge}
                                    </div>
                                </div>
                            </div>
                        )
                    }
                </div>

                <!-- Text Column -->
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <div class="h-1 w-12 bg-primary"></div>
                        <span
                            class="text-primary font-bold uppercase tracking-wider text-sm"
                        >
                            {history.subtitle || defaults.history.subtitle}
                        </span>
                    </div>
                    <h2
                        class="text-4xl font-heading font-bold text-heading mb-6"
                    >
                        {history.title || defaults.history.title}
                    </h2>

                    <div
                        class="text-body mb-8 leading-relaxed text-lg whitespace-pre-line"
                    >
                        {history.content || defaults.history.content}
                    </div>

                    {
                        history.stats && (
                            <div class="grid grid-cols-3 gap-6">
                                {history.stats.map((stat) => (
                                    <div class="text-center">
                                        <div class="text-3xl font-bold text-primary mb-1">
                                            {stat.value}
                                        </div>
                                        <div class="text-xs text-body/70 uppercase">
                                            {stat.label}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- VALUES SECTION -->
    <section class="py-20 bg-secondary">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-heading font-bold text-heading mb-4">
                    {values.title || defaults.values.title}
                </h2>
                <div class="w-24 h-1 bg-primary mx-auto mb-4"></div>
                <p class="text-body max-w-2xl mx-auto">
                    {values.description || defaults.values.description}
                </p>
            </div>

            <div
                class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto"
            >
                {
                    (values.items || defaults.values.items).map((item) => {
                        const Icon = iconMap[item.icon] || Shield;
                        return (
                            <div class="p-6 bg-surface/50 border border-heading/10 rounded-xl hover:border-primary/50 transition-all group">
                                <div class="w-14 h-14 bg-primary/20 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                                    <Icon className="w-7 h-7 text-primary" />
                                </div>
                                <h3 class="text-xl font-bold text-heading mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-body text-sm leading-relaxed">
                                    {item.description}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="py-20 bg-surface/30">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <div class="text-center mb-16">
                    <h2
                        class="text-4xl font-heading font-bold text-heading mb-4"
                    >
                        {whyChooseUs.title || defaults.whyChooseUs.title}
                    </h2>
                    <div class="w-24 h-1 bg-primary mx-auto"></div>
                </div>

                <div class="space-y-6">
                    {
                        (whyChooseUs.items || defaults.whyChooseUs.items).map(
                            (item) => (
                                <div class="flex items-start gap-4 p-6 bg-surface border border-heading/10 shadow-sm rounded-lg hover:border-primary/50 transition-colors">
                                    <div class="shrink-0">
                                        <CheckCircle className="w-6 h-6 text-primary mt-1" />
                                    </div>
                                    <div>
                                        <h3 class="text-xl font-bold text-heading mb-2">
                                            {item.title}
                                        </h3>
                                        <p class="text-body leading-relaxed">
                                            {item.description}
                                        </p>
                                    </div>
                                </div>
                            ),
                        )
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- TEAM SECTION -->
    <section class="py-20 bg-secondary border-t border-heading/5">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <div
                    class="inline-flex items-center justify-center w-20 h-20 bg-primary/20 rounded-full mb-8"
                >
                    <Users className="w-10 h-10 text-primary" />
                </div>
                <h2 class="text-4xl font-heading font-bold text-heading mb-6">
                    {team.title || defaults.team.title}
                </h2>
                <p class="text-body text-lg leading-relaxed mb-8">
                    {team.description || defaults.team.description}
                </p>
            </div>
        </div>
    </section>

    </div>
    <FinalCTA />
    <Footer />
</Layout>
