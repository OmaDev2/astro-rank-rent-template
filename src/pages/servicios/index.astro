---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/layout/Footer.astro";
import BlockRenderer from "../../components/BlockRenderer.astro";
import FinalCTA from "../../components/sections/FinalCTA.astro";
import WhatsAppButton from "../../components/ui/WhatsAppButton.astro";
import { getCollection, getEntry } from "astro:content";
import { ArrowRight } from "lucide-react";
import { getSettings } from "@/lib/settings";
import { buildBlogListGraph } from "@/lib/seo";

const settings = await getSettings();
const { siteName, city, niche, phone, whatsapp } = settings;

const services = (await getCollection("services")).sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "es")
);

// CMS
const serviciosPage = await getEntry("pages", "servicios");
const pageData = (serviciosPage?.data ?? {}) as any;

const parsePreview = (json: string | undefined) => {
    try { return json ? JSON.parse(json) : null; } catch { return null; }
};

const seoData = parsePreview(pageData.seoControls as string | undefined);
const seoTitle = seoData?.title || `Servicios de ${niche} en ${city} | ${siteName}`;
const seoDescription = seoData?.description ||
    `Todos nuestros servicios de ${niche.toLowerCase()} en ${city}. Fabricación e instalación a medida. Presupuesto sin compromiso.`;

const finalBlocks = (pageData.blocks && (pageData.blocks as any[]).length > 0)
    ? pageData.blocks as any[]
    : [{ discriminant: "hero" }];

const siteUrl = settings.siteUrl || Astro.site?.href || '';
const pageUrl  = new URL(Astro.url.pathname, Astro.site).href;

const schema = buildBlogListGraph({
    settings,
    siteUrl,
    pageUrl,
    title: seoTitle,
    description: seoDescription,
    posts: services.map(s => ({
        url: `${siteUrl.replace(/\/$/, '')}/servicios/${s.slug}/`,
        title: s.data.title,
        image: s.data.heroImage,
    })),
});
---

<Layout title={seoTitle} description={seoDescription} schema={schema}>

    <BlockRenderer
        blocks={finalBlocks}
        config={settings}
        city={city}
        locationName={city}
        siteName={siteName}
        niche={niche}
        phone={phone}
        whatsapp={whatsapp}
    />

    <!-- Listado automático de servicios -->
    <section class="py-20 bg-surface">
        <div class="container mx-auto px-4">
            {services.length > 0 ? (
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {services.map((service) => (
                        <a
                            href={`/servicios/${service.slug}/`}
                            class="group flex flex-col gap-4 p-7 rounded-2xl bg-secondary border border-heading/5 hover:border-primary/30 hover:shadow-lg transition-all"
                        >
                            {service.data.heroImage && (
                                <div class="aspect-video rounded-xl overflow-hidden">
                                    <img
                                        src={service.data.heroImage}
                                        alt={service.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                            )}
                            <div class="flex items-start justify-between gap-3">
                                <h2 class="text-xl font-heading font-bold text-heading group-hover:text-primary transition-colors leading-snug">
                                    {service.data.title}
                                </h2>
                                <ArrowRight className="w-5 h-5 text-primary shrink-0 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all mt-0.5" />
                            </div>
                            {service.data.shortDesc && (
                                <p class="text-sm text-body leading-relaxed line-clamp-3">
                                    {service.data.shortDesc}
                                </p>
                            )}
                            <span class="mt-auto inline-flex items-center gap-1 text-xs font-bold text-primary">
                                Ver {service.data.title}
                                <ArrowRight className="w-3 h-3" />
                            </span>
                        </a>
                    ))}
                </div>
            ) : (
                <div class="text-center py-20">
                    <p class="text-body text-xl">Próximamente nuestros servicios.</p>
                </div>
            )}
        </div>
    </section>

    <FinalCTA />
    <WhatsAppButton />
    <Footer />
</Layout>
