---
import Layout from "../layouts/Layout.astro";
import { CheckCircle, ArrowRight } from "lucide-react";
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
const { siteName } = settings;
---

<Layout title={`¡Mensaje Enviado! | ${siteName}`} noindex={true}>
    <section
        class="min-h-[80vh] flex items-center justify-center bg-secondary px-4"
    >
        <div class="max-w-md w-full text-center">
            <div
                class="inline-flex items-center justify-center w-20 h-20 bg-green-500/20 rounded-full mb-8"
            >
                <CheckCircle className="w-10 h-10 text-green-500" />
            </div>

            <h1 class="text-4xl font-heading font-bold text-heading mb-4">
                ¡Mensaje Recibido!
            </h1>

            <p class="text-body text-lg mb-8 leading-relaxed">
                Gracias por contactar con nosotros. Hemos recibido tu solicitud
                correctamente. Nos pondremos en contacto contigo en menos de 24 horas.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href="/"
                    class="inline-flex items-center justify-center px-6 py-3 bg-surface hover:bg-surface/80 text-heading font-bold rounded-xl transition-colors border border-heading/10 hover:border-primary/30"
                >
                    Volver al Inicio
                </a>

                <a
                    href="/servicios/"
                    class="inline-flex items-center justify-center px-6 py-3 bg-primary hover:bg-accent text-white font-bold rounded-xl transition-colors shadow-lg hover:shadow-primary/20"
                >
                    Ver Servicios
                    <ArrowRight className="w-4 h-4 ml-2" />
                </a>
            </div>
        </div>
    </section>
</Layout>
