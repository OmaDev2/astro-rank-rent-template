---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/layout/Footer.astro";
import FinalCTA from "../../components/sections/FinalCTA.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { MapPin, Calendar, Wrench, ArrowLeft } from "lucide-react";
import { getSettings } from "@/lib/settings";

// Importar componentes MDX
import CtaBlock from "../../components/mdx/CtaBlock.astro";
import AlertBlock from "../../components/mdx/AlertBlock.astro";
import PhoneBlock from "../../components/mdx/PhoneBlock.astro";
import BusinessNameBlock from "../../components/mdx/BusinessNameBlock.astro";
import CustomImageBlock from "../../components/mdx/CustomImageBlock.astro";
import ContentImage from "../../components/mdx/ContentImage.astro";

const mdxComponents = {
    CtaBlock,
    AlertBlock,
    PhoneBlock,
    BusinessNameBlock,
    CustomImageBlock,
    ContentImage,
};

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const settings = await getSettings();

let parsedSeo = { title: "", description: "" };
try { parsedSeo = project.data.seo ? JSON.parse(project.data.seo) : {}; } catch(e) {}

const title = parsedSeo.title || project.data.title;
const description =
    parsedSeo.description ||
    `Proyecto de ${project.data.serviceType || settings.niche} en ${project.data.locationTag || settings.city}. Descubre el trabajo realizado por ${settings.siteName}.`;

import { buildGenericGraph } from "@/lib/seo";

const siteUrl = (settings.siteUrl || Astro.site?.href || '').replace(/\/$/, '');
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const creativeWork = {
    "@type": "CreativeWork",
    "@id": `${siteUrl}/proyectos/${project.slug}/#project`,
    name: project.data.title,
    description,
    ...(project.data.image && { image: `${siteUrl}${project.data.image}` }),
    ...(project.data.date && { dateCreated: project.data.date }),
    locationCreated: {
        "@type": "Place",
        name: project.data.locationTag || settings.city,
        address: {
            "@type": "PostalAddress",
            addressLocality: project.data.locationTag || settings.city,
            addressCountry: "ES",
        },
    },
    creator: { "@id": `${siteUrl}/#business` },
};

const baseGraph = buildGenericGraph({
    settings,
    siteUrl,
    pageUrl,
    title,
    description,
    breadcrumbs: [
        { name: "Inicio", item: `${siteUrl}/` },
        { name: "Proyectos", item: `${siteUrl}/proyectos/` },
        { name: project.data.title, item: pageUrl },
    ],
});

const projectSchema = {
    ...baseGraph,
    "@graph": [...(baseGraph["@graph"] as any[]), creativeWork],
};

// Formatear fecha
const formattedDate = project.data.date
    ? new Date(project.data.date).toLocaleDateString("es-ES", {
          year: "numeric",
          month: "long",
      })
    : null;
---

<Layout title={`${title} | ${settings.siteName}`} description={description} schema={projectSchema}>
    <!-- Hero -->
    <section class="bg-secondary border-b border-heading/5 pb-0">
        <div class="container mx-auto px-4 pt-8 pb-0">
            <!-- Back link -->
            <a
                href="/proyectos/"
                class="inline-flex items-center gap-2 text-sm text-body/60 hover:text-primary transition-colors mb-6"
            >
                <ArrowLeft className="w-4 h-4" />
                Volver a Proyectos
            </a>

            <div class="grid lg:grid-cols-2 gap-12 items-start">
                <!-- Info -->
                <div class="pb-12">
                    <!-- Tags -->
                    <div class="flex flex-wrap gap-2 mb-4">
                        {project.data.locationTag && (
                            <span class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 border border-primary/20 px-3 py-1 rounded-full">
                                <MapPin className="w-3 h-3" />
                                {project.data.locationTag}
                            </span>
                        )}
                        {project.data.serviceType && (
                            <span class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-body/70 bg-surface px-3 py-1 rounded-full border border-heading/10">
                                <Wrench className="w-3 h-3" />
                                {project.data.serviceType}
                            </span>
                        )}
                        {formattedDate && (
                            <span class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-body/70 bg-surface px-3 py-1 rounded-full border border-heading/10">
                                <Calendar className="w-3 h-3" />
                                {formattedDate}
                            </span>
                        )}
                    </div>

                    <h1 class="text-4xl md:text-5xl font-heading font-bold text-heading mb-6 leading-tight">
                        {project.data.title}
                    </h1>

                    <p class="text-body/70 text-lg leading-relaxed mb-8">
                        {description}
                    </p>

                    <a
                        href={`tel:${settings.phone.replace(/\s/g, "")}`}
                        class="inline-flex items-center gap-2 bg-primary text-white font-bold px-8 py-4 rounded-xl hover:opacity-90 transition-opacity shadow-lg"
                    >
                        Solicitar presupuesto similar
                    </a>
                </div>

                <!-- Image -->
                {project.data.image && (
                    <div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[4/3] bg-surface">
                        <img
                            src={project.data.image}
                            alt={project.data.imageAlt || project.data.title}
                            width={1200}
                            height={900}
                            class="w-full h-full object-cover"
                            loading="eager"
                        />
                    </div>
                )}
            </div>
        </div>
    </section>

    <Breadcrumbs isProject projectTitle={project.data.title} />

    <!-- Gallery -->
    {project.data.gallery && project.data.gallery.length > 0 && (
        <section class="py-16 bg-surface">
            <div class="container mx-auto px-4">
                <header class="text-center mb-12">
                    <h2 class="text-3xl font-heading font-bold text-heading mb-4">Galería de Imágenes</h2>
                    <div class="w-20 h-1 bg-primary mx-auto rounded-full"></div>
                </header>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {project.data.gallery.map((item) => (
                        <div class="group relative rounded-xl overflow-hidden shadow-lg aspect-square bg-secondary cursor-zoom-in">
                            <img
                                src={item.image}
                                alt={item.alt}
                                width={800}
                                height={800}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                                <p class="text-white font-medium text-sm transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                                    {item.alt}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- Content MDX -->
    {project.body && project.body.trim() !== "" && (
        <section class="py-16 bg-secondary">
            <div class="container mx-auto px-4 max-w-3xl">
                <div class="prose prose-lg prose-invert max-w-none
                    prose-headings:font-heading prose-headings:text-heading
                    prose-p:text-body prose-p:leading-relaxed
                    prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                    prose-strong:text-heading prose-img:rounded-xl prose-img:shadow-lg">
                    <Content components={mdxComponents} />
                </div>
            </div>
        </section>
    )}

    <FinalCTA
        title={`¿Necesitas un trabajo similar en ${project.data.locationTag || settings.city}?`}
        subtitle={`Contacta ahora y recibe tu presupuesto gratuito sin compromiso.`}
    />
    <Footer />
</Layout>
