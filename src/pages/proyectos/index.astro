---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { MapPin, Wrench, ArrowRight } from "lucide-react";
import { getSettings } from "@/lib/settings";
import { buildBlogListGraph } from "@/lib/seo";

const settings = await getSettings();
const { siteName, city, niche } = settings;

const projects = await getCollection("projects");

// Ordenar: destacados primero
const sortedProjects = [...projects].sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return 0;
});

const siteUrl = settings.siteUrl || Astro.site?.href || '';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = `Nuestros Proyectos | ${siteName}`;
const pageDesc = `Galería de proyectos de ${niche} en ${city}. Descubre la calidad de nuestros trabajos.`;

const gallerySchema = buildBlogListGraph({
    settings,
    siteUrl,
    pageUrl,
    title: pageTitle,
    description: pageDesc,
    posts: sortedProjects.map(p => ({
        url: `${siteUrl.replace(/\/$/, '')}/proyectos/${p.slug}/`,
        title: p.data.title,
        image: p.data.image,
    })),
});
---

<Layout
    title={pageTitle}
    description={pageDesc}
    schema={gallerySchema}
>
    <section class="relative py-20 bg-secondary border-b border-heading/5">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-5xl md:text-7xl font-heading font-bold text-heading mb-6">
                NUESTROS <span
                    class="text-transparent bg-clip-text"
                    style="background-image: var(--theme-gradient);"
                >PROYECTOS</span>
            </h1>
            <p class="text-xl text-body max-w-2xl mx-auto">
                Una imagen vale más que mil palabras. Descubre la calidad de
                nuestros trabajos en {city} y provincia.
            </p>
        </div>
    </section>

    <section class="py-20 bg-surface/30">
        <div class="container mx-auto px-4">
            {sortedProjects.length > 0 ? (
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {sortedProjects.map((project) => (
                        <a
                            href={`/proyectos/${project.slug}/`}
                            class="group relative rounded-xl overflow-hidden bg-surface shadow-lg border border-heading/10 hover:border-primary/50 transition-all hover:shadow-2xl hover:shadow-primary/10 aspect-[4/3] block"
                        >
                            <!-- Imagen -->
                            {project.data.image ? (
                                <Image
                                    src={project.data.image}
                                    alt={project.data.title}
                                    width={800}
                                    height={600}
                                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                />
                            ) : (
                                <div class="absolute inset-0 bg-surface/50 flex items-center justify-center text-body/40 group-hover:scale-105 transition-transform duration-700">
                                    <span class="text-sm uppercase tracking-widest font-bold">
                                        {project.data.title}
                                    </span>
                                </div>
                            )}

                            <!-- Overlay -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-70 group-hover:opacity-90 transition-opacity" />

                            <!-- Info -->
                            <div class="absolute bottom-0 left-0 p-5 translate-y-2 group-hover:translate-y-0 transition-transform w-full">
                                <div class="flex flex-wrap gap-2 mb-2">
                                    {project.data.locationTag && (
                                        <span class="inline-flex items-center gap-1 text-primary text-xs font-bold uppercase tracking-wider bg-black/50 px-2 py-1 rounded backdrop-blur-sm border border-white/10">
                                            <MapPin className="w-3 h-3" />
                                            {project.data.locationTag}
                                        </span>
                                    )}
                                    {project.data.serviceType && (
                                        <span class="inline-flex items-center gap-1 text-white/70 text-xs font-bold uppercase tracking-wider bg-black/50 px-2 py-1 rounded backdrop-blur-sm border border-white/10">
                                            <Wrench className="w-3 h-3" />
                                            {project.data.serviceType}
                                        </span>
                                    )}
                                </div>
                                <h3 class="text-xl font-heading font-bold text-white leading-tight mb-1">
                                    {project.data.title}
                                </h3>
                                <span class="inline-flex items-center gap-1 text-primary text-xs font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
                                    Ver proyecto <ArrowRight className="w-3 h-3" />
                                </span>
                            </div>
                        </a>
                    ))}
                </div>
            ) : (
                <div class="text-center py-20 border-2 border-dashed border-heading/20 rounded-xl bg-surface/30">
                    <p class="text-body text-lg mb-4">
                        Estamos actualizando nuestra galería de proyectos de {niche}.
                    </p>
                    <a href="/contacto/" class="text-primary font-bold hover:underline">
                        Solicitar fotos de trabajos recientes
                    </a>
                </div>
            )}
        </div>
    </section>

    <FinalCTA />
    <Footer />
</Layout>
