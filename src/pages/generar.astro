---
import { getEntry } from 'astro:content';
import GeneradorIA from '../components/GeneradorIA';

const business = await getEntry('business', 'global');
const businessName = business?.data?.siteName ?? 'Mi Negocio';
const niche = business?.data?.niche ?? 'Servicios';
const city = business?.data?.city ?? 'España';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Generador IA — Herramienta de Desarrollo</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <GeneradorIA
      client:only="react"
      businessName={businessName}
      niche={niche}
      city={city}
    />
  </body>
</html>
