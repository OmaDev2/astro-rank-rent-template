---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import { Phone, Mail, MapPin, Clock, Send } from "lucide-react";
import type { WithContext, ContactPage } from "schema-dts";

// Fetch Global Settings
const settings = await getEntry("settings", "global");
const { siteName, phone, email, address, city, niche } = settings?.data || {
    siteName: "Herrero Zaragoza",
    phone: "600 000 000",
    email: "info@example.com",
    address: "Calle Ejemplo, 123",
    city: "Zaragoza",
    niche: "Herrería",
};

const schema: WithContext<ContactPage> = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: `Contacto ${siteName}`,
    description: `Contacte con ${siteName} para solicitar presupuesto de ${niche}.`,
    mainEntity: {
        "@type": "Locksmith",
        name: siteName,
        telephone: phone,
        email: email,
    },
};
---

<Layout title={`Contacto y Presupuesto | ${siteName}`} schema={schema}>
    <section class="py-20 bg-slate-900">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h1 class="text-5xl font-heading font-bold text-white mb-4">
                    Contactar
                </h1>
                <p class="text-slate-400 max-w-2xl mx-auto">
                    Solicite presupuesto sin compromiso. Respondemos en menos de
                    24 horas. Para urgencias, llámenos directamente.
                </p>
            </div>

            <div class="grid lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
                <!-- Contact Info -->
                <div class="space-y-8">
                    <div
                        class="p-8 bg-slate-800 rounded-lg border border-slate-700"
                    >
                        <h3 class="text-2xl font-bold text-white mb-6">
                            Información Directa
                        </h3>
                        <ul class="space-y-6">
                            <li class="flex items-start gap-4">
                                <div
                                    class="p-3 bg-slate-900 rounded text-amber-600"
                                >
                                    <Phone className="w-6 h-6" />
                                </div>
                                <div>
                                    <h4 class="font-bold text-white">
                                        Teléfono / WhatsApp
                                    </h4>
                                    <a
                                        href={`tel:${phone}`}
                                        class="text-slate-300 hover:text-amber-500 transition-colors text-lg"
                                        >{phone}</a
                                    >
                                    <p class="text-xs text-slate-500 mt-1">
                                        Atención telefónica de 8:00 a 20:00
                                    </p>
                                </div>
                            </li>
                            <li class="flex items-start gap-4">
                                <div
                                    class="p-3 bg-slate-900 rounded text-amber-600"
                                >
                                    <Mail className="w-6 h-6" />
                                </div>
                                <div>
                                    <h4 class="font-bold text-white">Email</h4>
                                    <a
                                        href={`mailto:${email}`}
                                        class="text-slate-300 hover:text-amber-500 transition-colors"
                                        >{email}</a
                                    >
                                </div>
                            </li>
                            <li class="flex items-start gap-4">
                                <div
                                    class="p-3 bg-slate-900 rounded text-amber-600"
                                >
                                    <MapPin className="w-6 h-6" />
                                </div>
                                <div>
                                    <h4 class="font-bold text-white">Taller</h4>
                                    <p class="text-slate-300">
                                        {address}, {city}
                                    </p>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Map Placeholder -->
                    <div
                        class="aspect-video bg-slate-800 rounded-lg border border-slate-700 overflow-hidden relative group"
                    >
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d47660.85243869811!2d-0.9366050478796859!3d41.65167664875693!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd5914dd5e618e91%3A0x49df13f1158489a8!2sZaragoza!5e0!3m2!1ses!2ses!4v1700000000000!5m2!1ses!2ses"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            class="grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500"
                        ></iframe>
                    </div>
                </div>

                <!-- Form -->
                <div
                    class="p-8 bg-slate-800 rounded-lg border border-slate-700 h-fit"
                >
                    <h3 class="text-2xl font-bold text-white mb-6">
                        Envíenos un Mensaje
                    </h3>
                    <form class="space-y-6">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="name"
                                    class="block text-sm font-medium text-slate-400 mb-2"
                                    >Nombre</label
                                >
                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    class="w-full bg-slate-900 border border-slate-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-600 transition-colors"
                                    placeholder="Su nombre"
                                    required
                                />
                            </div>
                            <div>
                                <label
                                    for="phone"
                                    class="block text-sm font-medium text-slate-400 mb-2"
                                    >Teléfono</label
                                >
                                <input
                                    type="tel"
                                    id="phone"
                                    name="phone"
                                    class="w-full bg-slate-900 border border-slate-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-600 transition-colors"
                                    placeholder="600 000 000"
                                    required
                                />
                            </div>
                        </div>

                        <div>
                            <label
                                for="email"
                                class="block text-sm font-medium text-slate-400 mb-2"
                                >Email</label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="w-full bg-slate-900 border border-slate-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-600 transition-colors"
                                placeholder="email@ejemplo.com"
                            />
                        </div>

                        <div>
                            <label
                                for="service"
                                class="block text-sm font-medium text-slate-400 mb-2"
                                >Tipo de Servicio</label
                            >
                            <select
                                id="service"
                                name="service"
                                class="w-full bg-slate-900 border border-slate-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-600 transition-colors"
                            >
                                <option value=""
                                    >Seleccione una opción...</option
                                >
                                <option value="rejas">Rejas y Seguridad</option>
                                <option value="puertas"
                                    >Puertas Metálicas</option
                                >
                                <option value="estructuras"
                                    >Estructuras Industriales</option
                                >
                                <option value="cerramientos"
                                    >Cerramientos</option
                                >
                                <option value="otro">Otro</option>
                            </select>
                        </div>

                        <div>
                            <label
                                for="message"
                                class="block text-sm font-medium text-slate-400 mb-2"
                                >Mensaje</label
                            >
                            <textarea
                                id="message"
                                name="message"
                                rows="4"
                                class="w-full bg-slate-900 border border-slate-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-600 transition-colors"
                                placeholder="Describa brevemente lo que necesita..."
                                required></textarea>
                        </div>

                        <div class="flex items-start gap-3">
                            <input
                                type="checkbox"
                                id="privacy-contact"
                                name="privacy"
                                required
                                class="mt-1 w-4 h-4 rounded border-slate-700 bg-slate-800 text-amber-600 focus:ring-amber-600 focus:ring-offset-slate-900"
                            />
                            <label
                                for="privacy-contact"
                                class="text-xs text-slate-400"
                            >
                                He leído y acepto la <a
                                    href="/privacidad"
                                    target="_blank"
                                    class="text-amber-500 hover:text-amber-400 underline"
                                    >Política de Privacidad</a
                                > y consiento que mis datos sean compartidos con
                                profesionales del sector para recibir presupuestos.
                                *
                            </label>
                        </div>

                        <button
                            type="submit"
                            id="submit-button-contact"
                            disabled
                            class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-4 rounded transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            <Send className="w-5 h-5" />
                            Enviar Solicitud
                        </button>
                        <p class="text-xs text-slate-500 text-center">
                            No enviamos spam. Tus datos están seguros.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <Footer />
</Layout>

<script>
    // Enable/disable submit button based on privacy checkbox
    document.addEventListener("DOMContentLoaded", () => {
        const privacyCheckbox = document.getElementById(
            "privacy-contact",
        ) as HTMLInputElement;
        const submitButton = document.getElementById(
            "submit-button-contact",
        ) as HTMLButtonElement;

        if (privacyCheckbox && submitButton) {
            privacyCheckbox.addEventListener("change", () => {
                submitButton.disabled = !privacyCheckbox.checked;
            });
        }
    });
</script>
