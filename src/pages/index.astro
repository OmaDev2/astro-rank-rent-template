---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero-home.png";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import FinalCTA from "../components/FinalCTA.astro";
import LocationsSection from "../components/LocationsSection.astro";
import HeroContactForm from "../components/HeroContactForm.astro";
import { getWhatsAppUrl, businessConfig } from "../config/business";
import FaqAccordion from "../components/FaqAccordion.astro";
import {
	ArrowRight,
	Phone,
	Star,
	Shield,
	Wrench,
	Hammer,
	MapPin,
	CheckCircle,
	Users,
	Award,
} from "lucide-react";
import type { WithContext, Locksmith } from "schema-dts";

// Fetch Data
const featuredServices = await getCollection("services", ({ data }) => {
	return data.featured === true;
});

const recentProjects = (await getCollection("projects")).slice(0, 4);

// Schema
const schema: WithContext<Locksmith> = {
	"@context": "https://schema.org",
	"@type": "Locksmith",
	name: "Herrero Zaragoza",
	image: "https://herrerozaragoza.com/logo.png", // Placeholder
	description:
		"Herreros profesionales en Zaragoza. Fabricación e instalación de rejas, puertas, estructuras metálicas y cerramientos.",
	telephone: businessConfig.contact.phone,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Zaragoza",
		addressRegion: "Zaragoza",
		addressCountry: "ES",
	},
	areaServed: {
		"@type": "GeoCircle",
		geoMidpoint: {
			"@type": "GeoCoordinates",
			latitude: 41.6488,
			longitude: -0.8891,
		},
		geoRadius: "50000", // 50km radius
	},
	priceRange: "$$",
};

const homeFaqs = [
	{
		question: "¿Hacéis presupuestos sin compromiso?",
		answer: "Sí, todos nuestros presupuestos son 100% gratuitos y sin ningún tipo de compromiso. Nos desplazamos a tu domicilio o negocio para evaluar el trabajo si es necesario.",
	},
	{
		question: "¿Trabajáis en toda la provincia de Zaragoza?",
		answer: "Sí, nuestro taller está en Zaragoza capital pero nos desplazamos por toda la provincia (Cuarte, Utebo, Zuera, La Muela, etc.).",
	},
];
---

<Layout
	title="Herreros en Zaragoza | Forja, Rejas y Estructuras Metálicas"
	schema={schema}
>
	<!-- 1. Hero Section -->
	<section
		class="relative h-[80vh] min-h-[600px] flex items-center bg-slate-900 overflow-hidden"
	>
		<!-- Background Image Optimized -->
		<div class="absolute inset-0 w-full h-full">
			<Image
				src={heroImage}
				alt="Herrero trabajando en taller de Zaragoza soldando estructura metálica"
				class="w-full h-full object-cover opacity-40"
				loading="eager"
				fetchpriority="high"
				quality="mid"
			/>
		</div>
		<div
			class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-transparent"
		>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="max-w-2xl">
				<h1
					class="text-6xl lg:text-8xl font-heading font-bold text-white mb-6 leading-none"
				>
					HERREROS <br />
					<span
						class="text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-yellow-600"
						>EN ZARAGOZA</span
					>
				</h1>
				<p
					class="text-xl text-slate-300 mb-8 font-light border-l-4 border-amber-600 pl-4"
				>
					Expertos en seguridad y reformas metálicas. Reparaciones
					urgentes, rejas a medida y cerramientos en toda la
					provincia. Presupuesto sin compromiso en menos de 24h.
				</p>
				<div class="flex flex-col sm:flex-row gap-4">
					<a
						href="#presupuesto"
						class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-amber-600 hover:bg-amber-700 text-white rounded transition-all shadow-lg shadow-amber-900/20 hover:shadow-amber-900/40"
					>
						<Phone className="w-5 h-5 mr-2" />
						Solicitar Presupuesto Ahora
					</a>
					<a
						href={getWhatsAppUrl()}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white border border-slate-600 rounded hover:bg-slate-800 transition-colors"
					>
						<svg
							class="w-5 h-5 mr-2"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
							></path></svg
						>
						Contactar por WhatsApp
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Services Grid -->
	<section
		id="servicios"
		class="py-20 bg-slate-950 border-b border-slate-800"
	>
		<div class="container mx-auto px-4">
			<div class="text-center mb-16">
				<div class="flex items-center justify-center gap-4 mb-4">
					<div class="h-px w-12 bg-amber-600"></div>
					<span
						class="text-amber-500 font-bold uppercase tracking-widest text-sm"
						>Nuestros Servicios</span
					>
					<div class="h-px w-12 bg-amber-600"></div>
				</div>
				<h2
					class="text-4xl lg:text-5xl font-heading font-bold text-white mb-6"
				>
					Herrería, Rejas y Estructuras <br />
					<span class="text-amber-500">Metálicas en Zaragoza</span>
				</h2>
				<p class="text-slate-400 max-w-2xl mx-auto text-lg">
					Desde pequeñas reparaciones hasta grandes estructuras.
					Cubrimos todas las necesidades de herrería para tu hogar o
					negocio.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{
					featuredServices.map((service) => (
						<a
							href={`/${service.slug}/`}
							class="group relative overflow-hidden rounded-lg border border-slate-800 hover:border-amber-600/50 transition-all hover:shadow-xl hover:shadow-amber-900/20 h-[400px]"
						>
							{/* Background Image */}
							<div
								class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
								style={`background-image: url('/images/services/${service.slug}-1.png')`}
							/>

							{/* Gradient Overlay */}
							<div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/50 to-transparent" />

							{/* Content */}
							<div class="relative h-full flex flex-col justify-end p-8">
								<h3 class="text-2xl font-heading font-bold text-white mb-3">
									{service.data.title}
								</h3>
								<p class="text-slate-300 mb-6 line-clamp-2 text-sm">
									{service.data.shortDesc}
								</p>
								<div class="inline-flex items-center text-amber-600 font-bold group-hover:text-amber-500">
									Leer más{" "}
									<ArrowRight className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" />
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- 3. About Us / Sobre Nosotros -->
	<section class="py-20 bg-slate-950">
		<div class="container mx-auto px-4">
			<div
				class="grid lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto"
			>
				<!-- Image -->
				<div class="relative">
					<div
						class="aspect-[4/3] rounded-2xl overflow-hidden border border-slate-800"
					>
						<img
							src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=2070&auto=format&fit=crop"
							alt="Taller de herrería Zaragoza"
							class="w-full h-full object-cover"
						/>
					</div>
					<!-- Badge -->
					<div
						class="absolute -bottom-6 -right-6 bg-amber-600 text-white p-6 rounded-xl shadow-2xl"
					>
						<div class="text-center">
							<div class="text-4xl font-heading font-bold">
								+15
							</div>
							<div class="text-sm uppercase tracking-wider">
								Años
							</div>
						</div>
					</div>
				</div>

				<!-- Content -->
				<div>
					<h2 class="text-4xl font-heading font-bold text-white mb-6">
						Herrería Artesanal desde 2010
					</h2>
					<div class="w-24 h-1 bg-amber-600 mb-6"></div>

					<p class="text-slate-300 mb-6 leading-relaxed">
						Somos una empresa familiar con <strong
							>más de 70 años de experiencia</strong
						> en el sector de la herrería y trabajos metálicos en Zaragoza.
						Desde 1950, hemos fabricado e instalado miles de proyectos
						para hogares, empresas e industrias.
					</p>

					<p class="text-slate-300 mb-8 leading-relaxed">
						Nuestro compromiso es ofrecer <strong
							>calidad, seguridad y durabilidad</strong
						> en cada trabajo. Contamos con taller propio en Zaragoza,
						lo que nos permite controlar todo el proceso de fabricación
						y ajustar los precios al máximo.
					</p>

					<!-- Features List -->
					<div class="space-y-4 mb-8">
						<div class="flex items-start gap-3">
							<CheckCircle
								className="w-6 h-6 text-amber-600 flex-shrink-0 mt-0.5"
							/>
							<div>
								<h4 class="text-white font-bold mb-1">
									Taller Propio
								</h4>
								<p class="text-slate-400 text-sm">
									Fabricación 100% en nuestras instalaciones
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<CheckCircle
								className="w-6 h-6 text-amber-600 flex-shrink-0 mt-0.5"
							/>
							<div>
								<h4 class="text-white font-bold mb-1">
									Materiales Certificados
								</h4>
								<p class="text-slate-400 text-sm">
									Acero de primera calidad con garantía
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<CheckCircle
								className="w-6 h-6 text-amber-600 flex-shrink-0 mt-0.5"
							/>
							<div>
								<h4 class="text-white font-bold mb-1">
									Instalación Profesional
								</h4>
								<p class="text-slate-400 text-sm">
									Equipo técnico especializado y experimentado
								</p>
							</div>
						</div>
					</div>

					<!-- CTA Button -->
					<a
						href="/nosotros"
						class="inline-flex items-center text-amber-600 font-bold hover:text-amber-500 border border-amber-600/30 hover:border-amber-600 px-6 py-3 rounded-lg transition-all"
					>
						Conoce más sobre nuestra historia <ArrowRight
							className="w-4 h-4 ml-2"
						/>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Why Choose Us -->
	<section class="py-20 bg-slate-900 border-y border-slate-800">
		<div class="container mx-auto px-4">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<h2 class="text-4xl font-heading font-bold text-white mb-4">
					¿Por Qué Elegirnos?
				</h2>
				<div class="w-24 h-1 bg-amber-600 mx-auto mb-4"></div>
				<p class="text-slate-400 max-w-2xl mx-auto">
					Más de 15 años de experiencia nos avalan. Somos tu mejor
					opción en herrería y trabajos metálicos en Zaragoza.
				</p>
			</div>

			<!-- Features Grid -->
			<div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
				<!-- Feature 1: Taller Propio -->
				<div
					class="group relative p-8 bg-slate-800/50 rounded-xl border border-slate-700 hover:border-amber-600/50 transition-all hover:shadow-xl hover:shadow-amber-900/10"
				>
					<div
						class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-600 to-yellow-600 rounded-t-xl opacity-0 group-hover:opacity-100 transition-opacity"
					>
					</div>

					<div
						class="w-16 h-16 bg-gradient-to-br from-amber-600 to-amber-700 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
					>
						<Hammer className="w-8 h-8 text-white" />
					</div>

					<h3 class="text-2xl font-heading font-bold text-white mb-4">
						Taller Propio
					</h3>

					<p class="text-slate-400 leading-relaxed">
						Sin intermediarios. Fabricamos en nuestro taller de
						Zaragoza para ajustar el precio al máximo y garantizar
						la calidad.
					</p>
				</div>

				<!-- Feature 2: Garantía -->
				<div
					class="group relative p-8 bg-slate-800/50 rounded-xl border border-slate-700 hover:border-amber-600/50 transition-all hover:shadow-xl hover:shadow-amber-900/10"
				>
					<div
						class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-600 to-yellow-600 rounded-t-xl opacity-0 group-hover:opacity-100 transition-opacity"
					>
					</div>

					<div
						class="w-16 h-16 bg-gradient-to-br from-amber-600 to-amber-700 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
					>
						<Shield className="w-8 h-8 text-white" />
					</div>

					<h3 class="text-2xl font-heading font-bold text-white mb-4">
						Garantía de Calidad
					</h3>

					<p class="text-slate-400 leading-relaxed">
						Materiales certificados y soldaduras homologadas.
					</p>
				</div>

				<!-- Feature 3: Experiencia -->
				<div
					class="group relative p-8 bg-slate-800/50 rounded-xl border border-slate-700 hover:border-amber-600/50 transition-all hover:shadow-xl hover:shadow-amber-900/10"
				>
					<div
						class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-600 to-yellow-600 rounded-t-xl opacity-0 group-hover:opacity-100 transition-opacity"
					>
					</div>

					<div
						class="w-16 h-16 bg-gradient-to-br from-amber-600 to-amber-700 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
					>
						<Star className="w-8 h-8 text-white" />
					</div>

					<h3 class="text-2xl font-heading font-bold text-white mb-4">
						+15 Años de Experiencia
					</h3>

					<p class="text-slate-400 leading-relaxed">
						Desde 2010 en el sector. Conocemos a fondo la normativa
						de Zaragoza para cerramientos y seguridad.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. Contact Form Section -->
	<section
		id="presupuesto"
		class="py-20 bg-slate-950 relative overflow-hidden"
	>
		<!-- Background Elements -->
		<div
			class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"
		>
		</div>
		<div
			class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-amber-900/10 to-transparent"
		>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div
				class="max-w-4xl mx-auto bg-slate-900 rounded-2xl border border-slate-800 shadow-2xl overflow-hidden flex flex-col md:flex-row"
			>
				<!-- Left Side: Text -->
				<div class="p-8 md:p-12 md:w-1/2 flex flex-col justify-center">
					<h2 class="text-3xl font-heading font-bold text-white mb-4">
						¿Necesitas un Presupuesto?
					</h2>
					<p class="text-slate-400 mb-8">
						Cuéntanos tu proyecto. Te respondemos en menos de 24
						horas con una valoración gratuita y sin compromiso.
					</p>

					<div class="space-y-4">
						<div class="flex items-center text-slate-300">
							<div
								class="w-10 h-10 rounded-full bg-amber-600/20 flex items-center justify-center text-amber-600 mr-4"
							>
								<Phone className="w-5 h-5" />
							</div>
							<div>
								<div class="text-xs text-slate-500 uppercase">
									Llámanos ahora
								</div>
								<div class="font-bold text-white">
									644 371 602
								</div>
							</div>
						</div>
						<div class="flex items-center text-slate-300">
							<div
								class="w-10 h-10 rounded-full bg-amber-600/20 flex items-center justify-center text-amber-600 mr-4"
							>
								<MapPin className="w-5 h-5" />
							</div>
							<div>
								<div class="text-xs text-slate-500 uppercase">
									Taller en
								</div>
								<div class="font-bold text-white">Zaragoza</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Right Side: Form -->
				<div
					class="p-8 md:p-12 md:w-1/2 bg-slate-800/50 border-l border-slate-700/50"
				>
					<HeroContactForm
						title="Solicitar Valoración"
						subtitle="Rellena el formulario y te contactamos."
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. Testimonials -->
	<section class="py-20 bg-slate-900 border-t border-slate-800">
		<div class="container mx-auto px-4">
			<div class="text-center mb-16">
				<h2 class="text-4xl font-heading font-bold text-white mb-4">
					Lo que dicen nuestros clientes
				</h2>
				<div class="w-24 h-1 bg-amber-600 mx-auto"></div>
			</div>

			<div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
				<!-- Review 1 -->
				<div
					class="bg-slate-800/50 p-8 rounded-xl border border-slate-700"
				>
					<div class="flex text-amber-500 mb-4">
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
					</div>
					<p class="text-slate-300 mb-6 italic">
						"Excelente trabajo con las rejas de mi chalet. Rápidos,
						limpios y muy profesionales. El acabado es perfecto."
					</p>
					<div class="flex items-center">
						<div
							class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-slate-400 font-bold mr-3"
						>
							JP
						</div>
						<div>
							<div class="text-white font-bold">Javier Pérez</div>
							<div class="text-xs text-slate-500">
								Cuarte de Huerva
							</div>
						</div>
					</div>
				</div>

				<!-- Review 2 -->
				<div
					class="bg-slate-800/50 p-8 rounded-xl border border-slate-700"
				>
					<div class="flex text-amber-500 mb-4">
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
					</div>
					<p class="text-slate-300 mb-6 italic">
						"Nos fabricaron una escalera a medida para el local y
						quedó espectacular. Entendieron perfectamente la idea."
					</p>
					<div class="flex items-center">
						<div
							class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-slate-400 font-bold mr-3"
						>
							MG
						</div>
						<div>
							<div class="text-white font-bold">Marta García</div>
							<div class="text-xs text-slate-500">
								Zaragoza Centro
							</div>
						</div>
					</div>
				</div>

				<!-- Review 3 -->
				<div
					class="bg-slate-800/50 p-8 rounded-xl border border-slate-700"
				>
					<div class="flex text-amber-500 mb-4">
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
						<Star className="w-5 h-5 fill-current" />
					</div>
					<p class="text-slate-300 mb-6 italic">
						"Servicio de urgencia impecable. Se atascó la puerta del
						garaje un domingo y vinieron en menos de 2 horas."
					</p>
					<div class="flex items-center">
						<div
							class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-slate-400 font-bold mr-3"
