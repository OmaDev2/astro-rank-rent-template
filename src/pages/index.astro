---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { getCollection, getEntry } from "astro:content";
import type { WithContext, LocalBusiness } from "schema-dts";

// Imports de Componentes Generales
import WhatsAppButton from "../components/WhatsAppButton.astro";
import FinalCTA from "../components/FinalCTA.astro";
import LocationsSection from "../components/LocationsSection.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Testimonials from "../components/Testimonials.astro";

// Imports de Bloques Específicos de Home
import HomeHero from "../components/blocks/home/HomeHero.astro";
import HomeServices from "../components/blocks/home/HomeServices.astro";
import HomeAbout from "../components/blocks/home/HomeAbout.astro";
import HomeFeatures from "../components/blocks/home/HomeFeatures.astro";
import HomeContact from "../components/blocks/home/HomeContact.astro";

// 1. Fetch Data
const featuredServices = await getCollection(
	"services",
	({ data }) => data.featured === true,
);
const testimonials = await getCollection("testimonials");
const home = await getEntry("pages", "home");
const homeData = home?.data || {};

// Render contenido SEO
const { Content: SeoContentRendered } = home
	? await home.render()
	: { Content: () => null };

// 2. Global Settings
const business = await getEntry("business", "global");
const config = business?.data || {
	siteName: "Nombre Negocio",
	phone: "000 000 000",
	city: "Ciudad",
	niche: "Servicio",
	whatsapp: "",
	businessType: "LocalBusiness",
	logo: "",
	siteUrl: "",
	address: "",
	coordinates: { lat: "", lng: "" },
	email: "",
	ctaText: "Pedir Presupuesto",
};

// 3. Page Builder Logic
const defaultBlocks = [
	{ discriminant: "hero" },
	{ discriminant: "services" },
	{ discriminant: "about" },
	{ discriminant: "features" },
	{ discriminant: "contact" },
	{ discriminant: "testimonials" },
	{ discriminant: "content" },
	{ discriminant: "faq" },
	{ discriminant: "locations" },
	{ discriminant: "cta" },
];

const finalBlocks =
	homeData.blocks && homeData.blocks.length > 0
		? homeData.blocks
		: defaultBlocks;

// 4. Schema SEO
const schema: WithContext<LocalBusiness> = {
	"@context": "https://schema.org",
	"@type": (config.businessType as any) || "LocalBusiness",
	name: config.siteName,
	image: config.logo || `${config.siteUrl}/images/home/logo.png`,
	description: `${config.niche} en ${config.city}. Servicio profesional.`,
	telephone: config.phone,
	address: {
		"@type": "PostalAddress",
		addressLocality: config.city,
		addressCountry: "ES",
	},
	priceRange: "$$",
};
---

<Layout
	title={`${homeData.hero?.heading || config.niche + " en " + config.city} | ${config.siteName}`}
	schema={schema}
>
	{
		finalBlocks.map((block: any) => {
			switch (block.discriminant) {
				case "hero":
					return <HomeHero hero={homeData.hero} config={config} />;

				case "services":
					return (
						<HomeServices
							servicesSection={homeData.servicesSection}
							featuredServices={featuredServices}
							city={config.city}
						/>
					);

				case "about":
					return <HomeAbout aboutSection={homeData.aboutSection} />;

				case "features":
					return (
						<HomeFeatures
							features={homeData.features}
							city={config.city}
						/>
					);

				case "contact":
					return <HomeContact config={config} />;

				case "testimonials":
					return <Testimonials testimonials={testimonials} />;

				case "content":
					return homeData.seoContentTitle ? (
						<section class="py-20 bg-secondary">
							<div class="container mx-auto px-4 max-w-4xl">
								<h2 class="text-3xl font-heading font-bold text-heading mb-8">
									{homeData.seoContentTitle}
								</h2>
								<div class="prose prose-invert prose-lg text-body">
									<SeoContentRendered />
								</div>
							</div>
						</section>
					) : null;

				case "faq":
					return homeData.faq && homeData.faq.length > 0 ? (
						<div class="container mx-auto px-4 max-w-4xl py-20">
							<h2 class="text-3xl font-heading font-bold text-heading mb-8 text-center">
								Preguntas Frecuentes
							</h2>
							<FaqAccordion items={homeData.faq} />
						</div>
					) : null;

				case "locations":
					return <LocationsSection />;

				case "cta":
					return <FinalCTA />;

				default:
					return null;
			}
		})
	}

	<WhatsAppButton />
	<Footer />
</Layout>
