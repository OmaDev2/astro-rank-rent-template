---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import HeroContactForm from "../components/HeroContactForm.astro";
import { getCollection } from "astro:content";
import { businessConfig, getPhoneUrl } from "../config/business";
import {
    Phone,
    CheckCircle,
    Shield,
    Wrench,
    Hammer,
    MapPin,
    ArrowRight,
} from "lucide-react";

// 1. Generar rutas estáticas para cada servicio
export async function getStaticPaths() {
    const services = await getCollection("services");
    return services.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;

// Fetch para Sidebar
const allServices = await getCollection("services");
const allLocations = await getCollection("locations");

// Mapa de Iconos (para convertir el string del CMS al componente real)
const iconMap = {
    Shield: Shield,
    Wrench: Wrench,
    Hammer: Hammer,
    MapPin: MapPin,
    default: Wrench,
};

const IconComponent =
    iconMap[data.icon as keyof typeof iconMap] || iconMap.default;

import type { WithContext, Service, FAQPage, Thing } from "schema-dts";

// Schema SEO específico para Servicios
const serviceSchema: WithContext<Service> = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: data.title,
    provider: {
        "@type": "Locksmith",
        name: businessConfig.name,
    },
    description: data.shortDesc,
    areaServed: {
        "@type": "City",
        name: businessConfig.serviceArea.main,
    },
};

// Combinar schemas
let schemas: WithContext<Thing>[] = [serviceSchema];

if (data.faq && data.faq.length > 0) {
    const faqSchema: WithContext<FAQPage> = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: data.faq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
            },
        })),
    };
    schemas.push(faqSchema);
}

// SEO: Usar campos personalizados si existen, sino generar automáticamente
const pageTitle =
    data.seoTitle || `${data.title} en Zaragoza | Presupuesto Gratis`;
const pageDescription = data.seoDesc || data.shortDesc;
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
    <!-- HERO SERVICE con Imagen de Fondo -->
    <!-- HERO SERVICE con Formulario a la derecha -->
    <!-- HERO SERVICE -->
    <section
        class="relative min-h-[600px] flex items-center bg-slate-900 overflow-hidden py-20 lg:py-0"
    >
        <!-- Imagen de fondo -->
        <div
            class="absolute inset-0 bg-cover bg-center"
            style={`background-image: url('/images/services/${entry.slug}-1.png')`}
        >
        </div>
        <!-- Overlay oscuro -->
        <div
            class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/70 to-slate-950/60"
        >
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl">
                <!-- Badges de Confianza -->
                <div class="flex items-center gap-4 mb-6">
                    <div
                        class="bg-white/10 backdrop-blur px-4 py-2 rounded-full flex items-center gap-2 border border-white/20"
                    >
                        <span class="text-amber-500">★★★★★</span>
                        <span class="text-white text-sm font-bold"
                            >Google Reviews</span
                        >
                    </div>
                    <div
                        class="bg-white/10 backdrop-blur px-4 py-2 rounded-full flex items-center gap-2 border border-white/20"
                    >
                        <Shield className="w-4 h-4 text-amber-500" />
                        <span class="text-white text-sm font-bold"
                            >Garantía 100%</span
                        >
                    </div>
                </div>

                <h1
                    class="text-5xl lg:text-7xl font-heading font-bold text-white mb-6 leading-tight"
                >
                    {data.title}
                    <br />
                    <span class="text-amber-500">en Zaragoza</span>
                </h1>

                <p
                    class="text-xl text-slate-300 mb-8 font-light border-l-4 border-amber-600 pl-4 max-w-xl"
                >
                    {data.shortDesc}
                </p>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        href={getPhoneUrl()}
                        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-amber-600 hover:bg-amber-700 text-white rounded transition-all shadow-lg hover:shadow-amber-900/40"
                    >
                        <Phone className="w-5 h-5 mr-2" />
                        Llamar Ahora
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <section class="py-20 bg-slate-950">
        <div class="container mx-auto px-4 grid lg:grid-cols-3 gap-12">
            <!-- Columna Izquierda: Contenido MDX -->
            <div class="lg:col-span-2 space-y-12">
                <!-- Callout Urgencia -->
                <div
                    class="bg-green-800/20 border border-green-700/50 p-6 rounded-xl flex flex-col sm:flex-row items-center gap-6"
                >
                    <div
                        class="bg-green-600 p-4 rounded-full shrink-0 animate-pulse"
                    >
                        <Phone className="w-8 h-8 text-white" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white mb-2">
                            ¿Necesitas un servicio urgente?
                        </h3>
                        <p class="text-slate-300 mb-4">
                            Si tienes una urgencia (puerta atascada, cerradura
                            rota, etc.), llámanos ahora mismo. Atendemos 24h.
                        </p>
                        <a
                            href={getPhoneUrl()}
                            class="text-green-400 font-bold text-2xl hover:text-green-300 transition-colors"
                        >
                            {businessConfig.contact.phone}
                        </a>
                    </div>
                </div>

                <!-- Contenido principal -->
                <div class="prose prose-invert prose-lg prose-amber max-w-none">
                    <Content />
                </div>

                <!-- Imagen destacada integrada -->
                <div
                    class="relative aspect-[16/9] rounded-2xl overflow-hidden group shadow-2xl border border-slate-800"
                >
                    <img
                        src={`/images/services/${entry.slug}-2.png`}
                        alt={`Ejemplo profesional de ${data.title}`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                        onerror="this.style.display='none'"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"
                    >
                        <div class="absolute bottom-0 left-0 right-0 p-8">
                            <p class="text-white font-bold text-2xl mb-2">
                                Trabajos Realizados en Zaragoza
                            </p>
                            <p class="text-slate-300">
                                Fabricación e instalación profesional con
                                garantía
                            </p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Section (si existe) -->
                {
                    data.faq && data.faq.length > 0 && (
                        <FaqAccordion
                            title={`Preguntas Frecuentes sobre ${data.title}`}
                            items={data.faq}
                        />
                    )
                }
            </div>

            <!-- Columna Derecha: Sidebar Sticky -->
            <div class="hidden lg:block space-y-8 relative">
                <!-- Formulario Solapado (Sticky/Overlap) - Estilo Oscuro -->
                <div class="-mt-64 lg:-mt-[350px] relative z-20">
                    <HeroContactForm
                        title="Solicita Valoración"
                        subtitle="Respuesta en menos de 24h"
                    />
                </div>

                <!-- Widget Oferta -->
                <div
                    class="bg-gradient-to-br from-green-600 to-green-700 rounded-xl p-8 text-center shadow-xl relative overflow-hidden group"
                >
                    <div
                        class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"
                    >
                    </div>

                    <div class="relative z-10">
                        <div
                            class="text-green-100 font-bold uppercase tracking-wider text-sm mb-2"
                        >
                            Oferta Online
                        </div>
                        <div class="text-4xl font-bold text-white mb-2">
                            PRESUPUESTO
                        </div>
                        <div class="text-3xl font-bold text-white mb-6">
                            GRATIS
                        </div>
                        <p class="text-green-50 mb-6 text-sm">
                            Solicita tu valoración sin compromiso hoy mismo.
                            Respuesta rápida garantizada.
                        </p>
                        <a
                            href="#contacto"
                            class="inline-block w-full py-3 bg-white text-green-700 font-bold rounded hover:bg-green-50 transition-colors shadow-lg"
                        >
                            SOLICITAR AHORA
                        </a>
                    </div>
                </div>

                <!-- Navegación otros servicios -->
                <div
                    class="bg-slate-900 rounded-xl border border-slate-800 overflow-hidden"
                >
                    <div class="bg-slate-800 p-4 border-b border-slate-700">
                        <h4
                            class="font-bold text-white uppercase text-sm tracking-wider"
                        >
                            Nuestros Servicios
                        </h4>
                    </div>
                    <div class="p-2">
                        <ul class="space-y-1">
                            {
                                allServices.map((service) => (
                                    <li>
                                        <a
                                            href={`/${service.slug}`}
                                            class={`block p-3 rounded transition-colors flex justify-between group ${entry.slug === service.slug ? "bg-amber-600 text-white" : "hover:bg-slate-800 text-slate-400 hover:text-amber-500"}`}
                                        >
                                            {service.data.title}
                                            {entry.slug !== service.slug && (
                                                <ArrowRight className="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" />
                                            )}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>

                <!-- Zonas de Servicio -->
                <div
                    class="bg-slate-900 rounded-xl border border-slate-800 overflow-hidden"
                >
                    <div class="bg-slate-800 p-4 border-b border-slate-700">
                        <h4
                            class="font-bold text-white uppercase text-sm tracking-wider"
                        >
                            Zonas de Servicio
                        </h4>
                    </div>
                    <div class="p-2">
                        <ul class="space-y-1">
                            <li>
                                <a
                                    href="/"
                                    class="block p-3 rounded hover:bg-slate-800 text-slate-400 hover:text-amber-500 transition-colors text-sm"
                                >
                                    • Zaragoza Capital
                                </a>
                            </li>
                            {
                                allLocations.slice(0, 5).map((location) => (
                                    <li>
                                        <a
                                            href={`/zona/${location.slug}`}
                                            class="block p-3 rounded hover:bg-slate-800 text-slate-400 hover:text-amber-500 transition-colors text-sm"
                                        >
                                            • {location.data.name}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- MAPA SECTION -->
    <section
        class="w-full h-[400px] bg-slate-900 border-y border-slate-800 relative z-10"
    >
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2981.599466526706!2d-0.8891!3d41.6488!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd5914f579a775d7%3A0x5555555555555555!2sZaragoza!5e0!3m2!1ses!2ses!4v1600000000000!5m2!1ses!2ses"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="opacity-80 hover:opacity-100 transition-opacity duration-500 grayscale hover:grayscale-0"
        ></iframe>
    </section>

    <!-- CLUSTER SERVICIOS -->
    <section class="py-20 bg-slate-900">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-heading font-bold text-white mb-4">
                    Herrero Zaragoza ofrece servicios de:
                </h2>
                <div class="w-24 h-1 bg-amber-600 mx-auto mb-6"></div>
                <p class="text-slate-400 max-w-2xl mx-auto">
                    Soluciones profesionales en metal para todas tus necesidades
                    en Zaragoza y provincia.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {
                    allServices.map((service) => (
                        <a
                            href={`/servicios/${service.slug}`}
                            class="group bg-slate-800/50 p-4 rounded-lg shadow-sm hover:shadow-md border border-slate-700 hover:border-amber-500 transition-all flex items-center gap-4"
                        >
                            <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center group-hover:bg-amber-600/20 transition-colors shrink-0">
                                <CheckCircle className="w-5 h-5 text-slate-400 group-hover:text-amber-500 transition-colors" />
                            </div>
                            <h3 class="font-bold text-white group-hover:text-amber-500 transition-colors">
                                {service.data.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Testimonios -->
    <section class="py-20 bg-slate-900 border-t border-slate-800">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-heading font-bold text-white mb-4">
                    Lo que dicen nuestros clientes
                </h2>
                <div class="w-24 h-1 bg-amber-600 mx-auto"></div>
            </div>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <!-- Review 1 -->
                <div
                    class="bg-slate-800/50 p-8 rounded-xl border border-slate-700"
                >
                    <div class="flex text-amber-500 mb-4">
                        <span class="text-lg">★★★★★</span>
                    </div>
                    <p class="text-slate-300 mb-6 italic">
                        "Excelente trabajo. Rápidos, limpios y muy
                        profesionales. El acabado es perfecto."
                    </p>
                    <div class="flex items-center">
                        <div
                            class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-slate-400 font-bold mr-3"
                        >
                            JP
                        </div>
                        <div>
                            <div class="text-white font-bold">Javier Pérez</div>
                            <div class="text-xs text-slate-500">
                                Cliente Verificado
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Review 2 -->
                <div
                    class="bg-slate-800/50 p-8 rounded-xl border border-slate-700"
                >
                    <div class="flex text-amber-500 mb-4">
                        <span class="text-lg">★★★★★</span>
                    </div>
                    <p class="text-slate-300 mb-6 italic">
                        "Muy contentos con el resultado. Entendieron
                        perfectamente lo que necesitábamos."
                    </p>
                    <div class="flex items-center">
                        <div
                            class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-slate-400 font-bold mr-3"
                        >
                            MG
                        </div>
                        <div>
                            <div class="text-white font-bold">Marta García</div>
                            <div class="text-xs text-slate-500">
                                Cliente Verificado
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Review 3 -->
                <div
                    class="bg-slate-800/50 p-8 rounded-xl border border-slate-700"
                >
                    <div class="flex text-amber-500 mb-4">
                        <span class="text-lg">★★★★★</span>
                    </div>
                    <p class="text-slate-300 mb-6 italic">
                        "Servicio de urgencia impecable. Vinieron muy rápido y
                        solucionaron el problema."
                    </p>
                    <div class="flex items-center">
                        <div
                            class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-slate-400 font-bold mr-3"
                        >
                            RL
                        </div>
                        <div>
                            <div class="text-white font-bold">
                                Roberto López
                            </div>
                            <div class="text-xs text-slate-500">
                                Cliente Verificado
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <FinalCTA />
    <Footer />
</Layout>
