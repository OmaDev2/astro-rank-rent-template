---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

// Importar componentes MDX
import CtaBlock from "../../components/mdx/CtaBlock.astro";
import AlertBlock from "../../components/mdx/AlertBlock.astro";
import PhoneBlock from "../../components/mdx/PhoneBlock.astro";
import BusinessNameBlock from "../../components/mdx/BusinessNameBlock.astro";
import CustomImageBlock from "../../components/mdx/CustomImageBlock.astro";

const mdxComponents = {
    CtaBlock,
    AlertBlock,
    PhoneBlock,
    BusinessNameBlock,
    CustomImageBlock,
};

export const prerender = true;

export async function getStaticPaths() {
    // Blog sin publicar — quitar return [] y descomentar cuando haya posts reales
    return [];
    /* eslint-disable no-unreachable */
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: post,
    }));
    /* eslint-enable no-unreachable */
}

const post = Astro.props;
const { Content } = await post.render();
---

<BlogLayout
    title={post.data.title}
    description={post.data.description || ""}
    pubDate={post.data.pubDate ? new Date(post.data.pubDate) : undefined}
    author={post.data.author}
    heroImage={post.data.image}
    tags={post.data.tags}
    category={post.data.category}
>
    {
        post.data.intro && (
            <p class="lead text-xl text-body font-medium mb-8">
                {post.data.intro}
            </p>
        )
    }
    <Content components={mdxComponents} />
</BlogLayout>
