---
interface Row {
    label: string;
    left: string;
    right: string;
}

interface Props {
    title: string;
    subtitle?: string;
    titleTag?: "h2" | "h3";
    leftTitle: string;
    rightTitle: string;
    rows: Row[];
    conclusion?: string;
    ctaText?: string;
    ctaLink?: string;
    variant?: "table" | "cards" | "split";
    bgClass?: string;
}

const {
    title,
    subtitle,
    titleTag = "h2",
    leftTitle,
    rightTitle,
    rows = [],
    conclusion,
    ctaText,
    ctaLink = "/contacto/",
    variant = "table",
    bgClass = "bg-surface",
} = Astro.props;

if (!rows || rows.length === 0) return;

const TitleTag = titleTag as "h2" | "h3";
---

{/* ══════════════════════════════════════
    VARIANT: table — tabla responsive
    ══════════════════════════════════════ */}
{variant === "table" && (
    <section class={`py-20 ${bgClass}`}>
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
                    {title}
                </TitleTag>
                {subtitle && (
                    <p class="text-body text-lg leading-relaxed">{subtitle}</p>
                )}
            </div>

            <div class="max-w-4xl mx-auto">

                {/* Tabla — visible desde md */}
                <div class="hidden md:block rounded-2xl border border-heading/10 overflow-hidden shadow-sm">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-heading/10">
                                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-widest text-body opacity-60 w-1/4 bg-surface">
                                    Aspecto
                                </th>
                                <th class="px-6 py-4 text-left bg-surface w-[37.5%]">
                                    <span class="text-sm font-bold text-heading">{leftTitle}</span>
                                </th>
                                <th class="px-6 py-4 text-left bg-primary/5 w-[37.5%]">
                                    <span class="text-sm font-bold text-primary">{rightTitle}</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-heading/10">
                            {rows.map((row, i) => (
                                <tr class={i % 2 === 0 ? "bg-surface" : "bg-heading/[0.02]"}>
                                    <td class="px-6 py-4 font-semibold text-heading text-xs uppercase tracking-wider">
                                        {row.label}
                                    </td>
                                    <td class="px-6 py-4 text-body leading-relaxed">
                                        {row.left}
                                    </td>
                                    <td class="px-6 py-4 text-heading leading-relaxed bg-primary/[0.03]">
                                        {row.right}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>

                {/* Cards — visible en móvil */}
                <div class="md:hidden space-y-4">
                    {rows.map((row) => (
                        <div class="rounded-xl border border-heading/10 overflow-hidden">
                            <div class="px-4 py-2.5 bg-heading/5 border-b border-heading/10">
                                <p class="text-xs font-bold uppercase tracking-wider text-heading">{row.label}</p>
                            </div>
                            <div class="grid grid-cols-2 divide-x divide-heading/10">
                                <div class="px-4 py-4">
                                    <p class="text-xs font-bold text-body opacity-60 mb-1.5">{leftTitle}</p>
                                    <p class="text-sm text-body leading-relaxed">{row.left}</p>
                                </div>
                                <div class="px-4 py-4 bg-primary/[0.03]">
                                    <p class="text-xs font-bold text-primary mb-1.5">{rightTitle}</p>
                                    <p class="text-sm text-heading leading-relaxed">{row.right}</p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {(conclusion || ctaText) && (
                    <div class="mt-8 space-y-5">
                        {conclusion && (
                            <p class="text-body leading-relaxed border border-heading/10 rounded-xl px-6 py-4 bg-surface text-sm">
                                <span class="font-semibold text-heading">Conclusión: </span>
                                {conclusion}
                            </p>
                        )}
                        {ctaText && (
                            <div class="text-center">
                                <a href={ctaLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-base font-bold bg-primary text-white rounded transition-all shadow-lg">
                                    {ctaText}
                                </a>
                            </div>
                        )}
                    </div>
                )}
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════
    VARIANT: cards — fila por fila en cards
    ══════════════════════════════════════ */}
{variant === "cards" && (
    <section class={`py-20 ${bgClass}`}>
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
                    {title}
                </TitleTag>
                {subtitle && (
                    <p class="text-body text-lg leading-relaxed">{subtitle}</p>
                )}
            </div>

            <div class="max-w-4xl mx-auto space-y-4">

                {/* Cabecera de columnas */}
                <div class="grid grid-cols-[1fr_1fr] gap-4 px-4">
                    <div class="text-center">
                        <span class="inline-block px-4 py-1.5 rounded-full bg-heading/10 text-sm font-bold text-heading">
                            {leftTitle}
                        </span>
                    </div>
                    <div class="text-center">
                        <span class="inline-block px-4 py-1.5 rounded-full bg-primary/15 text-sm font-bold text-primary">
                            {rightTitle}
                        </span>
                    </div>
                </div>

                {/* Filas */}
                {rows.map((row) => (
                    <div class="rounded-2xl border border-heading/10 overflow-hidden">
                        <div class="px-5 py-2 bg-heading/5 border-b border-heading/10">
                            <p class="text-xs font-bold uppercase tracking-widest text-heading opacity-70">{row.label}</p>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-heading/10">
                            <div class="px-5 py-4 bg-surface">
                                <p class="text-sm text-body leading-relaxed">{row.left}</p>
                            </div>
                            <div class="px-5 py-4 bg-primary/[0.03]">
                                <p class="text-sm text-heading font-medium leading-relaxed">{row.right}</p>
                            </div>
                        </div>
                    </div>
                ))}

                {(conclusion || ctaText) && (
                    <div class="pt-4 space-y-5">
                        {conclusion && (
                            <div class="flex gap-3 items-start border border-primary/20 rounded-xl px-5 py-4 bg-primary/5">
                                <svg class="flex-shrink-0 mt-0.5 w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <p class="text-sm text-body leading-relaxed">{conclusion}</p>
                            </div>
                        )}
                        {ctaText && (
                            <div class="text-center">
                                <a href={ctaLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-base font-bold bg-primary text-white rounded transition-all shadow-lg">
                                    {ctaText}
                                </a>
                            </div>
                        )}
                    </div>
                )}
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════
    VARIANT: split — dos columnas grandes
    ══════════════════════════════════════ */}
{variant === "split" && (
    <section class={`py-20 ${bgClass}`}>
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
                    {title}
                </TitleTag>
                {subtitle && (
                    <p class="text-body text-lg leading-relaxed">{subtitle}</p>
                )}
            </div>

            <div class="max-w-4xl mx-auto grid sm:grid-cols-2 gap-6">
                {/* Columna izquierda */}
                <div class="rounded-2xl border border-heading/10 bg-surface overflow-hidden">
                    <div class="px-6 py-4 border-b border-heading/10 bg-heading/5">
                        <p class="font-bold text-heading text-lg">{leftTitle}</p>
                    </div>
                    <ul class="divide-y divide-heading/10">
                        {rows.map((row) => (
                            <li class="px-6 py-4">
                                <p class="text-xs font-bold uppercase tracking-wider text-body opacity-50 mb-1">{row.label}</p>
                                <p class="text-sm text-body leading-relaxed">{row.left}</p>
                            </li>
                        ))}
                    </ul>
                </div>

                {/* Columna derecha — destacada */}
                <div class="rounded-2xl border border-primary/30 bg-surface overflow-hidden shadow-lg relative">
                    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary to-accent" />
                    <div class="px-6 py-4 border-b border-primary/15 bg-primary/5">
                        <p class="font-bold text-primary text-lg">{rightTitle}</p>
                    </div>
                    <ul class="divide-y divide-heading/10">
                        {rows.map((row) => (
                            <li class="px-6 py-4">
                                <p class="text-xs font-bold uppercase tracking-wider text-primary opacity-70 mb-1">{row.label}</p>
                                <p class="text-sm text-heading font-medium leading-relaxed">{row.right}</p>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            {(conclusion || ctaText) && (
                <div class="max-w-4xl mx-auto mt-8 space-y-5">
                    {conclusion && (
                        <p class="text-body leading-relaxed border border-heading/10 rounded-xl px-6 py-4 bg-surface text-sm text-center">
                            <span class="font-semibold text-heading">Conclusión: </span>
                            {conclusion}
                        </p>
                    )}
                    {ctaText && (
                        <div class="text-center">
                            <a href={ctaLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-base font-bold bg-primary text-white rounded transition-all shadow-lg">
                                {ctaText}
                            </a>
                        </div>
                    )}
                </div>
            )}
        </div>
    </section>
)}
