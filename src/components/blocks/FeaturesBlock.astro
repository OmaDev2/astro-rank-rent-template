---
import DynamicIcon from "../ui/DynamicIcon.astro";
import { spin } from "../../utils/spintax";

interface FeatureItem {
    title: string;
    desc?: string;
    description?: string;
    icon: string;
}

interface Props {
    locationName?: string;
    city?: string;
    title?: string;
    subtitle?: string;
    items?: FeatureItem[];
    bgClass?: string;
    variant?: "grid" | "split" | "horizontal" | "icons_only";
}

const {
    locationName: rawLocationName = "",
    city: rawCity = "",
    title: rawTitle = "",
    subtitle: rawSubtitle = "",
    items = [],
    bgClass = "bg-secondary",
    variant = "grid",
} = Astro.props;

const locationName = spin(rawLocationName);
const city = spin(rawCity);

const title = rawTitle
    ? spin(rawTitle)
    : `¿Por Qué Somos Tu Mejor Opción en ${locationName}?`;
const subtitle = rawSubtitle
    ? spin(rawSubtitle)
    : `Conocemos perfectamente la zona de ${locationName} y sus necesidades específicas.`;

const defaultItems: FeatureItem[] = [
    { title: "Cobertura Local", desc: `Llegamos rápido a ${locationName}.`, icon: "MapPin" },
    { title: "Respuesta Rápida", desc: "Atendemos urgencias en menos de 4 horas.", icon: "Clock" },
    { title: "Garantía Total", desc: `Trabajos en ${locationName} con garantía por escrito.`, icon: "Shield" },
    { title: "Profesionales", desc: `Equipo certificado con más de 15 años en ${city}.`, icon: "Award" },
];

const features = items.length > 0 ? items : defaultItems;
const cardBgClass = bgClass === "bg-secondary" ? "bg-surface/50" : "bg-secondary/50";
---

{/* ══ VARIANT: grid (default) ═══════════════════════════════ */}
{(variant === "grid" || !variant) && (
    <section class={`py-20 ${bgClass} border-t border-heading/5`}>
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-heading font-bold text-heading mb-4">{title}</h2>
                <div class="w-24 h-1 bg-primary mx-auto mb-6" />
                <p class="text-body max-w-2xl mx-auto">{subtitle}</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
                {features.map((item) => (
                    <div class={`${cardBgClass} p-6 rounded-xl border border-heading/10 hover:border-primary/50 transition-all group`}>
                        <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mb-4 group-hover:bg-primary/30 transition-colors">
                            <DynamicIcon name={item.icon} className="w-7 h-7 text-primary" />
                        </div>
                        <h3 class="text-xl font-bold text-heading mb-3">{spin(item.title)}</h3>
                        <p class="text-body text-sm">{spin(item.desc || item.description || "")}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>
)}

{/* ══ VARIANT: split ════════════════════════════════════════ */}
{variant === "split" && (
    <section class={`py-20 ${bgClass} border-t border-heading/5`}>
        <div class="container mx-auto px-4">
            <div class="grid lg:grid-cols-[1fr_2fr] gap-12 lg:gap-16 items-start max-w-6xl mx-auto">
                <div class="lg:sticky lg:top-24">
                    <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading mb-6 leading-tight">{title}</h2>
                    <div class="w-16 h-1 bg-primary mb-6" />
                    <p class="text-body leading-relaxed">{subtitle}</p>
                </div>
                <div data-stagger class="grid sm:grid-cols-2 gap-5">
                    {features.map((item) => (
                        <div class={`group flex items-start gap-4 p-5 rounded-xl ${cardBgClass} border border-heading/10 hover:border-primary/40 transition-all`}>
                            <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/15 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all">
                                <DynamicIcon name={item.icon} className="w-5 h-5" />
                            </span>
                            <div>
                                <h3 class="font-bold text-heading mb-1 leading-snug">{spin(item.title)}</h3>
                                <p class="text-body text-sm leading-relaxed">{spin(item.desc || item.description || "")}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>
)}

{/* ══ VARIANT: horizontal ═══════════════════════════════════ */}
{variant === "horizontal" && (
    <section class={`py-20 ${bgClass} border-t border-heading/5`}>
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">{title}</h2>
                <div class="w-24 h-1 bg-primary mx-auto mb-4" />
                <p class="text-body">{subtitle}</p>
            </div>
            <ul data-stagger class="space-y-4">
                {features.map((item) => (
                    <li class={`group flex items-start gap-5 p-5 rounded-xl ${cardBgClass} border border-heading/10 hover:border-primary/40 transition-all`}>
                        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-primary/15 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all">
                            <DynamicIcon name={item.icon} className="w-6 h-6" />
                        </span>
                        <div>
                            <h3 class="font-bold text-heading text-lg mb-1">{spin(item.title)}</h3>
                            <p class="text-body text-sm leading-relaxed">{spin(item.desc || item.description || "")}</p>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>
)}

{/* ══ VARIANT: icons_only ══════════════════════════════════ */}
{variant === "icons_only" && (
    <section class={`py-16 ${bgClass} border-t border-heading/5`}>
        <div class="container mx-auto px-4">
            <div class="text-center mb-10">
                <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading mb-3">{title}</h2>
                <div class="w-24 h-1 bg-primary mx-auto" />
            </div>
            <ul data-stagger class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
                {features.map((item) => (
                    <li class="group flex flex-col items-center gap-3 text-center">
                        <span class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                            <DynamicIcon name={item.icon} className="w-7 h-7" />
                        </span>
                        <span class="font-bold text-heading text-sm leading-snug">{spin(item.title)}</span>
                    </li>
                ))}
            </ul>
        </div>
    </section>
)}
