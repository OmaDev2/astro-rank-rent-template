---
interface Props {
    title?: string;
    sections?: {
        heading: string;
        content: string;
    }[];
    bgClass?: string;
}

const { title, sections, bgClass = "bg-surface" } = Astro.props;
---

<section class={`py-20 ${bgClass}`}>
    <div class="container mx-auto px-4 max-w-4xl">
        {
            title && (
                <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading mb-12 text-center">
                    {title}
                </h2>
            )
        }

        <div class="space-y-16">
            {
                sections?.map((section: any) => (
                    <div class="group">
                        <h3 class="text-2xl font-heading font-bold text-heading mb-6 border-l-4 border-primary pl-4 group-hover:border-accent transition-colors">
                            {section.heading || section.title}
                        </h3>
                        <div
                            class="prose prose-lg max-w-none 
                        prose-headings:text-heading 
                        prose-p:text-body prose-p:leading-relaxed
                        prose-strong:text-primary prose-strong:font-bold
                        prose-ul:text-body prose-li:marker:text-primary
                        prose-table:text-body prose-th:text-heading prose-td:border-heading/10"
                            set:html={section.content}
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>
