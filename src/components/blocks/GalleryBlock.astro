---
interface GalleryImage {
    src: string;
    alt: string;
    caption?: string;
}

interface Props {
    title?: string;
    subtitle?: string;
    titleTag?: "h2" | "h3";
    variant?: "grid" | "masonry" | "featured";
    images: GalleryImage[];
    ctaText?: string;
    ctaLink?: string;
    bgClass?: string;
}

const {
    title,
    subtitle,
    titleTag = "h2",
    variant = "grid",
    images = [],
    ctaText,
    ctaLink = "/contacto/",
    bgClass = "bg-surface",
} = Astro.props;

if (!images || images.length === 0) return;

const TitleTag = titleTag as "h2" | "h3";
const [first, ...rest] = images;
---

{/* ══════════════════════════════════════
    VARIANT: grid — cuadrícula uniforme
    ══════════════════════════════════════ */}
{variant === "grid" && (
    <section class={`py-20 ${bgClass}`}>
        <div class="container mx-auto px-4">
            {(title || subtitle) && (
                <div class="text-center max-w-3xl mx-auto mb-12">
                    {title && (
                        <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
                            {title}
                        </TitleTag>
                    )}
                    {subtitle && (
                        <p class="text-body text-lg leading-relaxed">{subtitle}</p>
                    )}
                </div>
            )}

            <ul class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 max-w-6xl mx-auto">
                {images.map((img) => (
                    <li class="group relative aspect-square rounded-xl overflow-hidden bg-heading/5">
                        <img
                            src={img.src}
                            alt={img.alt}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        {img.caption && (
                            <div class="absolute inset-x-0 bottom-0 translate-y-full group-hover:translate-y-0 transition-transform duration-300 bg-gradient-to-t from-black/80 to-transparent px-4 pb-3 pt-8">
                                <p class="text-white text-sm font-medium leading-snug">{img.caption}</p>
                            </div>
                        )}
                    </li>
                ))}
            </ul>

            {ctaText && (
                <div class="mt-10 text-center">
                    <a href={ctaLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-base font-bold bg-primary text-white rounded transition-all shadow-lg">
                        {ctaText}
                    </a>
                </div>
            )}
        </div>
    </section>
)}

{/* ══════════════════════════════════════
    VARIANT: masonry — alturas naturales con CSS columns
    ══════════════════════════════════════ */}
{variant === "masonry" && (
    <section class={`py-20 ${bgClass}`}>
        <div class="container mx-auto px-4">
            {(title || subtitle) && (
                <div class="text-center max-w-3xl mx-auto mb-12">
                    {title && (
                        <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
                            {title}
                        </TitleTag>
                    )}
                    {subtitle && (
                        <p class="text-body text-lg leading-relaxed">{subtitle}</p>
                    )}
                </div>
            )}

            <ul class="columns-2 md:columns-3 gap-3 md:gap-4 max-w-6xl mx-auto">
                {images.map((img) => (
                    <li class="break-inside-avoid mb-3 md:mb-4 group relative rounded-xl overflow-hidden bg-heading/5">
                        <img
                            src={img.src}
                            alt={img.alt}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.03]"
                        />
                        {img.caption && (
                            <div class="px-3 py-2 bg-heading/5 border-t border-heading/10">
                                <p class="text-xs text-body leading-snug">{img.caption}</p>
                            </div>
                        )}
                    </li>
                ))}
            </ul>

            {ctaText && (
                <div class="mt-10 text-center">
                    <a href={ctaLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-base font-bold bg-primary text-white rounded transition-all shadow-lg">
                        {ctaText}
                    </a>
                </div>
            )}
        </div>
    </section>
)}

{/* ══════════════════════════════════════
    VARIANT: featured — primera imagen grande
    ══════════════════════════════════════ */}
{variant === "featured" && (
    <section class={`py-20 ${bgClass}`}>
        <div class="container mx-auto px-4">
            {(title || subtitle) && (
                <div class="text-center max-w-3xl mx-auto mb-12">
                    {title && (
                        <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
                            {title}
                        </TitleTag>
                    )}
                    {subtitle && (
                        <p class="text-body text-lg leading-relaxed">{subtitle}</p>
                    )}
                </div>
            )}

            <div class="max-w-6xl mx-auto">
                {rest.length > 0 ? (
                    <div class="grid md:grid-cols-[2fr_1fr] gap-3 md:gap-4">
                        {/* Imagen principal */}
                        <div class="group relative rounded-2xl overflow-hidden bg-heading/5 aspect-[4/3] md:aspect-auto">
                            <img
                                src={first.src}
                                alt={first.alt}
                                loading="lazy"
                                decoding="async"
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                            />
                            {first.caption && (
                                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-5 pb-4 pt-10">
                                    <p class="text-white text-sm font-medium">{first.caption}</p>
                                </div>
                            )}
                        </div>

                        {/* Imágenes secundarias */}
                        <ul class="grid grid-cols-2 md:grid-cols-1 gap-3 md:gap-4">
                            {rest.map((img) => (
                                <li class="group relative rounded-xl overflow-hidden bg-heading/5 aspect-square md:aspect-[4/3]">
                                    <img
                                        src={img.src}
                                        alt={img.alt}
                                        loading="lazy"
                                        decoding="async"
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    />
                                    {img.caption && (
                                        <div class="absolute inset-x-0 bottom-0 translate-y-full group-hover:translate-y-0 transition-transform duration-300 bg-gradient-to-t from-black/70 to-transparent px-3 pb-2.5 pt-6">
                                            <p class="text-white text-xs font-medium leading-snug">{img.caption}</p>
                                        </div>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </div>
                ) : (
                    /* Solo una imagen */
                    <div class="group relative rounded-2xl overflow-hidden bg-heading/5 max-w-3xl mx-auto aspect-[16/9]">
                        <img
                            src={first.src}
                            alt={first.alt}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        {first.caption && (
                            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-6 pb-5 pt-12">
                                <p class="text-white text-sm font-medium">{first.caption}</p>
                            </div>
                        )}
                    </div>
                )}
            </div>

            {ctaText && (
                <div class="mt-10 text-center">
                    <a href={ctaLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-base font-bold bg-primary text-white rounded transition-all shadow-lg">
                        {ctaText}
                    </a>
                </div>
            )}
        </div>
    </section>
)}
