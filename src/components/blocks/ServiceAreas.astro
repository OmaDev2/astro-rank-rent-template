---
import {
    Building2,
    Home,
    Crown,
    Sparkles,
    Building,
    Mountain,
    Castle,
    TreePine,
    MapPin,
} from "lucide-react";

interface Props {
    title: string;
    subtitle?: string;
    group1: {
        title: string;
        description: string;
        items: {
            name: string;
            description?: string;
            icon?: string;
            popular?: boolean;
        }[];
    };
    group2: {
        title: string;
        description: string;
        note?: string;
        items: {
            name: string;
            supplement?: string;
            icon?: string;
        }[];
    };
    bgClass?: string;
}

import { getSettings } from "@/lib/settings";

const { title, subtitle, group1, group2, bgClass = "bg-secondary" } = Astro.props;

// Fetch global settings to synchronize the province list with areaServed
const settings = await getSettings();
const areaServed = settings.areaServed || [];

// Dynamically generate the province items based on areaServed (excluding main city "Málaga")
if (group2 && areaServed.length > 0) {
    const dynamicItems = areaServed
        .filter((city: string) => city !== "Málaga")
        .map((city: string) => ({
            name: city,
            icon: "MapPin"
        }));
    
    // Replace the manually typed items with the dynamic ones to guarantee sync
    group2.items = dynamicItems;
}

const iconMap: Record<string, any> = {
    Building2,
    Home,
    Crown,
    Sparkles,
    Building,
    Mountain,
    Castle,
    TreePine,
    MapPin,
};
---

<section class={`py-20 ${bgClass}`}>
    <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2
                class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4"
            >
                {title}
            </h2>
            {subtitle && <p class="text-lg text-body opacity-90">{subtitle}</p>}
        </div>

        <div class="grid lg:grid-cols-2 gap-12">
            {/* GRUPO 1 */}
            {
                group1 && (
                    <div class="space-y-8">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                <Building2 className="w-6 h-6" />
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-heading">
                                    {group1.title}
                                </h3>
                                <p class="text-sm text-body opacity-80">
                                    {group1.description}
                                </p>
                            </div>
                        </div>

                        <div class="grid sm:grid-cols-2 gap-4">
                            {group1.items?.map((item) => {
                                const Icon =
                                    iconMap[item.icon || ""] || Home;
                                return (
                                    <div class="p-5 rounded-2xl bg-surface border border-heading/5 hover:border-primary/30 transition-all group relative overflow-hidden">
                                        {item.popular && (
                                            <span class="absolute top-2 right-2 px-2 py-0.5 bg-accent text-[10px] font-bold text-secondary rounded-full uppercase tracking-tighter">
                                                Popular
                                            </span>
                                        )}
                                        <div class="flex items-start gap-4">
                                            <div class="p-2 rounded-lg bg-secondary group-hover:bg-primary transition-colors text-heading group-hover:text-white mt-1">
                                                <Icon className="w-4 h-4" />
                                            </div>
                                            <div class="flex-1">
                                                <h4 class="font-bold text-heading mb-1 group-hover:text-primary transition-colors">
                                                    {item.name}
                                                </h4>
                                                {item.description && (
                                                    <p class="text-xs text-body leading-relaxed opacity-80">
                                                        {item.description}
                                                    </p>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                )
            }

            {/* GRUPO 2 */}
            {
                group2 && (
                    <div class="space-y-8">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
                                <MapPin className="w-6 h-6" />
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-heading">
                                    {group2.title}
                                </h3>
                                <p class="text-sm text-body opacity-80">
                                    {group2.description}
                                </p>
                            </div>
                        </div>

                        <div class="bg-surface/50 rounded-3xl p-6 border border-heading/5">
                            <div class="grid sm:grid-cols-2 gap-2">
                                {group2.items?.map((item) => (
                                    <div class="flex items-center justify-between p-3 rounded-xl hover:bg-surface transition-colors group">
                                        <div class="flex items-center gap-3">
                                            <MapPin className="w-4 h-4 text-primary opacity-40 group-hover:opacity-100" />
                                            <span class="text-sm font-medium text-heading">
                                                {item.name}
                                            </span>
                                        </div>
                                        <span
                                            class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${item.supplement === "Gratis" ? "bg-green-100 text-green-700 border border-green-200" : "bg-primary/10 text-primary"}`}
                                        >
                                            {item.supplement}
                                        </span>
                                    </div>
                                ))}
                            </div>
                            {group2.note && (
                                <p class="mt-4 text-[11px] text-body opacity-60 italic text-center">
                                    {group2.note}
                                </p>
                            )}
                        </div>
                    </div>
                )
            }
        </div>
    </div>
</section>
