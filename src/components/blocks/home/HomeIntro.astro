---
const { introSection, bgClass = "bg-surface" } = Astro.props;

const heading = introSection?.heading || "";
const paragraph = introSection?.paragraph || "";
---

{(heading || paragraph) && (
  <section class={`py-12 ${bgClass}`}>
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        {heading && (
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-heading mb-4 leading-snug">
            {heading}
          </h2>
        )}
        {paragraph && (
          <p class="text-body leading-relaxed text-base md:text-lg">
            {paragraph}
          </p>
        )}
      </div>
    </div>
  </section>
)}
