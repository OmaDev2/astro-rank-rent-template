---
import { Phone, MapPin } from "lucide-react";
import HeroContactForm from "../../HeroContactForm.astro";
const { config } = Astro.props;
---

<section id="presupuesto" class="py-20 bg-secondary relative overflow-hidden">
    <div
        class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"
    >
    </div>
    <div class="container mx-auto px-4 relative z-10">
        <div
            class="max-w-4xl mx-auto bg-surface rounded-2xl border border-heading/10 shadow-2xl overflow-hidden flex flex-col md:flex-row"
        >
            <div class="p-8 md:p-12 md:w-1/2 flex flex-col justify-center">
                <h2 class="text-3xl font-heading font-bold text-heading mb-4">
                    ¿Necesitas un Presupuesto?
                </h2>
                <p class="text-body mb-8">
                    Cuéntanos tu proyecto. Te respondemos con una valoración
                    gratuita y sin compromiso.
                </p>
                <div class="space-y-4">
                    <div class="flex items-center text-body">
                        <div
                            class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary mr-4"
                        >
                            <Phone className="w-5 h-5" />
                        </div>
                        <div>
                            <div class="text-xs text-body/70 uppercase">
                                Llámanos ahora
                            </div><div class="font-bold text-heading">
                                {config.phone}
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center text-body">
                        <div
                            class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary mr-4"
                        >
                            <MapPin className="w-5 h-5" />
                        </div>
                        <div>
                            <div class="text-xs text-body/70 uppercase">
                                Trabajamos en
                            </div><div class="font-bold text-heading">
                                {config.city} y alrededores
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div
                class="p-8 md:p-12 md:w-1/2 bg-surface/50 border-l border-heading/10"
            >
                <HeroContactForm
                    title="Solicitar Valoración"
                    subtitle="Rellena el formulario y te contactamos."
                />
            </div>
        </div>
    </div>
</section>
