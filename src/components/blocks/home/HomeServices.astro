---
import { ChevronRight } from "lucide-react";
import { slugify } from "@/utils/slugify";
const {
    servicesSection,
    featuredServices = [],
    customServices = null,
    allServices = [],
    bgClass = "bg-secondary",
} = Astro.props;

// Normaliza el nuevo formato objeto { slug: { enabled, isPopular, order } } al formato array que usa el render
const rawServices = servicesSection?.services;
let servicesToDisplay: any[];
if (rawServices && !Array.isArray(rawServices) && typeof rawServices === 'object') {
    servicesToDisplay = Object.entries(rawServices)
        .filter(([_, cfg]: any) => cfg?.enabled)
        .sort((a: any, b: any) => (a[1].order ?? 99) - (b[1].order ?? 99))
        .map(([slug, cfg]: any) => ({
            discriminant: 'auto',
            value: { service: slug, isPopular: cfg?.isPopular ?? false },
        }));
} else {
    servicesToDisplay = customServices || featuredServices || [];
}
---

<section id="servicios" class={`py-20 ${bgClass} border-b border-heading/10`}>
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <div class="flex items-center justify-center gap-4 mb-4">
                <div class="h-px w-12 bg-primary"></div>
                <span
                    class="text-primary font-bold uppercase tracking-widest text-sm"
                    >Nuestros Servicios</span
                >
                <div class="h-px w-12 bg-primary"></div>
            </div>
            <h2
                class="text-4xl lg:text-5xl font-heading font-bold text-heading mb-6"
            >
                {
                    servicesSection?.title ? (
                        <>
                            {servicesSection.title}
                            {servicesSection.titleHighlight && (
                                <>
                                    <br />
                                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">
                                        {servicesSection.titleHighlight}
                                    </span>
                                </>
                            )}
                        </>
                    ) : (
                        `⚠️ Configura el Título en CMS (Home > Servicios)`
                    )
                }
            </h2>
            <p class="text-body max-w-2xl mx-auto text-lg">
                {
                    servicesSection?.subtitle ||
                        "⚠️ Configura el Subtítulo en CMS (Home > Servicios)"
                }
            </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                servicesToDisplay.map((item: any) => {
                    let data, slug, link;

                    // 1. Caso Híbrido: Discriminant (Keystatic Conditional)
                    if (item.discriminant) {
                        if (item.discriminant === "manual") {
                            data = item.value;
                            slug = slugify(data.title ?? "");
                            link = data.link || `/servicios/${slug}/`;
                        } else if (item.discriminant === "auto") {
                            const serviceSlug = item.value.service;
                            const foundService = allServices.find(
                                (s: any) => s.slug === serviceSlug,
                            );

                            if (foundService) {
                                data = {
                                    ...foundService.data,
                                    title:
                                        item.value.overrideTitle ||
                                        foundService.data.title,
                                    price:
                                        item.value.overridePrice ||
                                        foundService.data.price,
                                    isPopular: item.value.isPopular || false,
                                };
                                slug = foundService.slug;
                                link = `/servicios/${slug}/`;
                            } else {
                                // Fallback si no se encuentra el servicio (aunque no debería pasar)
                                data = {
                                    title: "Servicio no encontrado",
                                    description: "Revisar configuración en CMS",
                                    icon: "AlertCircle",
                                };
                                slug = "#";
                                link = "#";
                            }
                        }
                    }
                    // 2. Caso Colección Directa (Featured Services o Fallback antiguo)
                    else if (item.data) {
                        data = item.data;
                        slug = item.slug;
                        link = `/servicios/${slug}/`;
                    }
                    // 3. Caso Manual Antiguo (si hubiera datos legacy sin discriminant)
                    else {
                        data = item;
                        slug = item.slug || slugify(item.name ?? "");
                        link = item.link || `/servicios/${slug}/`;
                    }

                    const title = data.title || data.name;
                    const description = data.shortDesc || data.description;
                    const image =
                        data.heroImage ||
                        data.image ||
                        `/images/services/${slug}-1.png`;

                    return (
                        <a
                            href={link}
                            class="group relative overflow-hidden rounded-lg border border-heading/10 hover:border-primary/50 transition-all hover:shadow-xl hover:shadow-primary/20 h-[400px]"
                        >
                            <img
                                src={image}
                                alt={title}
                                loading="lazy"
                                decoding="async"
                                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/10" />
                            {data.isPopular && (
                                <div class="absolute top-4 left-4 z-10">
                                    <span class="inline-flex items-center gap-1.5 bg-primary text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-lg">
                                        <span class="w-1.5 h-1.5 rounded-full bg-white inline-block"></span>
                                        Destacado
                                    </span>
                                </div>
                            )}
                            <div class="relative h-full flex flex-col justify-end p-8">
                                <h3 class="text-2xl font-heading font-bold text-white mb-3 drop-shadow-md">
                                    {title}
                                </h3>
                                <p class="text-white font-medium mb-6 line-clamp-2 text-sm leading-relaxed drop-shadow-md" style="text-shadow: 0 1px 3px rgba(0,0,0,0.8)">
                                    {description}
                                </p>
                                <div class="inline-flex items-center text-primary font-bold group-hover:text-accent drop-shadow-sm">
                                    Leer más{" "}
                                    <ChevronRight className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" />
                                </div>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>
