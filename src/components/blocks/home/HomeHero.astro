---
import { Image } from "astro:assets";
import defaultHeroImage from "../../../assets/images/hero-home.png";
import { Phone } from "lucide-react";
import HeroContactForm from "../../HeroContactForm.astro";

const { hero, config } = Astro.props;

const heroStyle: string = config?.heroStyle || "image";

const isDefaultImage =
    !hero?.backgroundImage ||
    hero.backgroundImage === "/images/home/hero-placeholder.jpg" ||
    hero.backgroundImage === "";

const heroBgImage = hero?.backgroundImage || "/images/home/hero-placeholder.jpg";
const TitleTag = hero?.titleTag || "h1";

const features: string[] = Array.isArray(hero?.features) ? hero.features : [];
const ctaPrimaryLink  = hero?.ctaPrimary?.link  || "#presupuesto";
const ctaPrimaryText  = hero?.ctaPrimary?.text  || config?.ctaText || "Pedir Presupuesto";
const ctaSecondaryLink = hero?.ctaSecondary?.link ||
    `https://wa.me/${config?.whatsapp || (config?.phone || "").replace(/\s/g, "")}`;
const ctaSecondaryText = hero?.ctaSecondary?.text || "WhatsApp";
const heading         = hero?.heading;
const headingHighlight = hero?.headingHighlight;
const subheading      = hero?.subheading || `${config?.niche || "Servicio"} en ${config?.city || "Tu Ciudad"}`;

const isExternal = (url: string) => url?.startsWith("http");
---

{/* ══════════════════════════════════════════════════════════
    VARIANT: image — texto sobre imagen con overlay (default)
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "image" && (
    <section class="relative h-[85vh] min-h-[600px] flex items-center bg-secondary overflow-hidden">
        <div class="absolute inset-0 w-full h-full">
            {isDefaultImage ? (
                <Image src={defaultHeroImage} alt={`${config?.niche} en ${config?.city}`}
                    class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
            ) : (
                <img src={heroBgImage} alt={`${config?.niche} en ${config?.city}`}
                    class="w-full h-full object-cover"
                    fetchpriority="high" loading="eager" decoding="sync"
                    width="1920" height="1080" />
            )}
        </div>
        <div class="absolute inset-0"
            style="background: linear-gradient(to right, rgb(var(--hero-overlay)) 0%, rgb(var(--hero-overlay) / 0.8) 45%, rgb(var(--hero-overlay) / 0.3) 70%, transparent 100%); opacity: var(--hero-opacity);">
        </div>
        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl">
                <TitleTag class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-6 leading-tight">
                    {heading ? (
                        <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                    ) : (
                        <>{(config?.niche || "Servicio").toUpperCase()}<br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">EN {(config?.city || "Tu Ciudad").toUpperCase()}</span></>
                    )}
                </TitleTag>
                <p class="text-xl text-heading/90 mb-8 font-bold border-l-4 border-primary pl-4 max-w-2xl readable-hero-text">{subheading}</p>
                {features.length > 0 && (
                    <ul class="hero-badges">
                        {features.map((f: string) => (
                            <li class="hero-badge">{f}</li>
                        ))}
                    </ul>
                )}
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href={ctaPrimaryLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                        <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                    </a>
                    <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                        rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-heading border border-heading/20 rounded hover:bg-surface transition-colors">
                        {ctaSecondaryText}
                    </a>
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: split_photo — columna texto + columna foto
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "split_photo" && (
    <section class="relative min-h-[80vh] flex items-center bg-secondary overflow-hidden">
        <div class="container mx-auto px-4 py-20 lg:py-0">
            <div class="grid lg:grid-cols-2 gap-12 items-center min-h-[80vh]">
                {/* Columna texto */}
                <div class="space-y-6 py-16 lg:py-24">
                    <TitleTag class="text-4xl lg:text-6xl font-heading font-bold text-heading leading-tight">
                        {heading ? (
                            <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                        ) : (
                            <>{config?.niche || "Servicio"}<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                        )}
                    </TitleTag>
                    <p class="text-lg text-body leading-relaxed max-w-lg">{subheading}</p>
                    {features.length > 0 && (
                        <ul class="hero-badges">
                            {features.map((f: string) => (
                                <li class="hero-badge">{f}</li>
                            ))}
                        </ul>
                    )}
                    <div class="flex flex-col sm:flex-row gap-4 pt-2">
                        <a href={ctaPrimaryLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                            <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                        </a>
                        <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                            rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                            class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-heading border border-heading/20 rounded hover:bg-surface transition-colors">
                            {ctaSecondaryText}
                        </a>
                    </div>
                </div>
                {/* Columna foto */}
                <div class="hidden lg:flex items-center justify-center h-full">
                    <div class="relative w-full h-[70vh] min-h-[500px] rounded-2xl overflow-hidden shadow-2xl">
                        {isDefaultImage ? (
                            <Image src={defaultHeroImage} alt={`${config?.niche} en ${config?.city}`}
                                class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
                        ) : (
                            <img src={heroBgImage} alt={`${config?.niche} en ${config?.city}`}
                                class="w-full h-full object-cover"
                                fetchpriority="high" loading="eager" decoding="sync"
                                width="1200" height="900" />
                        )}
                    </div>
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: split_form — columna texto + formulario + imagen fondo
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "split_form" && (
    <section class="relative min-h-[80vh] flex items-center bg-secondary overflow-hidden pt-24">
        {/* Imagen de fondo con overlay oscuro */}
        <div class="absolute inset-0 w-full h-full">
            {isDefaultImage ? (
                <Image src={defaultHeroImage} alt="" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
            ) : (
                <img src={heroBgImage} alt=""
                    class="w-full h-full object-cover"
                    fetchpriority="high" loading="eager" decoding="sync"
                    width="1920" height="1080" />
            )}
        </div>
        <div class="absolute inset-0"
            style="background: linear-gradient(to right, rgb(var(--hero-overlay)) 0%, rgb(var(--hero-overlay) / 0.9) 55%, rgb(var(--hero-overlay) / 0.75) 100%); opacity: var(--hero-opacity);">
        </div>
        <div class="container mx-auto px-4 py-8 relative z-10">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                {/* Columna texto — 7 cols */}
                <div class="lg:col-span-8 space-y-5">
                    <TitleTag class="text-4xl lg:text-6xl font-heading font-bold text-heading leading-tight">
                        {heading ? (
                            <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                        ) : (
                            <>{config?.niche || "Servicio"}<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                        )}
                    </TitleTag>
                    <p class="text-lg text-body leading-relaxed max-w-xl">{subheading}</p>
                    {features.length > 0 && (
                        <ul class="hero-badges">
                            {features.map((f: string) => (
                                <li class="hero-badge">{f}</li>
                            ))}
                        </ul>
                    )}
                    <a href={`tel:${(config?.phone || "").replace(/\s/g, "")}`}
                        class="btn-cta inline-flex items-center gap-3 px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                        <Phone className="w-5 h-5" />{config?.phone || ctaPrimaryText}
                    </a>
                </div>
                {/* Columna formulario — 5 cols */}
                <div class="lg:col-span-4">
                    <HeroContactForm variant="default" theme="dark" compact={true} />
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: split_form_clean — columna texto + formulario, fondo sólido
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "split_form_clean" && (
    <section class="relative min-h-[80vh] flex items-center bg-secondary overflow-hidden pt-24">
        <div class="container mx-auto px-4 py-8 relative z-10">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-8 space-y-5">
                    <TitleTag class="text-4xl lg:text-6xl font-heading font-bold text-heading leading-tight">
                        {heading ? (
                            <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                        ) : (
                            <>{config?.niche || "Servicio"}<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                        )}
                    </TitleTag>
                    <p class="text-lg text-body leading-relaxed max-w-xl">{subheading}</p>
                    {features.length > 0 && (
                        <ul class="hero-badges">
                            {features.map((f: string) => (
                                <li class="hero-badge">{f}</li>
                            ))}
                        </ul>
                    )}
                    <a href={`tel:${(config?.phone || "").replace(/\s/g, "")}`}
                        class="btn-cta inline-flex items-center gap-3 px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                        <Phone className="w-5 h-5" />{config?.phone || ctaPrimaryText}
                    </a>
                </div>
                <div class="lg:col-span-4">
                    <HeroContactForm variant="default" theme="dark" compact={true} />
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: centered — texto centrado sobre imagen
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "centered" && (
    <section class="relative h-[85vh] min-h-[600px] flex items-center justify-center bg-secondary overflow-hidden text-center">
        <div class="absolute inset-0 w-full h-full">
            {isDefaultImage ? (
                <Image src={defaultHeroImage} alt={`${config?.niche} en ${config?.city}`}
                    class="w-full h-full object-cover" loading="eager" />
            ) : (
                <img src={heroBgImage} alt={`${config?.niche} en ${config?.city}`}
                    class="w-full h-full object-cover" fetchpriority="high" loading="eager" />
            )}
        </div>
        <div class="absolute inset-0" style="background: rgb(var(--hero-overlay) / 0.65);"></div>
        <div class="container mx-auto px-4 relative z-10 max-w-4xl">
            <TitleTag class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-6 leading-tight">
                {heading ? (
                    <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                ) : (
                    <>{config?.niche || "Servicio"}<br />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                )}
            </TitleTag>
            <p class="text-xl text-heading/90 mb-10 max-w-2xl mx-auto readable-hero-text">{subheading}</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href={ctaPrimaryLink} class="btn-cta inline-flex items-center justify-center px-10 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                    <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                </a>
                <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                    rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                    class="inline-flex items-center justify-center px-10 py-4 text-lg font-bold text-heading border border-heading/30 rounded hover:bg-surface/30 backdrop-blur-sm transition-colors">
                    {ctaSecondaryText}
                </a>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: minimal — sin imagen, fondo sólido limpio
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "minimal" && (
    <section class="relative flex items-center bg-secondary overflow-hidden pt-32 pb-20 lg:pb-28">
        <div class="container mx-auto px-4">
            <div class="max-w-3xl">
                {/* Línea decorativa de acento */}
                <div class="w-12 h-1 bg-primary rounded mb-8"></div>
                <TitleTag class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-4 leading-tight">
                    {heading ? (
                        <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                    ) : (
                        <>{config?.niche || "Servicio"}<br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                    )}
                </TitleTag>
                <p class="text-xl text-body mb-10 max-w-2xl leading-relaxed">{subheading}</p>
                {features.length > 0 && (
                    <ul class="hero-badges">
                        {features.map((f: string) => (
                            <li class="hero-badge">{f}</li>
                        ))}
                    </ul>
                )}
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href={ctaPrimaryLink} class="btn-cta inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                        <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                    </a>
                    <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                        rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-heading border border-heading/20 rounded hover:bg-surface transition-colors">
                        {ctaSecondaryText}
                    </a>
                </div>
            </div>
        </div>
    </section>
)}

<style>
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 500;
    color: rgb(var(--color-text-main) / 0.9);
    background: rgb(var(--color-text-main) / 0.18);
    border: 1px solid rgb(var(--color-text-main) / 0.30);
    border-radius: 4px;
    padding: 6px 14px;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }
</style>
