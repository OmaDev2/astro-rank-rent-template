---
import { Phone, MessageCircle } from "lucide-react";
import HeroContactForm from "../../sections/HeroContactForm.astro";

const { hero, config } = Astro.props;

const heroStyle: string = config?.heroStyle || "image";

const isDefaultImage =
    !hero?.backgroundImage ||
    hero.backgroundImage === "/images/home/hero-placeholder.jpg" ||
    hero.backgroundImage === "";

const heroBgImage = hero?.backgroundImage || "/images/home/hero-placeholder.jpg";
const TitleTag = hero?.titleTag || "h1";

const features: string[] = Array.isArray(hero?.features) ? hero.features : [];
const ctaPrimaryLink  = hero?.ctaPrimary?.link  || "#presupuesto";
const ctaPrimaryText  = hero?.ctaPrimary?.text  || config?.ctaText || "Pedir Presupuesto";
const ctaSecondaryLink = hero?.ctaSecondary?.link ||
    `https://wa.me/${config?.whatsapp || (config?.phone || "").replace(/\s/g, "")}`;
const ctaSecondaryText = hero?.ctaSecondary?.text || "WhatsApp";
const heading         = hero?.heading;
const headingHighlight = hero?.headingHighlight;
const subheading      = hero?.subheading || `${config?.niche || "Servicio"} en ${config?.city || "Tu Ciudad"}`;

const isExternal = (url: string) => url?.startsWith("http");
const isWhatsApp = ctaSecondaryLink.includes("wa.me") || ctaSecondaryLink.includes("whatsapp");
const secondaryBtnClass = isWhatsApp ? "btn-whatsapp" : "btn-secondary";

const whatsappIconHtml = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width:1.25rem;height:1.25rem;flex-shrink:0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>`;
---

{/* ══════════════════════════════════════════════════════════
    VARIANT: image — texto sobre imagen con overlay (default)
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "image" && (
    <section class="relative h-[85vh] min-h-[600px] flex items-center bg-secondary overflow-hidden">
        <div class="absolute inset-0 w-full h-full">
            {isDefaultImage ? (
                <div class="hero-placeholder" aria-hidden="true" />
            ) : (
                <img src={heroBgImage} alt={`${config?.niche} en ${config?.city}`}
                    class="w-full h-full object-cover"
                    fetchpriority="high" loading="eager" decoding="sync"
                    width="1920" height="1080" />
            )}
        </div>
        <div class="absolute inset-0"
            style={`background: linear-gradient(to right, rgb(var(--hero-overlay)) 0%, rgb(var(--hero-overlay) / 0.8) 45%, rgb(var(--hero-overlay) / 0.3) 70%, transparent 100%); opacity: ${isDefaultImage ? '1' : 'var(--hero-opacity)'};`}>
        </div>
        <div class="anim-float-up absolute top-1/4 right-16 w-80 h-80 rounded-full bg-primary/5 blur-3xl pointer-events-none hidden lg:block" aria-hidden="true" />
        <div class="anim-float-down absolute bottom-1/4 right-1/3 w-56 h-56 rounded-full bg-accent/6 blur-3xl pointer-events-none hidden lg:block" style="animation-delay:2.5s" aria-hidden="true" />
        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl">
                <TitleTag data-hero-animate="1" class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-6 leading-tight">
                    {heading ? (
                        <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                    ) : (
                        <>{(config?.niche || "Servicio").toUpperCase()}<br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">EN {(config?.city || "Tu Ciudad").toUpperCase()}</span></>
                    )}
                </TitleTag>
                <p data-hero-animate="2" class="text-xl text-heading/90 mb-8 font-bold border-l-4 border-primary pl-4 max-w-2xl readable-hero-text">{subheading}</p>
                {features.length > 0 && (
                    <ul data-hero-animate="3" class="hero-badges">
                        {features.map((f: string) => (
                            <li class="hero-badge">{f}</li>
                        ))}
                    </ul>
                )}
                <div data-hero-animate="4" class="flex flex-col sm:flex-row gap-4">
                    <a href={ctaPrimaryLink} class="btn-cta btn-cta-pulse inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                        <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                    </a>
                    <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                        rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                        class={`${secondaryBtnClass} inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold transition-all`}>
                        {isWhatsApp ? <Fragment set:html={whatsappIconHtml} /> : <MessageCircle className="w-5 h-5 shrink-0" />}{ctaSecondaryText}
                    </a>
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: split_photo — columna texto + columna foto
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "split_photo" && (
    <section class="relative min-h-[80vh] flex items-center bg-secondary overflow-hidden">
        <div class="container mx-auto px-4 py-20 lg:py-0">
            <div class="grid lg:grid-cols-2 gap-12 items-center min-h-[80vh]">
                {/* Columna texto */}
                <div class="space-y-6 py-16 lg:py-24">
                    <TitleTag data-hero-animate="1" class="text-4xl lg:text-6xl font-heading font-bold text-heading leading-tight">
                        {heading ? (
                            <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                        ) : (
                            <>{config?.niche || "Servicio"}<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                        )}
                    </TitleTag>
                    <p data-hero-animate="2" class="text-lg text-body leading-relaxed max-w-lg">{subheading}</p>
                    {features.length > 0 && (
                        <ul data-hero-animate="3" class="hero-badges">
                            {features.map((f: string) => (
                                <li class="hero-badge">{f}</li>
                            ))}
                        </ul>
                    )}
                    <div data-hero-animate="4" class="flex flex-col sm:flex-row gap-4 pt-2">
                        <a href={ctaPrimaryLink} class="btn-cta btn-cta-pulse inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                            <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                        </a>
                        <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                            rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                            class={`${secondaryBtnClass} inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold transition-all`}>
                            {isWhatsApp ? <Fragment set:html={whatsappIconHtml} /> : <MessageCircle className="w-5 h-5 shrink-0" />}{ctaSecondaryText}
                        </a>
                    </div>
                </div>
                {/* Columna foto */}
                <div data-hero-animate="5" class="hidden lg:flex items-center justify-center h-full">
                    <div class="relative w-full h-[70vh] min-h-[500px] rounded-2xl overflow-hidden shadow-2xl">
                        {isDefaultImage ? (
                            <div class="hero-placeholder-card w-full h-full" aria-hidden="true" />
                        ) : (
                            <img src={heroBgImage} alt={`${config?.niche} en ${config?.city}`}
                                class="w-full h-full object-cover"
                                fetchpriority="high" loading="eager" decoding="sync"
                                width="1200" height="900" />
                        )}
                    </div>
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: split_form — columna texto + formulario + imagen fondo
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "split_form" && (
    <section class="relative min-h-[80vh] flex items-center bg-secondary overflow-hidden pt-24">
        {/* Imagen de fondo con overlay oscuro */}
        <div class="absolute inset-0 w-full h-full">
            {isDefaultImage ? (
                <div class="hero-placeholder" aria-hidden="true" />
            ) : (
                <img src={heroBgImage} alt=""
                    class="w-full h-full object-cover"
                    fetchpriority="high" loading="eager" decoding="sync"
                    width="1920" height="1080" />
            )}
        </div>
        <div class="absolute inset-0"
            style="background: linear-gradient(to right, rgb(var(--hero-overlay)) 0%, rgb(var(--hero-overlay) / 0.9) 55%, rgb(var(--hero-overlay) / 0.75) 100%); opacity: var(--hero-opacity);">
        </div>
        <div class="anim-float-up absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-primary/5 blur-3xl pointer-events-none" aria-hidden="true" />
        <div class="anim-float-down absolute bottom-0 right-1/3 w-72 h-72 rounded-full bg-accent/8 blur-3xl pointer-events-none" style="animation-delay:3s" aria-hidden="true" />
        <div class="container mx-auto px-4 py-8 relative z-10">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                {/* Columna texto — 7 cols */}
                <div class="lg:col-span-8 space-y-5">
                    <TitleTag data-hero-animate="1" class="text-4xl lg:text-6xl font-heading font-bold text-heading leading-tight">
                        {heading ? (
                            <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                        ) : (
                            <>{config?.niche || "Servicio"}<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                        )}
                    </TitleTag>
                    <p data-hero-animate="2" class="text-lg text-body leading-relaxed max-w-xl">{subheading}</p>
                    {features.length > 0 && (
                        <ul data-hero-animate="3" class="hero-badges">
                            {features.map((f: string) => (
                                <li class="hero-badge">{f}</li>
                            ))}
                        </ul>
                    )}
                    <div data-hero-animate="4" class="flex flex-col sm:flex-row gap-4">
                        <a href={ctaPrimaryLink}
                            class="btn-cta btn-cta-pulse inline-flex items-center justify-center gap-3 px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                            <Phone className="w-5 h-5" />{ctaPrimaryText}
                        </a>
                        <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                            rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                            class={`${secondaryBtnClass} inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold transition-all`}>
                            {isWhatsApp ? <Fragment set:html={whatsappIconHtml} /> : <MessageCircle className="w-5 h-5 shrink-0" />}{ctaSecondaryText}
                        </a>
                    </div>
                </div>
                {/* Columna formulario — 5 cols */}
                <div data-hero-animate="5" class="lg:col-span-4">
                    <HeroContactForm variant="default" theme="dark" compact={true} />
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: split_form_clean — columna texto + formulario, fondo sólido
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "split_form_clean" && (
    <section class="relative min-h-[80vh] flex items-center bg-secondary overflow-hidden pt-24">
        <div class="container mx-auto px-4 py-8 relative z-10">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-8 space-y-5">
                    <TitleTag data-hero-animate="1" class="text-4xl lg:text-6xl font-heading font-bold text-heading leading-tight">
                        {heading ? (
                            <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                        ) : (
                            <>{config?.niche || "Servicio"}<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                        )}
                    </TitleTag>
                    <p data-hero-animate="2" class="text-lg text-body leading-relaxed max-w-xl">{subheading}</p>
                    {features.length > 0 && (
                        <ul data-hero-animate="3" class="hero-badges">
                            {features.map((f: string) => (
                                <li class="hero-badge">{f}</li>
                            ))}
                        </ul>
                    )}
                    <div data-hero-animate="4" class="flex flex-col sm:flex-row gap-4">
                        <a href={ctaPrimaryLink}
                            class="btn-cta btn-cta-pulse inline-flex items-center justify-center gap-3 px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                            <Phone className="w-5 h-5" />{ctaPrimaryText}
                        </a>
                        <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                            rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                            class={`${secondaryBtnClass} inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold transition-all`}>
                            {isWhatsApp ? <Fragment set:html={whatsappIconHtml} /> : <MessageCircle className="w-5 h-5 shrink-0" />}{ctaSecondaryText}
                        </a>
                    </div>
                </div>
                <div data-hero-animate="5" class="lg:col-span-4">
                    <HeroContactForm variant="default" theme="dark" compact={true} />
                </div>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: centered — texto centrado sobre imagen
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "centered" && (
    <section class="relative h-[85vh] min-h-[600px] flex items-center justify-center bg-secondary overflow-hidden text-center">
        <div class="absolute inset-0 w-full h-full">
            {isDefaultImage ? (
                <div class="hero-placeholder" aria-hidden="true" />
            ) : (
                <img src={heroBgImage} alt={`${config?.niche} en ${config?.city}`}
                    class="w-full h-full object-cover" fetchpriority="high" loading="eager" />
            )}
        </div>
        <div class="absolute inset-0" style={`background: rgb(var(--hero-overlay) / ${isDefaultImage ? '0' : '0.65'});`}></div>
        <div class="container mx-auto px-4 relative z-10 max-w-4xl">
            <TitleTag data-hero-animate="1" class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-6 leading-tight">
                {heading ? (
                    <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                ) : (
                    <>{config?.niche || "Servicio"}<br />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                )}
            </TitleTag>
            <p data-hero-animate="2" class="text-xl text-heading/90 mb-10 max-w-2xl mx-auto readable-hero-text">{subheading}</p>
            <div data-hero-animate="4" class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href={ctaPrimaryLink} class="btn-cta btn-cta-pulse inline-flex items-center justify-center px-10 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                    <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                </a>
                <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                    rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                    class={`${secondaryBtnClass} inline-flex items-center justify-center gap-2 px-10 py-4 text-lg font-bold transition-all`}>
                    {isWhatsApp ? <Fragment set:html={whatsappIconHtml} /> : <MessageCircle className="w-5 h-5 shrink-0" />}{ctaSecondaryText}
                </a>
            </div>
        </div>
    </section>
)}

{/* ══════════════════════════════════════════════════════════
    VARIANT: minimal — sin imagen, fondo sólido limpio
    ══════════════════════════════════════════════════════════ */}
{heroStyle === "minimal" && (
    <section class="relative flex items-center bg-secondary overflow-hidden pt-32 pb-20 lg:pb-28">
        <div class="container mx-auto px-4">
            <div class="max-w-3xl">
                {/* Línea decorativa de acento */}
                <div class="w-12 h-1 bg-primary rounded mb-8"></div>
                <TitleTag data-hero-animate="1" class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-4 leading-tight">
                    {heading ? (
                        <>{heading}<br />{headingHighlight && <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{headingHighlight}</span>}</>
                    ) : (
                        <>{config?.niche || "Servicio"}<br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{config?.city || "Tu Ciudad"}</span></>
                    )}
                </TitleTag>
                <p data-hero-animate="2" class="text-xl text-body mb-10 max-w-2xl leading-relaxed">{subheading}</p>
                {features.length > 0 && (
                    <ul data-hero-animate="3" class="hero-badges">
                        {features.map((f: string) => (
                            <li class="hero-badge">{f}</li>
                        ))}
                    </ul>
                )}
                <div data-hero-animate="4" class="flex flex-col sm:flex-row gap-4">
                    <a href={ctaPrimaryLink} class="btn-cta btn-cta-pulse inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg">
                        <Phone className="w-5 h-5 mr-2" />{ctaPrimaryText}
                    </a>
                    <a href={ctaSecondaryLink} target={isExternal(ctaSecondaryLink) ? "_blank" : undefined}
                        rel={isExternal(ctaSecondaryLink) ? "noopener noreferrer" : undefined}
                        class={`${secondaryBtnClass} inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold transition-all`}>
                        {isWhatsApp ? <Fragment set:html={whatsappIconHtml} /> : <MessageCircle className="w-5 h-5 shrink-0" />}{ctaSecondaryText}
                    </a>
                </div>
            </div>
        </div>
    </section>
)}

<style>
  /* Fondo de marca cuando no hay imagen configurada */
  .hero-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg,
      rgb(var(--color-primary)) 0%,
      rgb(var(--color-accent)) 60%,
      rgb(var(--color-secondary)) 100%
    );
  }

  /* Tarjeta derecha sin imagen — gradiente + patrón sutil */
  .hero-placeholder-card {
    background:
      radial-gradient(circle at 30% 50%, rgb(var(--color-primary) / 0.3) 0%, transparent 60%),
      radial-gradient(circle at 80% 20%, rgb(var(--color-accent) / 0.2) 0%, transparent 50%),
      linear-gradient(135deg, rgb(var(--color-primary)) 0%, rgb(var(--color-accent)) 100%);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(var(--color-text-main) / 0.9);
    background: rgb(var(--color-text-main) / 0.18);
    border: 1px solid rgb(var(--color-text-main) / 0.30);
    border-radius: var(--radius-btn, 4px);
    padding: 6px 14px;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }
</style>
