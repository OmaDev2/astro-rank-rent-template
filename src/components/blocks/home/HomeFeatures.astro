---
import DynamicIcon from "../../ui/DynamicIcon.astro";

const {
    features,
    title,
    city,
    bgClass = "bg-secondary",
    titleTag = "h2",
    variant = "grid",
} = Astro.props;

if (!features || features.length === 0) return null;

const TitleTag = titleTag as "h2" | "h3";
const cardBgClass = bgClass === "bg-secondary" ? "bg-surface/50" : "bg-secondary/50";
const displayTitle = title || `¿Por qué elegirnos en ${city}?`;
---

{/* ══ VARIANT: grid (default) ═══════════════════════════════ */}
{(variant === "grid" || !variant) && (
    <section class={`py-20 ${bgClass} border-y border-heading/10`}>
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <TitleTag class="text-4xl font-heading font-bold text-heading mb-4">{displayTitle}</TitleTag>
                <div class="w-24 h-1 bg-primary mx-auto mb-4" />
            </div>
            <div data-stagger class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {features.map((feature: any) => (
                    <div class={`group relative p-8 ${cardBgClass} rounded-xl border border-heading/10 hover:border-primary/50 transition-all hover:shadow-xl hover:shadow-primary/10`}>
                        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-accent rounded-t-xl opacity-0 group-hover:opacity-100 transition-opacity" />
                        <div class="w-16 h-16 bg-gradient-to-br from-primary to-accent rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                            <DynamicIcon name={feature.icon || "CheckCircle"} className="w-8 h-8 text-white" />
                        </div>
                        <h3 class="text-2xl font-heading font-bold text-heading mb-4">{feature.title || feature.name}</h3>
                        <p class="text-body leading-relaxed">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>
)}

{/* ══ VARIANT: split ════════════════════════════════════════ */}
{variant === "split" && (
    <section class={`py-20 ${bgClass} border-y border-heading/10`}>
        <div class="container mx-auto px-4">
            <div class="grid lg:grid-cols-[1fr_2fr] gap-12 lg:gap-16 items-start max-w-6xl mx-auto">
                <div class="lg:sticky lg:top-24">
                    <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-6 leading-tight">{displayTitle}</TitleTag>
                    <div class="w-16 h-1 bg-primary" />
                </div>
                <div data-stagger class="grid sm:grid-cols-2 gap-5">
                    {features.map((feature: any) => (
                        <div class={`group flex items-start gap-4 p-5 rounded-xl ${cardBgClass} border border-heading/10 hover:border-primary/40 transition-all`}>
                            <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/15 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all">
                                <DynamicIcon name={feature.icon || "CheckCircle"} className="w-5 h-5" />
                            </span>
                            <div>
                                <h3 class="font-bold text-heading mb-1 leading-snug">{feature.title || feature.name}</h3>
                                <p class="text-body text-sm leading-relaxed">{feature.description}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>
)}

{/* ══ VARIANT: horizontal ══════════════════════════════════ */}
{variant === "horizontal" && (
    <section class={`py-20 ${bgClass} border-y border-heading/10`}>
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="text-center mb-12">
                <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">{displayTitle}</TitleTag>
                <div class="w-24 h-1 bg-primary mx-auto" />
            </div>
            <ul data-stagger class="space-y-4">
                {features.map((feature: any) => (
                    <li class={`group flex items-start gap-5 p-5 rounded-xl ${cardBgClass} border border-heading/10 hover:border-primary/40 transition-all`}>
                        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-primary/15 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all">
                            <DynamicIcon name={feature.icon || "CheckCircle"} className="w-6 h-6" />
                        </span>
                        <div>
                            <h3 class="font-bold text-heading text-lg mb-1">{feature.title || feature.name}</h3>
                            <p class="text-body text-sm leading-relaxed">{feature.description}</p>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>
)}

{/* ══ VARIANT: icons_only ══════════════════════════════════ */}
{variant === "icons_only" && (
    <section class={`py-16 ${bgClass} border-y border-heading/10`}>
        <div class="container mx-auto px-4">
            <div class="text-center mb-10">
                <TitleTag class="text-3xl md:text-4xl font-heading font-bold text-heading mb-3">{displayTitle}</TitleTag>
                <div class="w-24 h-1 bg-primary mx-auto" />
            </div>
            <ul data-stagger class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
                {features.map((feature: any) => (
                    <li class="group flex flex-col items-center gap-3 text-center">
                        <span class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                            <DynamicIcon name={feature.icon || "CheckCircle"} className="w-7 h-7" />
                        </span>
                        <span class="font-bold text-heading text-sm leading-snug">{feature.title || feature.name}</span>
                    </li>
                ))}
            </ul>
        </div>
    </section>
)}
