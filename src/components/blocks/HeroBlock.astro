---
import { Phone, MapPin, Shield, Clock, Award, Users } from "lucide-react";
import HeroContactForm from "../HeroContactForm.astro";

const { locationName, niche, zipCodes, heroImage, phone, siteName } =
    Astro.props;

const isIndustrial = Astro.props.locationType === "industrial";
const defaultHeroImage = isIndustrial
    ? "https://images.unsplash.com/photo-1531834685032-c34bf0d84c7c?q=80&w=1997&auto=format&fit=crop"
    : "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop";

const finalHeroImage = heroImage || defaultHeroImage;
const heroSubtitle = isIndustrial
    ? `Servicios de ${(niche || "servicio").toLowerCase()} para empresas y naves industriales.`
    : `Soluciones de ${(niche || "servicio").toLowerCase()} para particulares y comunidades.`;
---

<section
    class="relative min-h-[85vh] flex items-center bg-secondary overflow-hidden"
>
    <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url('${finalHeroImage}')`}
    >
    </div>
    <div
        class="absolute inset-0 bg-gradient-to-r from-secondary/95 via-secondary/85 to-secondary/60"
    >
    </div>

    <div class="container mx-auto px-4 lg:px-8 relative z-10 py-20">
        <div
            class="grid lg:grid-cols-[1fr,auto] gap-8 lg:gap-12 items-center max-w-7xl mx-auto"
        >
            <div class="max-w-2xl">
                <div class="flex flex-wrap items-center gap-3 mb-6">
                    <span
                        class="inline-flex items-center gap-2 py-2 px-4 rounded-full bg-primary/20 text-primary text-sm font-bold uppercase tracking-wider border border-primary/30"
                    >
                        <MapPin className="w-4 h-4" /> Servicio en {
                            locationName
                        }
                    </span>
                    <span
                        class="inline-flex items-center gap-2 py-2 px-4 rounded-full bg-surface/80 backdrop-blur text-heading text-xs font-bold border border-heading/20"
                    >
                        <Shield className="w-4 h-4 text-primary" /> +15 Años Experiencia
                    </span>
                </div>

                <h1
                    class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-6 leading-none"
                >
                    {(niche || "Servicio").toUpperCase()} EN <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent uppercase"
                    >
                        {locationName}
                    </span>
                </h1>

                <p
                    class="text-xl text-body mb-8 font-light border-l-4 border-primary pl-4 max-w-xl leading-relaxed"
                >
                    {heroSubtitle} Cobertura completa en {locationName}
                    {zipCodes?.length > 0 && ` (CP ${zipCodes.join(", ")})`}.
                    Presupuesto sin compromiso.
                </p>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        href={`tel:${(phone || "").replace(/\s/g, "")}`}
                        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg hover:shadow-primary/40"
                    >
                        <Phone className="w-5 h-5 mr-2" /> Llamar Ahora
                    </a>
                    <a
                        href="#formulario"
                        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-surface hover:bg-surface/80 text-heading rounded transition-all border-2 border-heading/20 hover:border-primary"
                    >
                        Pedir Presupuesto
                    </a>
                </div>
            </div>

            <div
                id="formulario"
                class="w-full lg:w-[420px] mt-8 lg:mt-0 lg:mr-8"
            >
                <HeroContactForm
                    title={`¿Buscas ${niche} en ${locationName}?`}
                    subtitle="Te respondemos hoy mismo"
                />
            </div>
        </div>
    </div>
</section>
