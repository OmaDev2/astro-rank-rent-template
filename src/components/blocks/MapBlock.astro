---
import { MapPin } from "lucide-react";
import { getSettings } from "@/lib/settings";

interface CityDot {
    name: string;
    lat: number;
    lng: number;
}

interface Props {
    coordinates?: { lat?: string; lng?: string }; // pin: coordenadas de la zona concreta
    center?: { lat?: string; lng?: string };       // centro del círculo (sobrescribe settings)
    locationName?: string;
    city?: string;
    radius?: number;    // km — sobrescribe settings.serviceRadius
    zipCodes?: string[];
    cities?: CityDot[];
}

const settings = await getSettings();

const {
    coordinates,
    center = settings.coordinates,
    locationName = "Zona de Servicio",
    city = settings.city,
    radius = settings.serviceRadius || 30,
    zipCodes,
    cities = [],
} = Astro.props;

// Pin de la localización concreta (coordenadas de la localidad, ej: Estepona)
const pinLat = parseFloat(coordinates?.lat || "0") || null;
const pinLng = parseFloat(coordinates?.lng || "0") || null;

// Centro del círculo: primero el pin de la localidad, luego la base del negocio
const rawCircleLat = parseFloat(coordinates?.lat || center?.lat || "0");
const rawCircleLng = parseFloat(coordinates?.lng || center?.lng || "0");
const circleLat = isNaN(rawCircleLat) ? 0 : rawCircleLat;
const circleLng = isNaN(rawCircleLng) ? 0 : rawCircleLng;

// Centro inicial del mapa para el fallback sin coordenadas
const rawCenterLat = parseFloat(center?.lat || "0");
const rawCenterLng = parseFloat(center?.lng || "0");
const centerLat = isNaN(rawCenterLat) ? 0 : rawCenterLat;
const centerLng = isNaN(rawCenterLng) ? 0 : rawCenterLng;

const hasCenter = circleLat !== 0 || circleLng !== 0 || centerLat !== 0 || centerLng !== 0;
// El zoom lo calculará fitBounds automáticamente, solo lo usamos como fallback
const mapZoom = 11;

const uid = `map-${Math.random().toString(36).slice(2, 9)}`;
const badgeText = city ? `Servicio disponible en ${city} y alrededores` : "Cobertura en zona de servicio";
---

<section class="w-full h-[450px] bg-secondary border-t border-heading/10 relative z-10">

    <div id={uid} class="w-full h-full"></div>

    <div class="absolute bottom-6 left-6 bg-surface/95 backdrop-blur-sm p-4 rounded-lg shadow-xl border border-heading/10 max-w-xs pointer-events-none z-[1000]">
        <p class="font-bold text-heading text-sm mb-1 flex items-center gap-2">
            <MapPin className="w-4 h-4 text-primary shrink-0" />
            Zona de servicio: {locationName}
        </p>
        <p class="text-body text-xs leading-relaxed">
            {badgeText}
        </p>
        {zipCodes && zipCodes.length > 0 && (
            <p class="text-muted text-xs mt-1">C.P.: {zipCodes.join(", ")}</p>
        )}
    </div>

    <script
        is:inline
        define:vars={{ uid, pinLat, pinLng, circleLat, circleLng, centerLat, centerLng, hasCenter, radius, mapZoom, locationName, cities }}
    >
        (function () {
            if (!document.getElementById("leaflet-css")) {
                const link = document.createElement("link");
                link.id   = "leaflet-css";
                link.rel  = "stylesheet";
                link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
                document.head.appendChild(link);
            }

            if (!document.getElementById("map-block-styles")) {
                const style = document.createElement("style");
                style.id = "map-block-styles";
                style.textContent = `
                    .mb-tiles { filter: grayscale(100%) brightness(0.55) contrast(1.1); transition: filter 0.6s ease; }
                    .mb-tiles.active { filter: grayscale(30%) brightness(0.75); }
                    .mb-city-label {
                        background: transparent !important;
                        border: none !important;
                        box-shadow: none !important;
                        color: #f0ede8 !important;
                        font-size: 11px !important;
                        font-weight: 600 !important;
                        text-shadow: 0 1px 4px rgba(0,0,0,0.95) !important;
                        white-space: nowrap !important;
                    }
                    .mb-city-label::before { display: none !important; }
                    .leaflet-popup-content-wrapper { background: #1c1c1a; color: #f0ede8; border: 1px solid rgba(240,168,36,0.3); border-radius: 8px; }
                    .leaflet-popup-tip { background: #1c1c1a; }
                    .leaflet-popup-content { color: #f0ede8; margin: 10px 14px; font-size: 13px; }
                `;
                document.head.appendChild(style);
            }

            function buildMap() {
                if (typeof L === "undefined") return;

                const container = document.getElementById(uid);
                if (!container || container._leaflet_id) return;

                // Si no hay coordenadas configuradas, mostrar mensaje en lugar de mapa vacío
                if (!hasCenter) {
                    container.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#888;font-size:14px;">Configura las coordenadas del negocio en los ajustes para mostrar el mapa.</div>';
                    return;
                }

                // Usar el centro de la localidad si existe, si no el centro del negocio
                const effectiveLat = circleLat !== 0 ? circleLat : centerLat;
                const effectiveLng = circleLng !== 0 ? circleLng : centerLng;

                const map = L.map(uid, {
                    center:             [effectiveLat, effectiveLng],
                    zoom:               mapZoom,
                    scrollWheelZoom:    false,
                    zoomControl:        true,
                    attributionControl: true,
                });

                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                    className:   "mb-tiles",
                }).addTo(map);

                container.addEventListener("mouseenter", () => {
                    document.querySelectorAll(".mb-tiles").forEach(el => el.classList.add("active"));
                });
                container.addEventListener("mouseleave", () => {
                    document.querySelectorAll(".mb-tiles").forEach(el => el.classList.remove("active"));
                });

                // Círculo de cobertura centrado en la localidad (no en la base del negocio)
                const circle = L.circle([effectiveLat, effectiveLng], {
                    radius:      radius * 1000,
                    color:       "#f0a824",
                    weight:      2,
                    opacity:     0.75,
                    fillColor:   "#f0a824",
                    fillOpacity: 0.10,
                }).addTo(map);

                // fitBounds: Leaflet ajusta el zoom automáticamente para encuadrar el círculo completo
                map.fitBounds(circle.getBounds(), { padding: [20, 20] });

                function makeIcon(highlighted) {
                    const size = highlighted ? 14 : 9;
                    return L.divIcon({
                        html: `<div style="
                            width:${size}px;height:${size}px;
                            background:${highlighted ? "#f0a824" : "#fff"};
                            border:2.5px solid ${highlighted ? "#fff" : "#f0a824"};
                            border-radius:50%;
                            box-shadow:0 2px 6px rgba(0,0,0,0.5);
                        "></div>`,
                        iconSize:   [size, size],
                        iconAnchor: [size / 2, size / 2],
                        className:  "",
                    });
                }

                // Puntos de ciudad opcionales
                cities.forEach(function(c) {
                    L.marker([c.lat, c.lng], { icon: makeIcon(false) })
                        .addTo(map)
                        .bindTooltip(c.name, {
                            permanent:  true,
                            direction:  "top",
                            offset:     [0, -8],
                            className:  "mb-city-label",
                        });
                });

                // Pin destacado para la localización concreta
                if (pinLat && pinLng) {
                    L.marker([pinLat, pinLng], { icon: makeIcon(true) })
                        .addTo(map)
                        .bindPopup(`<strong>${locationName}</strong><br><span style="color:#f0a824;font-size:11px">✓ Zona cubierta</span>`)
                        .openPopup();
                }
            }

            if (typeof L !== "undefined") {
                buildMap();
            } else {
                const script = document.createElement("script");
                script.src       = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
                script.crossOrigin = "";
                script.onload    = buildMap;
                document.head.appendChild(script);
            }
        })();
    </script>
</section>
