---
import { ArrowRight } from "lucide-react";
import type { Service } from "../../types";

interface Props {
    services?: Service[];
    locationName?: string;
    niche?: string;
    title?: string;
    subtitle?: string;
    bgClass?: string;
}

const {
    services = [],
    locationName = "",
    niche = "servicios",
    title,
    subtitle,
    bgClass = "bg-surface",
} = Astro.props;

const heading = title || `Nuestros Servicios en ${locationName}`;
const desc =
    subtitle ||
    `Todo lo que necesitas en ${locationName}. Haz clic en el servicio que necesitas para ver detalles y precios.`;
---

{
    services.length > 0 && (
        <section class={`py-20 ${bgClass}`}>
            <div class="container mx-auto px-4">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
                        {heading}
                    </h2>
                    <p class="text-lg text-body opacity-90">{desc}</p>
                </div>

                <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0">
                    {services.map((service) => (
                        <li>
                            <a
                                href={`/servicios/${service.slug}/`}
                                class="group flex flex-col gap-3 p-6 rounded-2xl bg-secondary border border-heading/5 hover:border-primary/40 hover:shadow-lg transition-all h-full"
                            >
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold uppercase tracking-widest text-primary opacity-70">
                                        {locationName}
                                    </span>
                                    <ArrowRight className="w-4 h-4 text-primary opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all" />
                                </div>
                                <h3 class="text-lg font-heading font-bold text-heading group-hover:text-primary transition-colors leading-snug">
                                    {service.data.title} en {locationName}
                                </h3>
                                {service.data.shortDesc && (
                                    <p class="text-sm text-body opacity-80 leading-relaxed flex-1 line-clamp-3">
                                        {service.data.shortDesc}
                                    </p>
                                )}
                                <span class="mt-2 inline-flex items-center gap-1 text-xs font-bold text-primary">
                                    Ver detalles
                                    <ArrowRight className="w-3 h-3" />
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )
}
