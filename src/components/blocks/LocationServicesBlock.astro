---
import { ArrowRight } from "lucide-react";
import type { Service } from "../../types";

interface Props {
    services?: Service[];
    locationName?: string;
    niche?: string;
    title?: string;
    subtitle?: string;
    bgClass?: string;
}

const {
    services = [],
    locationName = "",
    niche = "servicios",
    title,
    subtitle,
    bgClass = "bg-surface",
} = Astro.props;

const heading = title || `Servicios de ${niche} en ${locationName}`;
const desc =
    subtitle ||
    `${niche.charAt(0).toUpperCase() + niche.slice(1)} en ${locationName}. Selecciona el servicio que necesitas para ver todos los detalles y precios.`;
---

{
    services.length > 0 && (
        /* --heading-scale: 0.65 reduces h2/h3 sizes using the global CSS calc() system */
        <section class={`py-14 ${bgClass}`} style="--heading-scale: 0.65">
            <div class="container mx-auto px-4 max-w-6xl">

                <!-- Section header: left-aligned, compact -->
                <div class="mb-8 max-w-xl">
                    <p class="text-xs font-bold uppercase tracking-widest text-primary mb-2 opacity-80">
                        {locationName}
                    </p>
                    <h2 class="font-heading font-bold text-heading mb-2 leading-tight">
                        {heading}
                    </h2>
                    <p class="text-sm text-body opacity-75 leading-relaxed">{desc}</p>
                </div>

                <!-- Services grid -->
                <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 list-none p-0 m-0">
                    {services.map((service) => (
                        <li class="m-0">
                            <a
                                href={`/servicios/${service.slug}/`}
                                class="group flex flex-col gap-2 p-4 md:p-5 rounded-xl bg-secondary border border-heading/5 hover:border-primary/30 hover:bg-primary/5 transition-all duration-200 h-full no-underline"
                            >
                                <!-- Animated accent line -->
                                <div class="w-6 h-px bg-primary/50 group-hover:w-10 group-hover:bg-primary transition-all duration-300 mb-0.5" />

                                <!-- Title -->
                                <h3 class="font-heading font-bold text-heading group-hover:text-primary transition-colors leading-snug">
                                    {service.data.title}
                                    <span class="block text-primary/60 font-normal text-xs mt-0.5 group-hover:text-primary/80 transition-colors">
                                        en {locationName}
                                    </span>
                                </h3>

                                <!-- Description -->
                                {service.data.shortDesc && (
                                    <p class="text-xs text-body opacity-70 leading-relaxed flex-1 line-clamp-2">
                                        {service.data.shortDesc}
                                    </p>
                                )}

                                <!-- CTA -->
                                <span class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-primary/70 group-hover:text-primary group-hover:gap-2 transition-all duration-200">
                                    Ver {service.data.title}
                                    <ArrowRight className="w-3 h-3 shrink-0" />
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>

            </div>
        </section>
    )
}
