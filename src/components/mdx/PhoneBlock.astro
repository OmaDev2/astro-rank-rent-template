---
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
const phone = settings.phone || "";
const phoneLink = phone ? `tel:${phone.replace(/\s/g, "")}` : "#";
---

{phone && (
    <a
        href={phoneLink}
        class="font-bold text-primary hover:underline whitespace-nowrap"
    >
        {phone}
    </a>
)}
