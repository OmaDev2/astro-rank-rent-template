---
import ContentImage from './ContentImage.astro';

interface Props {
    // Legacy props (backward compat with old Keystatic schema)
    image?: string;
    borderRadius?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | 'full';
    // New props (new Keystatic schema and direct use)
    src?: string;
    alt?: string;
    caption?: string;
    objectFit?: 'cover' | 'contain' | 'fill';
    size?: 'full' | 'large' | 'medium' | 'small';
    aspectRatio?: 'auto' | '16:9' | '4:3' | '1:1' | '3:4';
    align?: 'left' | 'center' | 'right';
    // Shadow and rounded accept both boolean (new) and string (legacy)
    shadow?: boolean | 'none' | 'sm' | 'md' | 'lg' | 'xl';
    rounded?: boolean;
}

const {
    image,
    src,
    alt = '',
    caption,
    objectFit = 'cover',
    borderRadius = 'xl',
    shadow = true,
    size = 'large',
    aspectRatio = 'auto',
    align = 'center',
    rounded = true,
} = Astro.props;

const resolvedSrc = src || image || '';
const resolvedObjectFit: 'cover' | 'contain' = objectFit === 'contain' ? 'contain' : 'cover';

// shadow can be boolean (new schema) or string (legacy schema)
const resolvedShadow = typeof shadow === 'boolean' ? shadow : shadow !== 'none';

// rounded can be boolean (new schema) or derived from borderRadius (legacy)
const resolvedRounded = typeof rounded === 'boolean'
    ? rounded
    : borderRadius !== 'none';
---

<ContentImage
    src={resolvedSrc}
    alt={alt}
    caption={caption}
    size={size}
    aspectRatio={aspectRatio}
    align={align}
    objectFit={resolvedObjectFit}
    rounded={resolvedRounded}
    shadow={resolvedShadow}
/>
