---
import { Home, ChevronRight } from "lucide-react";
import { generateBreadcrumbsList } from "../lib/seo";

interface Props {
    locationName?: string;
    serviceName?: string;
    postTitle?: string;
    projectTitle?: string;
    pageName?: string;
    isLocation?: boolean;
    isService?: boolean;
    isBlog?: boolean;
    isProject?: boolean;
    overlay?: boolean;
}

const { locationName, serviceName, postTitle, projectTitle, pageName, isLocation, isService, isBlog, isProject, overlay = false } = Astro.props;

const siteUrl = Astro.site?.href?.replace(/\/$/, "") || "";

const breadcrumbItems: { name: string; item?: string }[] = [
    { name: "Inicio", item: `${siteUrl}/` },
];

if (pageName) {
    breadcrumbItems.push({ name: pageName });
} else if (isLocation) {
    breadcrumbItems.push({ name: "Zonas", item: `${siteUrl}/zonas/` });
    if (locationName) breadcrumbItems.push({ name: locationName });
} else if (isService) {
    breadcrumbItems.push({ name: "Servicios", item: `${siteUrl}/servicios/` });
    if (serviceName) breadcrumbItems.push({ name: serviceName });
} else if (isBlog) {
    breadcrumbItems.push({ name: "Blog", item: `${siteUrl}/blog/` });
    if (postTitle) breadcrumbItems.push({ name: postTitle });
} else if (isProject) {
    breadcrumbItems.push({ name: "Proyectos", item: `${siteUrl}/proyectos/` });
    if (projectTitle) breadcrumbItems.push({ name: projectTitle });
}

const breadcrumbSchema = generateBreadcrumbsList(breadcrumbItems);
---

<div class:list={[
    "w-full",
    overlay
        ? "bg-gray-900/95 border-b border-white/5"
        : "bg-surface/60 border-b border-heading/10"
]}>
    <div class="container mx-auto px-4">
        <nav
            aria-label="Ruta de navegación"
            class:list={[
                "flex items-center flex-wrap gap-1.5 text-xs font-medium py-2.5",
                overlay ? "text-white/90" : "text-body"
            ]}
        >
            <a href="/" class:list={[
                "flex items-center gap-1 transition-colors group",
                overlay ? "text-white/60 hover:text-white" : "text-body/60 hover:text-primary"
            ]}>
                <Home className="w-3.5 h-3.5 group-hover:scale-110 transition-transform" />
                <span class="hidden sm:inline">Inicio</span>
            </a>

            {pageName && (
                <>
                    <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                    <span class:list={[
                        "font-semibold truncate max-w-[160px] sm:max-w-none",
                        overlay ? "text-white" : "text-heading"
                    ]} aria-current="page">{pageName}</span>
                </>
            )}

            {isLocation && (
                <>
                    <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                    <a href="/zonas/" class:list={[
                        "transition-colors",
                        overlay ? "text-white/60 hover:text-white" : "text-body/60 hover:text-primary"
                    ]}>Zonas</a>
                    {locationName && (
                        <>
                            <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                            <span class:list={[
                                "font-semibold truncate max-w-[160px] sm:max-w-none",
                                overlay ? "text-white" : "text-heading"
                            ]} aria-current="page">{locationName}</span>
                        </>
                    )}
                </>
            )}

            {isService && (
                <>
                    <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                    <a href="/servicios/" class:list={[
                        "transition-colors",
                        overlay ? "text-white/60 hover:text-white" : "text-body/60 hover:text-primary"
                    ]}>Servicios</a>
                    {serviceName && (
                        <>
                            <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                            <span class:list={[
                                "font-semibold truncate max-w-[160px] sm:max-w-none",
                                overlay ? "text-white" : "text-heading"
                            ]} aria-current="page">{serviceName}</span>
                        </>
                    )}
                </>
            )}

            {isBlog && (
                <>
                    <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                    <a href="/blog/" class:list={[
                        "transition-colors",
                        overlay ? "text-white/60 hover:text-white" : "text-body/60 hover:text-primary"
                    ]}>Blog</a>
                    {postTitle && (
                        <>
                            <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                            <span class:list={[
                                "font-semibold truncate max-w-[160px] sm:max-w-none",
                                overlay ? "text-white" : "text-heading"
                            ]} aria-current="page">{postTitle}</span>
                        </>
                    )}
                </>
            )}

            {isProject && (
                <>
                    <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                    <a href="/proyectos/" class:list={[
                        "transition-colors",
                        overlay ? "text-white/60 hover:text-white" : "text-body/60 hover:text-primary"
                    ]}>Proyectos</a>
                    {projectTitle && (
                        <>
                            <ChevronRight className={`w-3 h-3 shrink-0 ${overlay ? 'text-white/30' : 'text-heading/20'}`} />
                            <span class:list={[
                                "font-semibold truncate max-w-[160px] sm:max-w-none",
                                overlay ? "text-white" : "text-heading"
                            ]} aria-current="page">{projectTitle}</span>
                        </>
                    )}
                </>
            )}
        </nav>
    </div>
</div>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
