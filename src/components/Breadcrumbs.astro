---
import { Home, ChevronRight } from "lucide-react";
import { generateBreadcrumbsList } from "../lib/seo";

interface Props {
    locationName?: string;
    locationType?: string;
    serviceName?: string;
    isLocation?: boolean;
    isService?: boolean;
}

const { locationName, serviceName, isLocation, isService } = Astro.props;

const siteUrl = Astro.site?.href?.replace(/\/$/, "") || "";

// Construir items del breadcrumb para JSON-LD
const breadcrumbItems: { name: string; item?: string }[] = [
    { name: "Inicio", item: `${siteUrl}/` },
];

if (isLocation) {
    breadcrumbItems.push({ name: "Zonas", item: `${siteUrl}/zonas/` });
    if (locationName) {
        breadcrumbItems.push({ name: locationName });
    }
} else if (isService) {
    breadcrumbItems.push({ name: "Servicios", item: `${siteUrl}/servicios/` });
    if (serviceName) {
        breadcrumbItems.push({ name: serviceName });
    }
}

const breadcrumbSchema = generateBreadcrumbsList(breadcrumbItems);
---

<div class="w-full bg-surface/60 border-b border-heading/10 px-6">
    <div class="container mx-auto">
        <nav
            class="inline-flex items-center gap-2 text-xs font-semibold tracking-wider text-body py-3"
        >
            <a
                href="/"
                class="hover:text-primary transition-colors flex items-center gap-1 group"
            >
                <Home className="w-3 h-3" />
                <span class="hidden sm:inline">Inicio</span>
            </a>

            {
                isLocation && (
                    <>
                        <ChevronRight className="w-3 h-3 opacity-50" />
                        <a
                            href="/zonas/"
                            class="hover:text-primary transition-colors"
                        >
                            Zonas
                        </a>
                        <ChevronRight className="w-3 h-3 opacity-50" />
                        <span class="text-heading font-bold">{locationName}</span>
                    </>
                )
            }

            {
                isService && (
                    <>
                        <ChevronRight className="w-3 h-3 opacity-50" />
                        <a
                            href="/servicios/"
                            class="hover:text-primary transition-colors"
                        >
                            Servicios
                        </a>
                        <ChevronRight className="w-3 h-3 opacity-50" />
                        <span class="text-heading font-bold">{serviceName}</span>
                    </>
                )
            }
        </nav>
    </div>
</div>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
