---
import { HelpCircle, ChevronDown } from "lucide-react";

interface FAQItem {
    question: string;
    answer: string;
    category?: string;
}

interface Props {
    title?: string;
    items: FAQItem[];
    variant?: "accordion" | "two_columns" | "compact" | "grouped";
    noSchema?: boolean;
}

const { title = "Preguntas Frecuentes", items, variant = "accordion", noSchema = false } = Astro.props;

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
};

// Para two_columns: partir en mitades
const half = Math.ceil(items.length / 2);
const col1 = items.slice(0, half);
const col2 = items.slice(half);

// Para grouped: agrupar por categoría
const groups: Record<string, FAQItem[]> = {};
for (const item of items) {
    const key = item.category || "";
    if (!groups[key]) groups[key] = [];
    groups[key].push(item);
}
const groupEntries = Object.entries(groups);
---

{!noSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

{/* ══ VARIANT: accordion (default) ═══════════════════════════ */}
{(variant === "accordion" || !variant) && (
    <div class="bg-secondary border border-heading/10 rounded-xl p-8 shadow-2xl relative overflow-hidden my-8">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none" />
        {title && (
            <div class="flex items-center gap-3 mb-8 border-b border-heading/10 pb-6 relative z-10">
                <div class="p-2 bg-primary/10 rounded-lg text-primary">
                    <HelpCircle className="w-6 h-6" />
                </div>
                <h2 class="text-2xl font-heading font-bold text-heading">{title}</h2>
            </div>
        )}
        <div class="space-y-4 relative z-10">
            {items.map((item) => (
                <details class="group bg-surface/50 rounded-lg border border-heading/5 transition-all duration-300 hover:border-primary/30 open:border-primary/50 open:shadow-lg open:shadow-primary/10">
                    <summary class="flex justify-between items-center w-full p-5 cursor-pointer list-none text-left">
                        <h3 class="font-bold text-heading group-hover:text-primary transition-colors pr-8 text-base m-0">{item.question}</h3>
                        <span class="text-body/70 group-open:text-primary transition-transform duration-300 group-open:rotate-180 shrink-0">
                            <ChevronDown className="w-5 h-5" />
                        </span>
                    </summary>
                    <div class="px-5 pb-5 pt-0 text-body text-sm leading-relaxed border-t border-transparent group-open:border-heading/5 animate-fadeIn">
                        <div class="pt-3">{item.answer}</div>
                    </div>
                </details>
            ))}
        </div>
    </div>
)}

{/* ══ VARIANT: two_columns ════════════════════════════════════ */}
{variant === "two_columns" && (
    <div class="my-8">
        {title && (
            <div class="flex items-center gap-3 mb-8">
                <div class="p-2 bg-primary/10 rounded-lg text-primary">
                    <HelpCircle className="w-5 h-5" />
                </div>
                <h2 class="text-2xl font-heading font-bold text-heading">{title}</h2>
            </div>
        )}
        <div class="grid md:grid-cols-2 gap-4">
            <div class="space-y-3">
                {col1.map((item) => (
                    <details class="group bg-secondary rounded-lg border border-heading/10 hover:border-primary/30 open:border-primary/40 transition-all">
                        <summary class="flex justify-between items-center p-4 cursor-pointer list-none text-left gap-3">
                            <h3 class="font-semibold text-heading text-sm leading-snug m-0 group-hover:text-primary transition-colors">{item.question}</h3>
                            <span class="shrink-0 text-body/50 group-open:text-primary group-open:rotate-180 transition-all duration-300">
                                <ChevronDown className="w-4 h-4" />
                            </span>
                        </summary>
                        <div class="px-4 pb-4 pt-0 text-body text-sm leading-relaxed border-t border-heading/5">
                            <div class="pt-3">{item.answer}</div>
                        </div>
                    </details>
                ))}
            </div>
            <div class="space-y-3">
                {col2.map((item) => (
                    <details class="group bg-secondary rounded-lg border border-heading/10 hover:border-primary/30 open:border-primary/40 transition-all">
                        <summary class="flex justify-between items-center p-4 cursor-pointer list-none text-left gap-3">
                            <h3 class="font-semibold text-heading text-sm leading-snug m-0 group-hover:text-primary transition-colors">{item.question}</h3>
                            <span class="shrink-0 text-body/50 group-open:text-primary group-open:rotate-180 transition-all duration-300">
                                <ChevronDown className="w-4 h-4" />
                            </span>
                        </summary>
                        <div class="px-4 pb-4 pt-0 text-body text-sm leading-relaxed border-t border-heading/5">
                            <div class="pt-3">{item.answer}</div>
                        </div>
                    </details>
                ))}
            </div>
        </div>
    </div>
)}

{/* ══ VARIANT: compact ════════════════════════════════════════ */}
{variant === "compact" && (
    <div class="my-6 space-y-2">
        {title && (
            <h2 class="text-xl font-heading font-bold text-heading mb-5">{title}</h2>
        )}
        {items.map((item) => (
            <details class="group rounded-lg border border-heading/10 hover:border-primary/30 open:border-primary/40 transition-all">
                <summary class="flex justify-between items-center p-4 cursor-pointer list-none text-left gap-3">
                    <span class="font-semibold text-heading text-sm leading-snug group-hover:text-primary transition-colors">{item.question}</span>
                    <span class="shrink-0 text-body/40 group-open:text-primary group-open:rotate-180 transition-all duration-300">
                        <ChevronDown className="w-4 h-4" />
                    </span>
                </summary>
                <div class="px-4 pb-4 pt-0 text-body text-sm leading-relaxed border-t border-heading/5">
                    <div class="pt-3">{item.answer}</div>
                </div>
            </details>
        ))}
    </div>
)}

{/* ══ VARIANT: grouped ════════════════════════════════════════ */}
{variant === "grouped" && (
    <div class="my-8 space-y-8">
        {title && (
            <div class="flex items-center gap-3 mb-2">
                <div class="p-2 bg-primary/10 rounded-lg text-primary">
                    <HelpCircle className="w-5 h-5" />
                </div>
                <h2 class="text-2xl font-heading font-bold text-heading">{title}</h2>
            </div>
        )}
        {groupEntries.map(([category, groupItems]) => (
            <div>
                {category && (
                    <p class="text-xs font-bold uppercase tracking-widest text-primary mb-3 pl-1">{category}</p>
                )}
                <div class="space-y-3">
                    {groupItems.map((item) => (
                        <details class="group bg-secondary rounded-lg border border-heading/10 hover:border-primary/30 open:border-primary/50 open:shadow-md transition-all">
                            <summary class="flex justify-between items-center p-5 cursor-pointer list-none text-left gap-3">
                                <h3 class="font-semibold text-heading text-sm leading-snug m-0 group-hover:text-primary transition-colors">{item.question}</h3>
                                <span class="shrink-0 text-body/50 group-open:text-primary group-open:rotate-180 transition-all duration-300">
                                    <ChevronDown className="w-4 h-4" />
                                </span>
                            </summary>
                            <div class="px-5 pb-5 pt-0 text-body text-sm leading-relaxed border-t border-heading/5">
                                <div class="pt-3">{item.answer}</div>
                            </div>
                        </details>
                    ))}
                </div>
            </div>
        ))}
    </div>
)}

<style>
    details[open] summary ~ * {
        animation: sweep 0.3s ease-in-out;
    }
    @keyframes sweep {
        0% { opacity: 0; transform: translateY(-8px); }
        100% { opacity: 1; transform: translateY(0); }
    }
</style>
