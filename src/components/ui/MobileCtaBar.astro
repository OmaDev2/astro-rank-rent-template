---
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
const phone = settings.phone || "";
const whatsapp = settings.whatsapp || settings.phone || "";

const phoneClean = phone.replace(/\s/g, "");
const whatsappClean = whatsapp.replace(/\s/g, "");

const phoneUrl = phoneClean ? `tel:${phoneClean}` : null;
const whatsappUrl = whatsappClean
    ? `https://wa.me/${whatsappClean}?text=Hola,%20necesito%20información`
    : null;

if (!phoneUrl && !whatsappUrl) return;
---

<div class="mobile-cta-bar md:hidden" id="mobile-cta-bar">
    {phoneUrl && (
        <a href={phoneUrl} class="mobile-cta-btn mobile-cta-phone" aria-label={`Llamar al ${phone}`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span class="mobile-cta-label">
                <span class="mobile-cta-action">Llamar</span>
                {phone && <span class="mobile-cta-number">{phone}</span>}
            </span>
        </a>
    )}

    {whatsappUrl && (
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn mobile-cta-whatsapp" aria-label="Contactar por WhatsApp">
            <svg class="mobile-cta-icon" fill="currentColor" viewBox="0 0 24 24" width="20" height="20">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span class="mobile-cta-label">
                <span class="mobile-cta-action">WhatsApp</span>
                <span class="mobile-cta-number">Escríbenos</span>
            </span>
        </a>
    )}
</div>

<!-- Espaciador para que el contenido no quede bajo la barra -->
<div class="mobile-cta-spacer md:hidden"></div>

<style>
    .mobile-cta-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 999;
        display: flex;
        height: 60px;
        box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.15);
    }

    .mobile-cta-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: filter 0.15s ease, transform 0.1s ease;
        -webkit-tap-highlight-color: transparent;
        padding: 0 12px;
    }

    .mobile-cta-btn:active {
        filter: brightness(0.9);
        transform: scale(0.98);
    }

    .mobile-cta-phone {
        background: rgb(var(--color-primary));
        color: white;
        border-right: 1px solid rgba(255,255,255,0.2);
    }

    .mobile-cta-whatsapp {
        background: #25D366;
        color: white;
    }

    .mobile-cta-label {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .mobile-cta-action {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.01em;
    }

    .mobile-cta-number {
        font-size: 0.72rem;
        opacity: 0.85;
        font-weight: 400;
    }

    /* Spacer para que el footer no quede tapado */
    .mobile-cta-spacer {
        height: 60px;
    }

    /* Safe area en iPhone con home indicator */
    @supports (padding-bottom: env(safe-area-inset-bottom)) {
        .mobile-cta-bar {
            padding-bottom: env(safe-area-inset-bottom);
            height: calc(60px + env(safe-area-inset-bottom));
        }
        .mobile-cta-spacer {
            height: calc(60px + env(safe-area-inset-bottom));
        }
    }
</style>
