---
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
const siteName = settings.siteName || "nosotros";
---

<!-- Modal Overlay -->
<div
  id="callback-modal"
  class="fixed inset-0 z-[9999] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="callback-modal-title"
>
  <!-- Backdrop -->
  <div
    id="callback-backdrop"
    class="absolute inset-0 bg-black/70 backdrop-blur-sm"
  ></div>

  <!-- Modal Card -->
  <div
    id="callback-card"
    class="relative w-full max-w-md bg-[rgb(var(--color-surface))] border border-white/10 rounded-2xl shadow-2xl transform scale-95 transition-transform duration-300"
  >
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-white/10">
      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-xl bg-[rgb(var(--color-primary))] flex items-center justify-center shrink-0"
        >
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
        </div>
        <div>
          <p id="callback-modal-title" class="text-lg font-bold text-[rgb(var(--color-text-heading))] leading-tight">
            Te Llamamos Nosotros
          </p>
          <p class="text-xs text-[rgb(var(--color-text-body))]/70">Sin coste · Sin compromiso</p>
        </div>
      </div>
      <button
        id="callback-close"
        class="text-[rgb(var(--color-text-body))]/50 hover:text-[rgb(var(--color-text-heading))] transition-colors p-1 rounded-lg hover:bg-white/10"
        aria-label="Cerrar"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Body: Form -->
    <div id="callback-form-wrapper" class="p-6">
      <p class="text-[rgb(var(--color-text-body))]/70 text-sm mb-5">
        Déjanos tu nombre y teléfono, te contactaremos lo antes posible.
      </p>

      <form
        id="callback-form"
        class="space-y-4"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field-cb"
        name="callback-request"
        action="/gracias/"
      >
        <input type="hidden" name="form-name" value="callback-request" />
        <p class="hidden"><label>No rellenar: <input name="bot-field-cb" /></label></p>

        <div>
          <label for="cb-name" class="block text-sm font-medium text-[rgb(var(--color-text-heading))] mb-2">
            Tu nombre *
          </label>
          <input
            type="text"
            id="cb-name"
            name="name"
            required
            placeholder="¿Cómo te llamamos?"
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg focus:ring-2 focus:ring-[rgb(var(--color-primary))] focus:border-[rgb(var(--color-primary))] transition-all text-[rgb(var(--color-text-heading))] placeholder-[rgb(var(--color-text-body))]/40 text-sm"
          />
        </div>

        <div>
          <label for="cb-phone" class="block text-sm font-medium text-[rgb(var(--color-text-heading))] mb-2">
            Tu teléfono *
          </label>
          <input
            type="tel"
            id="cb-phone"
            name="phone"
            required
            placeholder="600 000 000"
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg focus:ring-2 focus:ring-[rgb(var(--color-primary))] focus:border-[rgb(var(--color-primary))] transition-all text-[rgb(var(--color-text-heading))] placeholder-[rgb(var(--color-text-body))]/40 text-sm"
          />
        </div>

        <div>
          <label for="cb-time" class="block text-sm font-medium text-[rgb(var(--color-text-heading))] mb-2">
            Horario preferido
          </label>
          <select
            id="cb-time"
            name="preferred_time"
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg focus:ring-2 focus:ring-[rgb(var(--color-primary))] focus:border-[rgb(var(--color-primary))] transition-all text-[rgb(var(--color-text-heading))] text-sm"
          >
            <option value="cualquiera">Cualquier hora</option>
            <option value="manana">Mañana (9:00 - 13:00)</option>
            <option value="tarde">Tarde (13:00 - 18:00)</option>
            <option value="pronto">Lo antes posible</option>
          </select>
        </div>

        <div>
          <label for="cb-message" class="block text-sm font-medium text-[rgb(var(--color-text-heading))] mb-2">
            Breve mensaje (opcional)
          </label>
          <textarea
            id="cb-message"
            name="message"
            rows="2"
            placeholder="¿En qué podemos ayudarte?"
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg focus:ring-2 focus:ring-[rgb(var(--color-primary))] focus:border-[rgb(var(--color-primary))] transition-all text-[rgb(var(--color-text-heading))] placeholder-[rgb(var(--color-text-body))]/40 text-sm resize-none"
          ></textarea>
        </div>

        <div class="flex items-start gap-3 pt-1">
          <input
            type="checkbox"
            id="cb-privacy"
            name="privacy"
            required
            class="mt-0.5 w-4 h-4 rounded border-white/20 bg-white/5 text-[rgb(var(--color-primary))] shrink-0"
          />
          <label for="cb-privacy" class="text-xs text-[rgb(var(--color-text-body))]/70 leading-relaxed">
            Acepto la <a href="/privacidad/" target="_blank" rel="noopener noreferrer" class="text-[rgb(var(--color-primary))] underline hover:opacity-80">
              Política de Privacidad
            </a> y consiento el tratamiento de mis datos para recibir la llamada solicitada.
          </label>
        </div>

        <button
          type="submit"
          id="cb-submit"
          class="w-full bg-[rgb(var(--color-primary))] hover:opacity-90 text-white font-bold py-4 rounded-lg transition-all shadow-lg flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          Solicitar Llamada
        </button>
      </form>
    </div>

    <!-- Success State -->
    <div id="callback-success" class="hidden p-6 text-center">
      <div class="w-20 h-20 rounded-full bg-green-500/20 border-2 border-green-500 flex items-center justify-center mx-auto mb-5">
        <svg class="w-10 h-10 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <p class="text-2xl font-bold text-[rgb(var(--color-text-heading))] mb-2">¡Solicitud Recibida!</p>
      <p class="text-[rgb(var(--color-text-body))]/70 text-sm mb-6">
        Hemos anotado tu solicitud. Te llamaremos lo antes posible en el horario que indicaste.
      </p>
      <button
        id="callback-success-close"
        class="px-6 py-3 bg-white/10 hover:bg-white/20 text-[rgb(var(--color-text-heading))] rounded-lg font-medium transition-colors text-sm"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById("callback-modal");
    const card = document.getElementById("callback-card");
    const backdrop = document.getElementById("callback-backdrop");
    const closeBtn = document.getElementById("callback-close");
    const form = document.getElementById("callback-form") as HTMLFormElement | null;
    const privacyCheckbox = document.getElementById("cb-privacy") as HTMLInputElement | null;
    const submitBtn = document.getElementById("cb-submit") as HTMLButtonElement | null;
    const formWrapper = document.getElementById("callback-form-wrapper");
    const successDiv = document.getElementById("callback-success");
    const successCloseBtn = document.getElementById("callback-success-close");

    function openModal() {
      if (!modal || !card) return;
      modal.classList.remove("opacity-0", "pointer-events-none");
      requestAnimationFrame(() => {
        card.classList.remove("scale-95");
        card.classList.add("scale-100");
      });
      document.body.classList.add("overflow-hidden");
    }

    function closeModal() {
      if (!modal || !card) return;
      card.classList.remove("scale-100");
      card.classList.add("scale-95");
      modal.classList.add("opacity-0");
      setTimeout(() => {
        modal.classList.add("pointer-events-none");
        document.body.classList.remove("overflow-hidden");
        form?.reset();
        formWrapper?.classList.remove("hidden");
        successDiv?.classList.add("hidden");
      }, 300);
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("[data-callback-trigger]")) openModal();
    });

    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);
    successCloseBtn?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form || !formWrapper || !successDiv) return;

      const formData = new FormData(form);

      try {
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData as any).toString(),
        });

        if (response.ok) {
          formWrapper.classList.add("hidden");
          successDiv.classList.remove("hidden");
        } else {
          form.submit();
        }
      } catch {
        form.submit();
      }
    });
  })();
</script>
