---
/**
 * RelatedServices.astro
 * Muestra todos los servicios disponibles al final de una página de ZONA.
 * Genera interlinking horizontal automático: Zona → Todos los Servicios.
 * Los datos vienen del layout padre (ya tiene getCollection resuelto).
 */
import {
    Wrench, ArrowRight, Droplets, Flame, Zap, Star, Home, Building2, MapPin,
    Clock, Shield, CheckCircle, Phone, Settings, Hammer, Scissors, Wind,
    Paintbrush, Bolt, Truck, Package, Layers, Leaf, Sun, Snowflake, Lock,
    Wifi, Camera, AlertTriangle, Thermometer,
} from "lucide-react";

const iconMap: Record<string, any> = {
    Wrench, Droplets, Flame, Zap, Star, Home, Building2, MapPin, Clock,
    Shield, CheckCircle, Phone, Settings, Hammer, Scissors, Wind,
    Paintbrush, Bolt, Truck, Package, Layers, Leaf, Sun, Snowflake, Lock,
    Wifi, Camera, AlertTriangle, Thermometer,
};

interface Service {
    slug: string;
    data: {
        title: string;
        shortDesc: string;
        icon: string;
        featured?: boolean;
    };
}

interface Props {
    services: Service[];
    locationName: string;
    niche: string;
    currentServiceSlug?: string;
}

const { services, locationName, niche, currentServiceSlug } = Astro.props;

if (!services || services.length === 0) return;

const PRIORITY: string[] = [
    'ventanas-de-aluminio-malaga',
    'cerramientos-de-aluminio-malaga',
    'puertas-de-aluminio-malaga',
    'mosquiteras-de-aluminio-a-medida-malaga',
    'persianas-de-aluminio-malaga',
    'cortinas-cristal-malaga',
    'mamparas-de-bano-malaga',
    'automatismos-de-puertas-y-garajes-malaga',
];

const sorted = [...services]
    .filter(s => s.slug !== currentServiceSlug)
    .sort((a, b) => {
        const ia = PRIORITY.indexOf(a.slug);
        const ib = PRIORITY.indexOf(b.slug);
        if (ia !== -1 && ib !== -1) return ia - ib;
        if (ia !== -1) return -1;
        if (ib !== -1) return 1;
        return a.data.title.localeCompare(b.data.title, 'es');
    })
    .slice(0, 6);

---

<section class="py-16 bg-secondary border-t border-heading/5">
    <div class="container mx-auto px-4">

        <div class="text-center mb-10">
            <div class="inline-flex items-center gap-2 text-primary text-sm font-bold uppercase tracking-widest mb-3">
                <Wrench className="w-4 h-4" />
                <span>Servicios disponibles</span>
            </div>
            <h2 class="text-2xl md:text-3xl font-heading font-bold text-heading">
                {niche ? `${niche} en ${locationName}` : `Servicios disponibles en ${locationName}`}
            </h2>
            <p class="text-body mt-2 max-w-xl mx-auto text-sm">
                Instalamos {niche ? niche.toLowerCase() : "nuestros servicios"} a medida en {locationName} y alrededores.
                Presupuesto gratuito y sin compromiso.
            </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {sorted.map((service) => (
                <a
                    href={`/servicios/${service.slug}/`}
                    class="group relative flex items-start gap-4 p-5 rounded-2xl bg-surface border border-heading/5
                           hover:border-primary/30 hover:shadow-lg transition-all duration-300"
                >
                    {service.data.featured && (
                        <span class="absolute top-3 right-3 text-[9px] font-bold uppercase tracking-wider
                                     px-2 py-0.5 bg-primary text-white rounded-full">
                            Destacado
                        </span>
                    )}
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center
                                shrink-0 group-hover:bg-primary/20 transition-colors text-primary">
                        {(() => {
                            const Icon = iconMap[service.data.icon];
                            return Icon
                                ? <Icon className="w-5 h-5" />
                                : <Wrench className="w-5 h-5" />;
                        })()}
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="font-bold text-heading group-hover:text-primary transition-colors text-sm mb-1">
                            {service.data.title}
                        </div>
                        <p class="text-xs text-body leading-relaxed line-clamp-2 opacity-80">
                            {service.data.shortDesc}
                        </p>
                    </div>
                    <ArrowRight className="w-4 h-4 text-heading/20 group-hover:text-primary transition-colors shrink-0 mt-1" />
                </a>
            ))}
        </div>

        <div class="text-center mt-8">
            <a href="/servicios/" class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-accent transition-colors">
                Ver todos los servicios →
            </a>
        </div>
    </div>
</section>
