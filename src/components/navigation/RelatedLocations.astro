---
/**
 * RelatedLocations.astro
 * Muestra todas las zonas de servicio al final de una página de SERVICIO.
 * Genera interlinking horizontal automático: Servicio → Todas las Zonas.
 * Los datos vienen del layout padre (ya tiene getCollection resuelto).
 */
import { MapPin, ArrowRight } from "lucide-react";
import { getSettings } from "@/lib/settings";

interface Location {
    slug: string;
    data: {
        name: string;
        type: "residencial" | "industrial" | "centro";
    };
}

interface Props {
    locations: Location[];
    serviceTitle: string;
}

const { locations, serviceTitle } = Astro.props;

if (!locations || locations.length === 0) return;

const settings = await getSettings();
const areaServed = settings.areaServed as string[];

const _escapeRE = (v: string) => v.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const serviceType = serviceTitle
    .replace(new RegExp(`\\s+en\\s+${_escapeRE(settings.city)}\\b.*$`, 'gi'), '')
    .trim();
// Orden configurable desde global.yaml → locationPriority; fallback: orden alfabético
const PRIORITY: string[] = settings.locationPriority?.length ? settings.locationPriority : [];

const normalizeAreaName = (value: string) =>
    value.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").trim();

const linkedLocationNames = new Set(locations.map((loc) => normalizeAreaName(loc.data.name)));
const unlinkedCoverageAreas = areaServed.filter(
    (area) => !linkedLocationNames.has(normalizeAreaName(area))
);

// Slugs en PRIORITY primero; slugs no listados van al final por orden alfabético; límite 6
const sorted = [...locations]
    .sort((a, b) => {
        const ia = PRIORITY.indexOf(a.slug);
        const ib = PRIORITY.indexOf(b.slug);
        if (ia !== -1 && ib !== -1) return ia - ib;
        if (ia !== -1) return -1;
        if (ib !== -1) return 1;
        return a.data.name.localeCompare(b.data.name, 'es');
    })
    .slice(0, 6);

const typeLabel: Record<string, string> = {
    residencial: "Residencial",
    industrial:  "Industrial",
    centro:      "Centro",
};
const typeBadge: Record<string, string> = {
    residencial: "bg-surface border border-heading/10 text-body/60",
    industrial:  "bg-surface border border-heading/10 text-body/60",
    centro:      "bg-primary/10 text-primary border border-primary/20",
};
---

<section class="py-16 bg-surface/50 border-t border-heading/5">
    <div class="container mx-auto px-4">

        <div class="text-center mb-10">
            <div class="inline-flex items-center gap-2 text-primary text-sm font-bold uppercase tracking-widest mb-3">
                <MapPin className="w-4 h-4" />
                <span>Cobertura Total</span>
            </div>
            <h2 class="text-2xl md:text-3xl font-heading font-bold text-heading">
                {serviceType ? `Zonas donde realizamos ${serviceType.toLowerCase()}` : "Zonas donde trabajamos"}
            </h2>
            <p class="text-body mt-2 max-w-xl mx-auto text-sm">
                Prestamos servicio en toda el área metropolitana.
                Solicita presupuesto sin compromiso.
            </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
            {sorted.map((loc) => (
                <a
                    href={`/zona/${loc.slug}/`}
                    class="group flex items-center gap-2 p-3 rounded-xl bg-secondary border border-heading/5
                           hover:border-primary/40 hover:bg-primary/5 transition-all duration-200"
                >
                    <MapPin className="w-3.5 h-3.5 text-primary/60 group-hover:text-primary shrink-0 transition-colors" />
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-semibold text-heading group-hover:text-primary transition-colors truncate">
                            {loc.data.name}
                        </div>
                        <div class={`text-[9px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded-full mt-0.5 inline-block ${typeBadge[loc.data.type]}`}>
                            {typeLabel[loc.data.type]}
                        </div>
                    </div>
                    <ArrowRight className="w-3 h-3 text-heading/20 group-hover:text-primary transition-colors shrink-0" />
                </a>
            ))}
        </div>

        {unlinkedCoverageAreas.length > 0 && (
            <div class="mt-8 pt-6 border-t border-heading/5 text-center">
                <p class="text-xs text-body/50 mb-3 uppercase tracking-wider font-bold">
                    También cubrimos
                </p>
                <div class="flex flex-wrap justify-center gap-2">
                    {unlinkedCoverageAreas.map((area) => (
                        <span class="text-xs text-body/60 px-3 py-1 rounded-full bg-secondary border border-heading/10">
                            {area}
                        </span>
                    ))}
                </div>
            </div>
        )}

        <div class="text-center mt-8">
            <a href="/zonas/" class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-accent transition-colors">
                Ver mapa completo de cobertura →
            </a>
        </div>
    </div>
</section>
