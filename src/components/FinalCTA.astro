---
import { Phone } from "lucide-react";
import { getPhoneUrl } from "../config/business";
---

<section class="bg-amber-600 text-white py-12">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-4xl font-heading font-bold mb-4">
            ¿Tienes un proyecto metálico en mente?
        </h2>
        <p class="text-lg mb-6">
            No te quedes con dudas. Nuestros técnicos te asesoran gratis y te
            dan precio cerrado.
        </p>
        <a
            href={getPhoneUrl()}
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-white text-amber-600 rounded transition-colors hover:bg-gray-100"
        >
            <Phone className="w-5 h-5 mr-2" />
            HABLAR CON UN HERRERO AHORA
        </a>
    </div>
</section>
