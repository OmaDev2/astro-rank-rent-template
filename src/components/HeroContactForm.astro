---
import { businessConfig } from "../config/business";

interface Props {
    title?: string;
    subtitle?: string;
    variant?: "default" | "clean";
    theme?: "dark" | "light";
}

const {
    title = "Solicita Presupuesto Gratis",
    subtitle = businessConfig.messages.contactForm,
    variant = "default",
    theme = "dark",
} = Astro.props;

const containerClasses =
    variant === "default"
        ? "bg-slate-900/80 backdrop-blur-md rounded-xl shadow-2xl p-8 border border-slate-700/50"
        : "";

const inputClasses =
    theme === "dark"
        ? "w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg focus:ring-2 focus:ring-amber-600 focus:border-amber-600 transition-all text-white placeholder-slate-500"
        : "w-full px-4 py-3 bg-white border border-slate-200 rounded-lg focus:ring-2 focus:ring-amber-600 focus:border-amber-600 transition-all text-slate-900 placeholder-slate-400";

const labelClasses =
    theme === "dark"
        ? "block text-sm font-medium text-slate-300 mb-2"
        : "block text-sm font-medium text-slate-700 mb-2";
---

<div class={containerClasses}>
    {
        title && (
            <div class="mb-6">
                <h3
                    class={`text-2xl font-heading font-bold mb-2 ${theme === "dark" ? "text-white" : "text-slate-900"}`}
                >
                    {title}
                </h3>
                <p
                    class={`text-sm ${theme === "dark" ? "text-slate-400" : "text-slate-500"}`}
                >
                    {subtitle}
                </p>
            </div>
        )
    }

    <form
        class="space-y-4"
        method="POST"
        data-netlify="true"
        name="contact"
        action="/gracias"
    >
        <div>
            <label for="name" class={labelClasses}> Nombre * </label>
            <input
                type="text"
                id="name"
                name="name"
                required
                class={inputClasses}
                placeholder="Tu nombre"
            />
        </div>

        <div>
            <label for="phone" class={labelClasses}> Teléfono * </label>
            <input
                type="tel"
                id="phone"
                name="phone"
                required
                class={inputClasses}
                placeholder={businessConfig.contact.phone}
            />
        </div>

        <div>
            <label for="email" class={labelClasses}> Email </label>
            <input
                type="email"
                id="email"
                name="email"
                class={inputClasses}
                placeholder={businessConfig.contact.email}
            />
        </div>

        <div>
            <label for="message" class={labelClasses}> Mensaje </label>
            <textarea
                id="message"
                name="message"
                rows="3"
                class={`${inputClasses} resize-none`}
                placeholder="Cuéntanos qué necesitas..."></textarea>
        </div>

        <div class="flex items-start gap-3">
            <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="mt-1 w-4 h-4 rounded border-slate-700 bg-slate-800 text-amber-600 focus:ring-amber-600 focus:ring-offset-slate-900"
            />
            <label
                for="privacy"
                class={`text-xs ${theme === "dark" ? "text-slate-400" : "text-slate-600"}`}
            >
                He leído y acepto la <a
                    href="/privacidad"
                    target="_blank"
                    class="text-amber-500 hover:text-amber-400 underline"
                    >Política de Privacidad</a
                > y consiento que mis datos sean compartidos con profesionales del
                sector para recibir presupuestos. *
            </label>
        </div>

        <button
            type="submit"
            id="submit-button"
            disabled
            class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-4 px-6 rounded-lg transition-all shadow-lg hover:shadow-amber-900/50 transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:transform-none"
        >
            Enviar Solicitud
        </button>

        <p
            class={`text-xs text-center ${theme === "dark" ? "text-slate-500" : "text-slate-600"}`}
        >
            No enviamos spam. Tus datos están seguros.
        </p>
    </form>
</div>

<script>
    // Enable/disable submit button based on privacy checkbox
    document.addEventListener("DOMContentLoaded", () => {
        const privacyCheckbox = document.getElementById(
            "privacy",
        ) as HTMLInputElement;
        const submitButton = document.getElementById(
            "submit-button",
        ) as HTMLButtonElement;

        if (privacyCheckbox && submitButton) {
            privacyCheckbox.addEventListener("change", () => {
                submitButton.disabled = !privacyCheckbox.checked;
            });
        }
    });
</script>
