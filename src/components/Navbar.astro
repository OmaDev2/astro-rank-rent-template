---
import { Menu, X, Phone, ChevronDown } from "lucide-react";
import { getCollection, getEntry } from "astro:content";

// 1. Recuperamos los datos del CMS
const services = await getCollection("services");
const locations = await getCollection("locations");
const settings = await getEntry("settings", "global");

// 2. Extraemos las variables para usar en el HTML
const { siteName, phone, ctaText, logo } = settings?.data || {
    siteName: "Herrero Zaragoza",
    phone: "600 000 000",
    ctaText: "Llamar Ahora",
    logo: "",
};
---

<header
    id="navbar"
    class="fixed top-0 w-full z-50 transition-all duration-300 border-b border-transparent"
>
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-between h-20">
            <a href="/" class="flex items-center gap-2">
                {
                    logo ? (
                        <img
                            src={logo}
                            alt={`${siteName} Logo`}
                            class="h-12 w-auto"
                        />
                    ) : (
                        <span class="text-2xl font-heading font-bold text-primary">
                            {siteName.charAt(0)}
                        </span>
                    )
                }

                <nav class="hidden md:flex items-center gap-8">
                    <a
                        href="/"
                        class="text-sm font-medium text-heading hover:text-primary transition-colors uppercase tracking-wide"
                        >Inicio</a
                    >

                    <div class="relative group">
                        <button
                            class="text-sm font-medium text-heading hover:text-primary transition-colors uppercase tracking-wide flex items-center gap-1"
                        >
                            Servicios
                            <ChevronDown className="w-3 h-3" />
                        </button>
                        <div
                            class="absolute top-full left-0 mt-2 w-56 bg-secondary border border-heading/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
                        >
                            {
                                services.map((service) => (
                                    <a
                                        href={`/${service.slug}/`}
                                        class="block px-4 py-3 text-sm text-body hover:bg-primary/10 hover:text-primary transition-colors first:rounded-t-lg last:rounded-b-lg"
                                    >
                                        {service.data.title}
                                    </a>
                                ))
                            }
                        </div>
                    </div>

                    <div class="relative group">
                        <button
                            class="flex items-center text-sm font-medium text-heading hover:text-primary transition-colors uppercase tracking-wide gap-1"
                        >
                            Zonas
                            <ChevronDown className="w-3 h-3" />
                        </button>
                        <div
                            class="absolute top-full left-0 mt-2 w-56 bg-secondary border border-heading/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
                        >
                            {
                                locations.slice(0, 5).map((location) => (
                                    <a
                                        href={`/zona/${location.slug}/`}
                                        class="block px-4 py-3 text-sm text-body hover:bg-primary/10 hover:text-primary transition-colors first:rounded-t-lg last:rounded-b-lg"
                                    >
                                        {location.data.name}
                                    </a>
                                ))
                            }
                            <a
                                href="/zonas/"
                                class="block px-4 py-3 text-sm text-primary font-bold hover:bg-primary/10 transition-colors border-t border-heading/10"
                            >
                                Ver todas las zonas →
                            </a>
                        </div>
                    </div>

                    <a
                        href="/contacto/"
                        class="text-sm font-medium text-heading hover:text-primary transition-colors uppercase tracking-wide"
                        >Contacto</a
                    >
                </nav>

                <div class="hidden md:block">
                    <a
                        href={`tel:${phone.replace(/\s/g, "")}`}
                        class="flex items-center gap-2 bg-primary hover:bg-accent text-white px-5 py-2.5 rounded font-bold transition-all shadow-lg hover:shadow-primary/20"
                    >
                        <Phone className="w-4 h-4" />
                        <span>{phone}</span>
                    </a>
                </div>

                <button
                    id="menu-toggle"
                    class="md:hidden text-heading hover:text-primary transition-colors"
                    aria-label="Abrir menú"
                >
                    <Menu className="w-8 h-8" />
                </button>
            </a>
        </div>

        <div
            id="mobile-menu"
            class="fixed inset-0 bg-secondary z-40 transform translate-x-full transition-transform duration-300 flex flex-col justify-center items-center gap-8 md:hidden"
        >
            <button
                id="menu-close"
                class="absolute top-6 right-6 text-heading hover:text-primary"
                aria-label="Cerrar menú"
            >
                <X className="w-8 h-8" />
            </button>

            <a
                href="/"
                class="text-2xl font-heading font-bold text-heading hover:text-primary mobile-link"
                >INICIO</a
            >

            <div class="text-center">
                <p class="text-lg font-bold text-primary mb-2">SERVICIOS</p>
                <div class="flex flex-col gap-2">
                    {
                        services.map((service) => (
                            <a
                                href={`/${service.slug}/`}
                                class="text-base text-body hover:text-primary mobile-link"
                            >
                                {service.data.title}
                            </a>
                        ))
                    }
                </div>
            </div>

            <a
                href="/contacto/"
                class="text-2xl font-heading font-bold text-heading hover:text-primary mobile-link"
                >CONTACTO</a
            >

            <a
                href={`tel:${phone.replace(/\s/g, "")}`}
                class="mt-4 flex items-center gap-2 bg-primary text-white px-8 py-4 rounded text-xl font-bold"
            >
                <Phone className="w-6 h-6" />
                {ctaText || "LLAMAR AHORA"}
            </a>
        </div>
    </div>

    <script>
        // Lógica del Scroll (Glassmorphism)
        const navbar = document.getElementById("navbar");
        window.addEventListener("scroll", () => {
            if (window.scrollY > 50) {
                // Usamos bg-secondary/95 para fondo sólido al hacer scroll
                navbar?.classList.add(
                    "bg-secondary/95",
                    "backdrop-blur-sm",
                    "border-heading/10",
                    "shadow-xl",
                );
                navbar?.classList.remove("border-transparent");
            } else {
                navbar?.classList.remove(
                    "bg-secondary/95",
                    "backdrop-blur-sm",
                    "border-heading/10",
                    "shadow-xl",
                );
                navbar?.classList.add("border-transparent");
            }
        });

        // Lógica del Menú Móvil
        const menuToggle = document.getElementById("menu-toggle");
        const menuClose = document.getElementById("menu-close");
        const mobileMenu = document.getElementById("mobile-menu");
        const mobileLinks = document.querySelectorAll(".mobile-link");

        function toggleMenu() {
            mobileMenu?.classList.toggle("translate-x-full");
            document.body.classList.toggle("overflow-hidden");
        }

        menuToggle?.addEventListener("click", toggleMenu);
        menuClose?.addEventListener("click", toggleMenu);

        mobileLinks.forEach((link) => {
            link.addEventListener("click", toggleMenu);
        });
    </script>
</header>
