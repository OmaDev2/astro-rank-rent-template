---
import { SEO } from "astro-seo";
import type { WithContext, Thing } from "schema-dts";
import { getSettings } from "../lib/settings";

const settings = await getSettings();
const siteName = settings.siteName || "Herrero Zaragoza";

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: WithContext<Thing> | WithContext<Thing>[];
  noindex?: boolean;
  canonical?: string;
}

const { title, description, image, schema, noindex = false, canonical } = Astro.props;

// Generate canonical URL
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;

// OG image: prioridad → prop explícita → dinámica por ruta → fallback por nicho
const _niche = settings.niche?.toLowerCase().replace(/\s/g, "-") || "default";
const _path = Astro.url.pathname.replace(/\/$/, '');

let ogImage = image;
if (!ogImage) {
    const zonaMatch = _path.match(/^\/zona\/([^/]+)$/);
    const servicioMatch = _path.match(/^\/servicios\/([^/]+)$/);
    if (zonaMatch) {
        ogImage = `/og/zona/${zonaMatch[1]}.png`;
    } else if (servicioMatch) {
        ogImage = `/og/servicio/${servicioMatch[1]}.png`;
    } else {
        ogImage = `/images/og-${_niche}.png`;
    }
}
---

<SEO
  title={title}
  description={description}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      title,
      type: "website",
      image: ogImage,
      url: canonicalURL,
    },
    optional: {
      locale: "es_ES",
      siteName: siteName,
    },
  }}
  twitter={{
    card: "summary_large_image",
  }}
  noindex={noindex}
  nofollow={noindex}
/>

{
  schema && (
    Array.isArray(schema)
      ? schema.map((s) => (
          <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
        ))
      : <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  )
}
