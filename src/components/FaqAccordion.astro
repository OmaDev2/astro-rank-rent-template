---
import { HelpCircle, ChevronDown } from "lucide-react";

interface Props {
    title?: string;
    items: {
        question: string;
        answer: string;
    }[];
}

const { title = "Preguntas Frecuentes", items } = Astro.props;
---

<section class="py-12">
    <div
        class="bg-slate-900 border border-slate-800 rounded-xl p-8 shadow-2xl relative overflow-hidden"
    >
        <!-- Decoración de fondo -->
        <div
            class="absolute top-0 right-0 w-32 h-32 bg-amber-600/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
        >
        </div>

        <div
            class="flex items-center gap-3 mb-8 border-b border-slate-800 pb-6 relative z-10"
        >
            <div class="p-2 bg-slate-800 rounded-lg text-amber-600">
                <HelpCircle className="w-6 h-6" />
            </div>
            <h2 class="text-2xl font-heading font-bold text-white">{title}</h2>
        </div>

        <div class="space-y-4 relative z-10">
            {
                items.map((item) => (
                    <details class="group bg-slate-950 rounded-lg border border-slate-800 transition-all duration-300 hover:border-amber-600/30 open:border-amber-600/50 open:shadow-lg open:shadow-amber-900/10">
                        <summary class="flex justify-between items-center w-full p-5 cursor-pointer list-none text-left">
                            <span class="font-bold text-white group-hover:text-amber-500 transition-colors pr-8">
                                {item.question}
                            </span>
                            <span class="text-slate-500 group-open:text-amber-600 transition-transform duration-300 group-open:rotate-180 shrink-0">
                                <ChevronDown className="w-5 h-5" />
                            </span>
                        </summary>

                        <div class="px-5 pb-5 pt-0 text-slate-400 text-sm leading-relaxed border-t border-transparent group-open:border-slate-800/50 animate-fadeIn">
                            <div class="pt-3">{item.answer}</div>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* Animación suave al abrir */
    details[open] summary ~ * {
        animation: sweep 0.3s ease-in-out;
    }

    @keyframes sweep {
        0% {
            opacity: 0;
            transform: translateY(-10px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
