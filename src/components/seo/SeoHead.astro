---
import { SEO } from "astro-seo";
import type { WithContext, Thing } from "schema-dts";
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
const siteName = settings.siteName || "Herrero Zaragoza";

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: WithContext<Thing> | WithContext<Thing>[] | Record<string, any>;
  noindex?: boolean;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const { title, description, image, schema, noindex = false, canonical, ogTitle, ogDescription, twitterTitle, twitterDescription } = Astro.props;

// Generate canonical URL — always absolute, always with trailing slash
const rawCanonical = canonical || new URL(Astro.url.pathname, Astro.site).href;
const canonicalURL = rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;

// OG image: prioridad → prop explícita → dinámica por ruta → fallback por nicho
const _niche = settings.niche?.toLowerCase().replace(/\s/g, "-") || "default";
const _path = Astro.url.pathname.replace(/\/$/, '');

// OG image debe ser URL absoluta (Facebook/WhatsApp no resuelven rutas relativas).
const siteOrigin = Astro.site ? Astro.site.origin : (settings.siteUrl || "");
const toAbsolute = (path: string) =>
    path.startsWith("http") ? path : `${siteOrigin}${path}`;

let ogImage = image ? toAbsolute(image) : null;
if (!ogImage) {
    const zonaMatch = _path.match(/^\/zona\/([^/]+)$/);
    const servicioMatch = _path.match(/^\/servicios\/([^/]+)$/);
    if (zonaMatch) {
        ogImage = `${siteOrigin}/og/zona/${zonaMatch[1]}.png`;
    } else if (servicioMatch) {
        ogImage = `${siteOrigin}/og/servicio/${servicioMatch[1]}.png`;
    } else {
        ogImage = `${siteOrigin}/images/og-${_niche}.webp`;
    }
}
---

<SEO
  title={title}
  description={description}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      title: ogTitle || title,
      type: "website",
      image: ogImage,
      url: canonicalURL,
    },
    optional: {
      locale: "es_ES",
      siteName: siteName,
      description: ogDescription || description,
    },
  }}
  twitter={{
    card: "summary_large_image",
    title: twitterTitle || ogTitle || title,
    description: twitterDescription || ogDescription || description,
    image: ogImage,
  }}
  noindex={noindex}
  nofollow={noindex}
/>

{
  schema && (
    Array.isArray(schema)
      ? schema.map((s) => (
          <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
        ))
      : <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  )
}
