---
import { getSettings } from "@/lib/settings";

const settings = await getSettings();
const webhookUrl = settings.n8nWebhookUrl;

if (!webhookUrl) return;
---

<script is:inline define:vars={{ webhookUrl }}>
(function () {
  function enviar(datos) {
    try {
      if (navigator.sendBeacon) {
        navigator.sendBeacon(webhookUrl, new URLSearchParams(datos));
      } else {
        var xhr = new XMLHttpRequest();
        xhr.open("POST", webhookUrl, true);
        xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
        xhr.send(new URLSearchParams(datos).toString());
      }
    } catch (err) {
      console.warn("[ClickTracker] Error:", err);
    }
  }

  function base() {
    return {
      pagina: window.location.pathname,
      paginaCompleta: window.location.href,
      timestamp: new Date().toISOString(),
      origen: document.referrer || "directo",
      userAgent: navigator.userAgent,
      pantalla: window.innerWidth + "x" + window.innerHeight,
    };
  }

  // Clics en teléfono y WhatsApp
  document.addEventListener("click", function (e) {
    var link = e.target.closest ? e.target.closest("a[href]") : null;
    if (!link) return;

    var href = link.getAttribute("href") || "";
    var tipo = null;
    var destino = "";

    if (href.indexOf("tel:") === 0) {
      tipo = "llamada";
      destino = href.replace("tel:", "").replace("+", "");
    } else if (href.indexOf("https://wa.me") === 0 || href.indexOf("http://wa.me") === 0) {
      tipo = "whatsapp";
      destino = href;
    }

    if (!tipo) return;
    enviar(Object.assign({ tipo: tipo, destino: destino }, base()));
  });

  // Envíos de formulario
  document.addEventListener("submit", function (e) {
    var form = e.target;
    if (!form || form.tagName !== "FORM") return;
    enviar(Object.assign({
      tipo: "formulario",
      destino: form.getAttribute("name") || "contacto",
    }, base()));
  });
})();
</script>
