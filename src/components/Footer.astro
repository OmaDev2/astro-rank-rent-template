---
import ServiceAreas from "./ServiceAreas.astro";
import { Phone, Mail, MapPin } from "lucide-react";
import { businessConfig, getPhoneUrl, getEmailUrl } from "../config/business";
---

<footer class="bg-slate-950 border-t border-slate-800 pt-16 pb-8">
    <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
            <!-- Brand -->
            <div>
                <h3 class="text-2xl font-heading font-bold text-white mb-4">
                    HERRERO<span class="text-amber-600">ZARAGOZA</span>
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    {businessConfig.tagline}
                </p>
            </div>

            <!-- Contact -->
            <div>
                <h4
                    class="text-white font-bold mb-4 uppercase tracking-wider text-sm"
                >
                    Contacto
                </h4>
                <ul class="space-y-3 text-slate-400 text-sm">
                    <li class="flex items-center gap-2">
                        <Phone className="w-4 h-4 text-amber-600" />
                        <a
                            href={getPhoneUrl()}
                            class="hover:text-white transition-colors"
                            >{businessConfig.contact.phone}</a
                        >
                    </li>
                    <li class="flex items-center gap-2">
                        <Mail className="w-4 h-4 text-amber-600" />
                        <a
                            href={getEmailUrl()}
                            class="hover:text-white transition-colors"
                            >{businessConfig.contact.email}</a
                        >
                    </li>
                    <li class="flex items-center gap-2">
                        <MapPin className="w-4 h-4 text-amber-600" />
                        <span
                            >{businessConfig.contact.address.street}, {
                                businessConfig.contact.address.city
                            }</span
                        >
                    </li>
                </ul>
            </div>

            <!-- Service Areas -->
            <div class="lg:col-span-2">
                <ServiceAreas />
            </div>
        </div>

        <div
            class="border-t border-slate-900 pt-8 text-center text-slate-600 text-xs"
        >
            <div class="flex flex-wrap justify-center gap-4 mb-4">
                <a
                    href="/aviso-legal/"
                    class="hover:text-amber-500 transition-colors"
                    >Aviso Legal</a
                >
                <span class="text-slate-800">|</span>
                <a
                    href="/privacidad/"
                    class="hover:text-amber-500 transition-colors">Privacidad</a
                >
                <span class="text-slate-800">|</span>
                <a
                    href="/cookies/"
                    class="hover:text-amber-500 transition-colors">Cookies</a
                >
            </div>
            <p>
                &copy; {new Date().getFullYear()}
                {businessConfig.name}. Todos los derechos reservados.
            </p>
            <p class="text-slate-700 mt-2 text-[10px]">
                Este sitio web actúa como intermediario. No prestamos servicios
                de herrería directamente.
            </p>
        </div>
    </div>
</footer>
