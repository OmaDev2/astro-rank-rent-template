---
import ServiceAreas from "./ServiceAreas.astro";
import { Phone, Mail, MapPin } from "lucide-react";
import { getEntry } from "astro:content";

// 1. Datos Globales
const settings = await getEntry("settings", "global");
const { siteName, phone, email, address, city, niche } = settings?.data || {
    siteName: "Herrero Zaragoza",
    phone: "600 000 000",
    email: "info@example.com",
    address: "Calle Ejemplo, 123",
    city: "Zaragoza",
    niche: "Herrería",
};
---

<footer class="bg-secondary border-t border-heading/10 pt-16 pb-8">
    <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
            <div>
                <h3 class="text-2xl font-heading font-bold text-heading mb-4">
                    {siteName}
                </h3>
                <p class="text-body text-sm leading-relaxed">
                    Expertos en {niche} en {city} y provincia. Calidad profesional
                    y servicio rápido garantizado.
                </p>
            </div>

            <div>
                <h4
                    class="text-heading font-bold mb-4 uppercase tracking-wider text-sm"
                >
                    Contacto
                </h4>
                <ul class="space-y-3 text-body text-sm">
                    <li class="flex items-center gap-2">
                        <Phone className="w-4 h-4 text-primary" />
                        <a
                            href={`tel:${phone.replace(/\s/g, "")}`}
                            class="hover:text-heading transition-colors"
                        >
                            {phone}
                        </a>
                    </li>
                    <li class="flex items-center gap-2">
                        <Mail className="w-4 h-4 text-primary" />
                        <a
                            href={`mailto:${email}`}
                            class="hover:text-heading transition-colors"
                        >
                            {email}
                        </a>
                    </li>
                    {
                        address && (
                            <li class="flex items-center gap-2">
                                <MapPin className="w-4 h-4 text-primary" />
                                <span>{address}</span>
                            </li>
                        )
                    }
                </ul>
            </div>

            <div class="lg:col-span-2">
                <ServiceAreas />
            </div>
        </div>

        <div
            class="border-t border-heading/10 pt-8 text-center text-body/70 text-xs"
        >
            <div class="flex flex-wrap justify-center gap-4 mb-4">
                <a
                    href="/aviso-legal/"
                    class="hover:text-primary transition-colors">Aviso Legal</a
                >
                <span class="text-body/30">|</span>
                <a
                    href="/privacidad/"
                    class="hover:text-primary transition-colors">Privacidad</a
                >
                <span class="text-body/30">|</span>
                <a href="/cookies/" class="hover:text-primary transition-colors"
                    >Cookies</a
                >
            </div>
            <p>
                &copy; {new Date().getFullYear()}
                {siteName}. Todos los derechos reservados.
            </p>
            <p class="text-body/50 mt-2 text-[10px]">
                Este sitio web actúa como intermediario de servicios de {niche}.
            </p>
        </div>
    </div>
</footer>
