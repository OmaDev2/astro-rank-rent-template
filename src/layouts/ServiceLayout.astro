---
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import HeroContactForm from "../components/HeroContactForm.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import {
    Phone,
    CheckCircle,
    Shield,
    Wrench,
    Hammer,
    MapPin,
    ArrowRight,
    Star,
} from "lucide-react";

// Props que recibe este layout
interface Props {
    // Datos del servicio
    title: string;
    shortDesc: string;
    icon: string;
    heroImage?: string;
    faq?: Array<{ question: string; answer: string }>;
    content: any; // El componente Content renderizado
    slug: string;

    // Datos globales del negocio
    siteName: string;
    phone: string;
    whatsapp?: string;
    city: string;
    niche: string;
    address?: string;
    coordinates?: { lat: string; lng: string };

    // Listas para sidebar/navegación
    allServices: any[];
    allLocations: any[];
    testimonials: any[];

    // SEO
    pageTitle: string;
    pageDescription: string;
    schema: any;
    // Componentes MDX opcionales
    mdxComponents?: any;
}

const {
    title,
    shortDesc,
    icon,
    heroImage,
    faq,
    content: Content,
    slug,
    siteName,
    phone,
    whatsapp,
    city,
    niche,
    address,
    coordinates,
    allServices,
    allLocations,
    testimonials,
    pageTitle,
    pageDescription,
    schema,
    mdxComponents = {},
} = Astro.props;

// Mapa de Iconos
const iconMap = {
    Shield: Shield,
    Wrench: Wrench,
    Hammer: Hammer,
    MapPin: MapPin,
    CheckCircle: CheckCircle,
    default: Wrench,
};

// Aseguramos que el icono sea válido
const IconComponent = iconMap[icon as keyof typeof iconMap] || iconMap.default;

// Imagen Hero
const finalHeroImage = heroImage || `/images/services/${slug}-1.png`;
const secondaryImage = `/images/services/${slug}-2.png`;
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
    <!-- Hero Section -->
    <section
        class="relative min-h-[600px] flex items-center bg-secondary overflow-hidden py-20 lg:py-0"
    >
        <div
            class="absolute inset-0 bg-cover bg-center"
            style={`background-image: url('${finalHeroImage}')`}
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-r from-secondary/90 via-secondary/70 to-secondary/60"
        >
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-3xl">
                <div class="flex items-center gap-4 mb-6">
                    <div
                        class="bg-surface/10 backdrop-blur px-4 py-2 rounded-full flex items-center gap-2 border border-heading/20"
                    >
                        <span class="text-primary">★★★★★</span>
                        <span class="text-heading text-sm font-bold"
                            >Google Reviews</span
                        >
                    </div>
                    <div
                        class="bg-surface/10 backdrop-blur px-4 py-2 rounded-full flex items-center gap-2 border border-heading/20"
                    >
                        <Shield className="w-4 h-4 text-primary" />
                        <span class="text-heading text-sm font-bold"
                            >Garantía 100%</span
                        >
                    </div>
                </div>

                <h1
                    class="text-5xl lg:text-7xl font-heading font-bold text-heading mb-6 leading-tight"
                >
                    {title}
                    <br />
                    <span class="text-primary">en {city}</span>
                </h1>

                <p
                    class="text-xl text-body mb-8 font-light border-l-4 border-primary pl-4 max-w-xl"
                >
                    {shortDesc}
                </p>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        href={`tel:${phone.replace(/\s/g, "")}`}
                        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold bg-primary hover:bg-accent text-white rounded transition-all shadow-lg hover:shadow-primary/40"
                    >
                        <Phone className="w-5 h-5 mr-2" />
                        Llamar Ahora
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Contenido Principal + Sidebar -->
    <section class="py-20 bg-secondary">
        <div class="container mx-auto px-4 grid lg:grid-cols-3 gap-12">
            <div class="lg:col-span-2 space-y-12">
                <!-- Caja de Urgencia -->
                <div
                    class="bg-green-800/20 border border-green-700/50 p-6 rounded-xl flex flex-col sm:flex-row items-center gap-6"
                >
                    <div
                        class="bg-green-600 p-4 rounded-full shrink-0 animate-pulse"
                    >
                        <Phone className="w-8 h-8 text-white" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-heading mb-2">
                            ¿Necesitas un servicio urgente?
                        </h3>
                        <p class="text-body mb-4">
                            Si tienes una urgencia, llámanos ahora mismo.
                            Atendemos 24h.
                        </p>
                        <a
                            href={`tel:${phone.replace(/\s/g, "")}`}
                            class="text-green-600 font-bold text-2xl hover:text-green-500 transition-colors"
                        >
                            {phone}
                        </a>
                    </div>
                </div>

                <!-- Contenido MDX -->
                <div
                    class="prose prose-lg prose-headings:text-heading prose-p:text-body prose-strong:text-heading prose-li:text-body max-w-none"
                >
                    <Content components={mdxComponents} />
                </div>

                <!-- Imagen Secundaria -->
                <div
                    class="relative aspect-[16/9] rounded-2xl overflow-hidden group shadow-2xl border border-heading/10"
                >
                    <img
                        src={secondaryImage}
                        alt={`Ejemplo profesional de ${title}`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                        onerror="this.style.display='none'"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-secondary/90 via-transparent to-transparent"
                    >
                        <div class="absolute bottom-0 left-0 right-0 p-8">
                            <p class="text-heading font-bold text-2xl mb-2">
                                Trabajos Realizados en {city}
                            </p>
                            <p class="text-body">
                                Fabricación e instalación profesional con
                                garantía
                            </p>
                        </div>
                    </div>
                </div>

                <!-- FAQ -->
                {
                    faq && faq.length > 0 && (
                        <FaqAccordion
                            title={`Preguntas Frecuentes sobre ${title}`}
                            items={faq}
                        />
                    )
                }
            </div>

            <!-- Sidebar -->
            <div class="hidden lg:block space-y-8 relative">
                <div class="-mt-64 lg:-mt-[350px] relative z-20">
                    <HeroContactForm
                        title="Solicita Valoración"
                        subtitle="Respuesta en menos de 24h"
                    />
                </div>

                <!-- Oferta Banner -->
                <div
                    class="bg-gradient-to-br from-green-600 to-green-700 rounded-xl p-8 text-center shadow-xl relative overflow-hidden group"
                >
                    <div
                        class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"
                    >
                    </div>

                    <div class="relative z-10">
                        <div
                            class="text-green-100 font-bold uppercase tracking-wider text-sm mb-2"
                        >
                            Oferta Online
                        </div>
                        <div class="text-4xl font-bold text-white mb-2">
                            PRESUPUESTO
                        </div>
                        <div class="text-3xl font-bold text-white mb-6">
                            GRATIS
                        </div>
                        <p class="text-green-50 mb-6 text-sm">
                            Solicita tu valoración sin compromiso hoy mismo.
                            Respuesta rápida garantizada.
                        </p>
                        <a
                            href="#contacto"
                            class="inline-block w-full py-3 bg-white text-green-700 font-bold rounded hover:bg-green-50 transition-colors shadow-lg"
                        >
                            SOLICITAR AHORA
                        </a>
                    </div>
                </div>

                <!-- Lista de Servicios -->
                <div
                    class="bg-surface rounded-xl border border-heading/10 overflow-hidden"
                >
                    <div class="bg-surface/50 p-4 border-b border-heading/10">
                        <h4
                            class="font-bold text-heading uppercase text-sm tracking-wider"
                        >
                            Nuestros Servicios
                        </h4>
                    </div>
                    <div class="p-2">
                        <ul class="space-y-1">
                            {
                                allServices.map((service) => (
                                    <li>
                                        <a
                                            href={`/${service.slug}`}
                                            class={`block p-3 rounded transition-colors flex justify-between group ${
                                                slug === service.slug
                                                    ? "bg-primary text-white"
                                                    : "hover:bg-surface/50 text-body hover:text-primary"
                                            }`}
                                        >
                                            {service.data.title}
                                            {slug !== service.slug && (
                                                <ArrowRight className="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" />
                                            )}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>

                <!-- Lista de Zonas -->
                <div
                    class="bg-surface rounded-xl border border-heading/10 overflow-hidden"
                >
                    <div class="bg-surface/50 p-4 border-b border-heading/10">
                        <h4
                            class="font-bold text-heading uppercase text-sm tracking-wider"
                        >
                            Zonas de Servicio
                        </h4>
                    </div>
                    <div class="p-2">
                        <ul class="space-y-1">
                            <li>
                                <a
                                    href="/"
                                    class="block p-3 rounded hover:bg-surface/50 text-body hover:text-primary transition-colors text-sm"
                                >
                                    • {city} Capital
                                </a>
                            </li>
                            {
                                allLocations.slice(0, 5).map((location) => (
                                    <li>
                                        <a
                                            href={`/zona/${location.slug}`}
                                            class="block p-3 rounded hover:bg-surface/50 text-body hover:text-primary transition-colors text-sm"
                                        >
                                            • {location.data.name}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Mapa -->
    <section
        class="w-full h-[400px] bg-secondary border-y border-heading/10 relative z-10"
    >
        {
            coordinates?.lat && coordinates?.lng ? (
                <iframe
                    src={`https://maps.google.com/maps?q=${coordinates.lat},${coordinates.lng}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="opacity-80 hover:opacity-100 transition-opacity duration-500 grayscale hover:grayscale-0"
                />
            ) : (
                <iframe
                    src={`https://maps.google.com/maps?q=${encodeURIComponent(city)}&t=&z=13&ie=UTF8&iwloc=&output=embed`}
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="opacity-80 hover:opacity-100 transition-opacity duration-500 grayscale hover:grayscale-0"
                />
            )
        }
    </section>

    <!-- Resumen Servicios -->
    <section class="py-20 bg-secondary">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-heading font-bold text-heading mb-4">
                    {siteName} ofrece servicios de:
                </h2>
                <div class="w-24 h-1 bg-primary mx-auto mb-6"></div>
                <p class="text-body max-w-2xl mx-auto">
                    Soluciones profesionales en {niche.toLowerCase()} para todas
                    tus necesidades en {city} y provincia.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {
                    allServices.map((service) => (
                        <a
                            href={`/${service.slug}`}
                            class="group bg-surface/50 p-4 rounded-lg shadow-sm hover:shadow-md border border-heading/10 hover:border-primary/50 transition-all flex items-center gap-4"
                        >
                            <div class="w-10 h-10 bg-surface rounded-full flex items-center justify-center group-hover:bg-primary/20 transition-colors shrink-0">
                                <CheckCircle className="w-5 h-5 text-body group-hover:text-primary transition-colors" />
                            </div>
                            <h3 class="font-bold text-heading group-hover:text-primary transition-colors">
                                {service.data.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Testimonios -->
    <section class="py-20 bg-secondary border-t border-heading/10">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-heading font-bold text-heading mb-4">
                    Lo que dicen nuestros clientes
                </h2>
                <div class="w-24 h-1 bg-primary mx-auto"></div>
            </div>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                {
                    testimonials.slice(0, 3).map((testimonial) => (
                        <div class="bg-surface/50 p-8 rounded-xl border border-heading/10">
                            <div class="flex text-primary mb-4">
                                <span class="text-lg">
                                    {"★".repeat(testimonial.data.rating)}
                                    {"☆".repeat(5 - testimonial.data.rating)}
                                </span>
                            </div>
                            <p class="text-body mb-6 italic">
                                "{testimonial.data.text}"
                            </p>
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-surface rounded-full flex items-center justify-center text-body font-bold mr-3">
                                    {testimonial.data.initials}
                                </div>
                                <div>
                                    <div class="text-heading font-bold">
                                        {testimonial.data.name}
                                    </div>
                                    <div class="text-xs text-body/70">
                                        Cliente Verificado
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <FinalCTA />
    <WhatsAppButton />
    <Footer />
</Layout>
