---
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { CheckCircle, ArrowRight, Home, ChevronRight } from "lucide-react";

// Imports de Bloques
import HeroBlock from "../components/blocks/HeroBlock.astro";
import FeaturesBlock from "../components/blocks/FeaturesBlock.astro";
import MapBlock from "../components/blocks/MapBlock.astro";

// --- 1. DEFINICIÓN DE TIPOS (Para corregir los errores) ---

// Tipo para un Servicio
interface Service {
    slug: string;
    data: {
        title: string;
        shortDesc?: string;
    };
}

// Tipo para una Ubicación/Zona
interface Location {
    slug: string;
    data: {
        name: string;
    };
}

// Tipo para los Bloques del Page Builder
interface Block {
    discriminant: "hero" | "features" | "map" | "content" | "cta";
}

// Props del Layout
interface Props {
    locationName: string;
    locationType: "residencial" | "industrial" | "centro";
    zipCodes: string[];
    heroImage?: string;
    coordinates?: { lat?: string; lng?: string };
    faq?: Array<{ question: string; answer: string }>;
    content: any;
    siteName: string;
    phone: string;
    whatsapp?: string;
    niche: string;
    city: string;

    // Aquí aplicamos los tipos que definimos arriba
    services: Service[]; // <--- Corrige el error de 'service'
    allLocations: Location[]; // <--- Corrige el error de 'loc' y 'location'
    blocks?: Block[]; // <--- Corrige el error de 'block'

    currentSlug: string;
    pageTitle: string;
    pageDescription: string;
    schema: any;
    mdxComponents?: any;
}

const {
    locationName,
    locationType,
    zipCodes,
    heroImage,
    coordinates,
    faq,
    content: Content,
    siteName,
    phone,
    whatsapp,
    niche,
    city,
    services,
    allLocations,
    currentSlug,
    pageTitle,
    pageDescription,
    schema,
    mdxComponents = {},
    blocks,
} = Astro.props;

// Orden por defecto si no se configura en Keystatic (Retrocompatibilidad)
const defaultBlocks: Block[] = [
    { discriminant: "hero" },
    { discriminant: "features" },
    { discriminant: "content" }, // Contenido + Sidebar
    { discriminant: "cta" },
    { discriminant: "map" },
];

const finalBlocks = blocks && blocks.length > 0 ? blocks : defaultBlocks;
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
    <section class="bg-surface/50 border-b border-heading/10 py-3">
        <div class="container mx-auto px-4">
            <nav class="flex items-center gap-2 text-sm text-body">
                <a
                    href="/"
                    class="hover:text-primary transition-colors flex items-center gap-1"
                >
                    <Home className="w-4 h-4" /> Inicio
                </a>
                <ChevronRight className="w-4 h-4 text-body/50" />
                <a href="/zonas/" class="hover:text-primary transition-colors"
                    >Zonas</a
                >
                <ChevronRight className="w-4 h-4 text-body/50" />
                <span class="text-heading font-medium">{locationName}</span>
            </nav>
        </div>
    </section>

    {
        finalBlocks.map((block) => {
            switch (block.discriminant) {
                case "hero":
                    return <HeroBlock {...Astro.props} />;

                case "features":
                    return <FeaturesBlock {...Astro.props} />;

                case "map":
                    return <MapBlock {...Astro.props} />;

                case "cta":
                    return <FinalCTA />;

                case "content":
                    return (
                        <section class="py-20 bg-secondary">
                            <div class="container mx-auto px-4 grid lg:grid-cols-3 gap-12">
                                {/* COLUMNA IZQUIERDA: CONTENIDO + SERVICIOS + FAQ */}
                                <div class="lg:col-span-2 space-y-12">
                                    <div class="prose prose-lg prose-headings:text-heading prose-p:text-body prose-strong:text-primary prose-li:text-body max-w-none">
                                        <Content components={mdxComponents} />
                                    </div>

                                    {/* Lista de Servicios en la Zona */}
                                    <div>
                                        <h2 class="text-3xl font-heading font-bold text-heading mb-8">
                                            Servicios de {niche} en{" "}
                                            {locationName}
                                        </h2>
                                        <div class="grid md:grid-cols-2 gap-6">
                                            {services.map((service) => (
                                                <a
                                                    href={`/${service.slug}`}
                                                    class="group p-6 bg-surface/50 border border-heading/10 rounded-lg hover:border-primary/50 transition-all block"
                                                >
                                                    <div class="flex items-center justify-between mb-4">
                                                        <h3 class="text-xl font-bold text-heading group-hover:text-primary transition-colors">
                                                            {service.data.title}
                                                        </h3>
                                                        <ArrowRight className="w-5 h-5 text-body/70 group-hover:text-primary group-hover:translate-x-1 transition-all" />
                                                    </div>
                                                    <p class="text-body text-sm line-clamp-2">
                                                        {service.data.shortDesc}{" "}
                                                        Disponible en{" "}
                                                        {locationName}.
                                                    </p>
                                                </a>
                                            ))}
                                        </div>
                                    </div>

                                    {/* FAQ */}
                                    {faq && faq.length > 0 && (
                                        <FaqAccordion
                                            title={`Preguntas Frecuentes en ${locationName}`}
                                            items={faq}
                                        />
                                    )}
                                </div>

                                {/* SIDEBAR (Fijo en el bloque de contenido) */}
                                <div class="space-y-8">
                                    <div class="p-8 bg-surface rounded-lg border border-heading/10 sticky top-24 shadow-2xl">
                                        <h3 class="text-2xl font-heading font-bold text-heading mb-6 border-b border-heading/10 pb-4">
                                            Contacto Directo
                                        </h3>
                                        <ul class="space-y-4 mb-8">
                                            <li class="flex items-start gap-3">
                                                <CheckCircle className="w-6 h-6 text-primary shrink-0 mt-1" />
                                                <span class="text-body text-sm">
                                                    Presupuesto sin compromiso
                                                </span>
                                            </li>
                                            <li class="flex items-start gap-3">
                                                <CheckCircle className="w-6 h-6 text-primary shrink-0 mt-1" />
                                                <span class="text-body text-sm">
                                                    Atención en {locationName}
                                                </span>
                                            </li>
                                        </ul>
                                        <a
                                            href={`tel:${phone.replace(/\s/g, "")}`}
                                            class="flex flex-col items-center justify-center w-full py-4 bg-surface/50 hover:bg-surface text-heading border border-heading/20 rounded font-bold transition-all group hover:border-primary/50 mb-4"
                                        >
                                            <span class="text-xs text-body/70 uppercase tracking-widest mb-1 group-hover:text-primary">
                                                Llamar Ahora
                                            </span>
                                            <span class="text-2xl font-heading">
                                                {phone}
                                            </span>
                                        </a>
                                        <a
                                            href={`https://wa.me/${whatsapp?.replace(/\s/g, "") || phone.replace(/\s/g, "")}`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex flex-col items-center justify-center w-full py-4 bg-green-600 hover:bg-green-700 text-white border border-green-700 rounded font-bold transition-all group"
                                        >
                                            <span class="text-xs text-green-100 uppercase tracking-widest mb-1">
                                                WhatsApp
                                            </span>
                                            <span class="text-lg font-heading">
                                                Consultar Disponibilidad
                                            </span>
                                        </a>
                                    </div>

                                    {/* Otras Zonas */}
                                    <div class="bg-surface rounded-lg border border-heading/10 overflow-hidden">
                                        <div class="bg-surface/50 p-4 border-b border-heading/10">
                                            <h4 class="font-bold text-heading uppercase text-sm tracking-wider">
                                                Otras Zonas
                                            </h4>
                                        </div>
                                        <div class="p-2">
                                            <ul class="space-y-1">
                                                {allLocations
                                                    .filter(
                                                        (loc) =>
                                                            loc.slug !==
                                                            currentSlug,
                                                    )
                                                    .slice(0, 6)
                                                    .map((location) => (
                                                        <li>
                                                            <a
                                                                href={`/zona/${location.slug}`}
                                                                class="block p-3 rounded hover:bg-surface/50 text-body hover:text-primary transition-colors text-sm flex justify-between items-center group"
                                                            >
                                                                <span>
                                                                    •{" "}
                                                                    {
                                                                        location
                                                                            .data
                                                                            .name
                                                                    }
                                                                </span>
                                                                <ArrowRight className="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" />
                                                            </a>
                                                        </li>
                                                    ))}
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    );
            }
        })
    }

    <WhatsAppButton />
    <Footer />
</Layout>

<style>
    @keyframes formPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(var(--color-primary), 0.7);
            transform: scale(1);
        }
        50% {
            box-shadow: 0 0 0 20px rgba(var(--color-primary), 0);
            transform: scale(1.02);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(var(--color-primary), 0);
            transform: scale(1);
        }
    }
    .form-highlight {
        animation: formPulse 1s ease-out 2;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const formLink = document.querySelector('a[href="#formulario"]');
        const formElement = document.getElementById("formulario");
        if (formLink && formElement) {
            formLink.addEventListener("click", (event) => {
                event.preventDefault();
                formElement.scrollIntoView({
                    behavior: "smooth",
                    block: "center",
                });
                setTimeout(() => {
                    formElement.classList.add("form-highlight");
                    setTimeout(
                        () => formElement.classList.remove("form-highlight"),
                        2000,
                    );
                }, 500);
            });
        }
    });
</script>
