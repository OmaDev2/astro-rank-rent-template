---
import SeoHead from "../components/seo/SeoHead.astro";
import Navbar from "../components/layout/Navbar.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import CookieBanner from "../components/ui/CookieBanner.astro";
import SearchConsoleVerification from "../components/seo/SearchConsoleVerification.astro";
import ClickTracker from "../components/seo/ClickTracker.astro";
import CallbackModal from "../components/ui/CallbackModal.astro";
import { generateWebSiteSchema } from "../lib/seo";
import "../styles/global.css";
import type { WithContext, Thing } from "schema-dts";
import heroImageSrc from "../assets/images/hero-home.png";
import { getImage } from "astro:assets";

// 1. Imports de configuración
import { getSettings } from "../lib/settings";
import { themes } from "../config/themes";
import { fontPairs } from "../config/fonts"; // Importante: Debes haber creado este archivo
import { getThemeColors, hexToRgb } from "../utils/theme";

// 2. Recuperar TODA la configuración unificada
const settings = (await getSettings()) as any;

// 3. Lógica del Tema (Colores)
let activeTheme = themes.industrial; // Default fallback
let colors = activeTheme.colors;

try {
    // Parsear el string JSON del nuevo campo ThemeManager
    const themeState =
        typeof settings.themeSettings === "string"
            ? JSON.parse(settings.themeSettings)
            : settings.themeSettings; // Por si acaso ya viene parseado o es objeto

    if (themeState && themeState.theme) {
        // Resolver el preset primero para usarlo como fallback de tokens nuevos
        const knownTheme = themes[themeState.theme as keyof typeof themes];
        activeTheme = knownTheme ?? (null as any);

        if (themeState.colors) {
            const toRgb = (val: string) => {
                if (!val) return "0 0 0";
                if (val.includes(" ")) return val;
                if (val.startsWith("#")) return hexToRgb(val);
                return val;
            };

            const preset = knownTheme?.colors as any;

            colors = {
                primary:        toRgb(themeState.colors.primary),
                secondary:      toRgb(themeState.colors.secondary),
                surface:        toRgb(themeState.colors.surface),
                accent:         toRgb(themeState.colors.accent),
                textMain:       toRgb(themeState.colors.textMain),
                textSecondary:  toRgb(themeState.colors.textSecondary  || preset?.textSecondary  || themeState.colors.textMuted),
                textMuted:      toRgb(themeState.colors.textMuted),
                textSubtle:     toRgb(themeState.colors.textSubtle     || preset?.textSubtle     || themeState.colors.textMuted),
                accentDark:     toRgb(themeState.colors.accentDark     || preset?.accentDark     || themeState.colors.accent),
            };
        }
    }
} catch (e) {
    console.error("Error parsing theme settings", e);
}

// Gradiente
const gradient =
    activeTheme?.gradient ||
    `linear-gradient(135deg, rgb(${colors.primary}) 0%, rgb(${colors.secondary}) 100%)`;

// Hero overlay: temas claros usan un color oscuro en lugar de secondary
const heroOverlay = (activeTheme as any)?.heroOverlay || colors.secondary;

// 4. Lógica de Fuentes (Tipografía)
// Si settings.fontPair no existe (porque no has actualizado settings.ts), usa 'modern' por defecto
const activeFont =
    fontPairs[settings.fontPair as keyof typeof fontPairs] || fontPairs.modern;

interface Props {
    title: string;
    description?: string;
    image?: string;
    canonical?: string;
    schema?: WithContext<Thing> | WithContext<Thing>[] | Record<string, any>;
    noindex?: boolean;
    canonicalUrl?: string;
    ogTitle?: string;
    ogDescription?: string;
    twitterTitle?: string;
    twitterDescription?: string;
}

const {
    title,
    description,
    image,
    canonical,
    schema,
    noindex = false,
    canonicalUrl,
    ogTitle,
    ogDescription,
    twitterTitle,
    twitterDescription,
} = Astro.props;

// Generar descripción por defecto si no viene en props
const defaultDescription = `${settings.niche} en ${settings.city}. Expertos profesionales, servicio rápido y presupuesto sin compromiso en ${settings.siteName}.`;

// Si el schema ya incluye @graph (nuevo patrón), no añadir webSiteSchema legacy para evitar duplicados
const siteUrl = Astro.site?.href?.replace(/\/$/, "") || settings.siteUrl || "";
const hasGraph = schema && !Array.isArray(schema) && '@graph' in (schema as any);
const webSiteSchema = generateWebSiteSchema(settings.siteName, siteUrl);
const allSchemas = hasGraph
    ? schema
    : schema
        ? (Array.isArray(schema) ? [webSiteSchema, ...schema] : [webSiteSchema, schema])
        : [webSiteSchema];

// Hero Opacity (Default 0.6)
const heroOpacity = settings.heroOverlayOpacity ?? 0.6;

// Border Radius
const radiusMap: Record<string, string> = {
    sharp:   '0px',
    subtle:  '6px',
    rounded: '0.75rem',
    smooth:  '1.25rem',
    pill:    '1.25rem',
};
const btnRadiusMap: Record<string, string> = {
    sharp:   '0px',
    subtle:  '6px',
    rounded: '0.75rem',
    smooth:  '1.25rem',
    pill:    '9999px',
};
const radiusKey = settings.borderRadius || 'rounded';
const radiusCard = radiusMap[radiusKey] ?? '0.75rem';
const radiusBtn  = btnRadiusMap[radiusKey] ?? '0.75rem';

// Button Style
const buttonStyle = settings.buttonStyle || 'solid';

// Typography Scale
let typoHeadingScale = 1.0;
let typoBodyPx = 16;
try {
    const typoState = settings.typographyScale ? JSON.parse(settings.typographyScale) : { heading: "md", body: "md" };
    const headingScales: Record<string, number> = { xs: 0.82, sm: 0.92, md: 1.0, lg: 1.12, xl: 1.28 };
    const bodySizes: Record<string, number> = { xs: 14, sm: 15, md: 16, lg: 17, xl: 18 };
    
    typoHeadingScale = headingScales[typoState.heading] ?? 1.0;
    typoBodyPx = bodySizes[typoState.body] ?? 16;
} catch (e) {
    console.error("Error parsing typography scale settings", e);
}

// Shadow presets — theme-adaptive: the hairline ring uses --color-text-main
// (light on dark themes, dark on light themes) so it's always visible.
// The primary glow adds branded depth on both theme types.
const shadowMap: Record<string, string> = {
    flat:     'none',
    subtle:   '0 2px 12px -1px rgb(0 0 0 / 0.22), 0 0 0 1px rgb(var(--color-text-main) / 0.06)',
    elevated: '0 8px 24px -4px rgb(0 0 0 / 0.32), 0 4px 8px -2px rgb(0 0 0 / 0.16), 0 0 0 1px rgb(var(--color-text-main) / 0.08)',
    floating: '0 20px 48px -8px rgb(0 0 0 / 0.42), 0 8px 16px -4px rgb(0 0 0 / 0.22), 0 0 0 1px rgb(var(--color-text-main) / 0.10), 0 4px 20px rgb(var(--color-primary) / 0.12)',
};
const shadowValue = shadowMap[settings.shadowStyle || 'elevated'] ?? shadowMap.elevated;

// Section spacing presets
const spacingMap: Record<string, string> = {
    compact:  '3rem',
    normal:   '5rem',
    spacious: '8rem',
};
const sectionPy = spacingMap[settings.sectionSpacing || 'normal'] ?? spacingMap.normal;

// Animation + Navbar style
const animationStyle = settings.animationStyle || 'subtle';
const navbarStyle    = settings.navbarStyle    || 'glass';
const sectionDivider = settings.sectionDivider || 'none';
const bgTexture      = settings.bgTexture      || 'none';
const heroStyle      = settings.heroStyle      || 'image';
const headingStyle   = settings.headingStyle   || 'normal';

// Preload hero image en home para optimizar LCP
const isHome = Astro.url.pathname === "/";
const heroProcessed = isHome
    ? await getImage({ src: heroImageSrc, format: "webp", quality: 80 })
    : null;
---

<!doctype html>
<html
    lang="es"
    class="scroll-smooth"
    data-btn-style={buttonStyle}
    data-anim={animationStyle}
    data-navbar={navbarStyle}
    data-divider={sectionDivider}
    data-texture={bgTexture}
    data-heading-style={headingStyle}
    style={{
        // --- VARIABLES DE COLOR ---
        "--color-primary": colors.primary,
        "--color-secondary": colors.secondary,
        "--color-surface": colors.surface,
        "--color-accent": colors.accent,
        "--color-accent-dark": (colors as any).accentDark || colors.accent,
        "--color-text-heading": colors.textMain,
        "--color-text-main": colors.textMain,
        "--color-text-secondary": (colors as any).textSecondary || colors.textMuted,
        "--color-text-body": colors.textMuted,
        "--color-text-muted": colors.textMuted,
        "--color-text-subtle": (colors as any).textSubtle || colors.textMuted,
        "--theme-gradient": gradient,
        "--hero-opacity": heroOpacity,
        "--hero-overlay": heroOverlay,

        // --- VARIABLES DE FUENTE ---
        "--font-heading": activeFont.fontHeading,
        "--font-body": activeFont.fontBody,

        // --- VARIABLES DE FORMA ---
        "--radius": radiusCard,
        "--radius-btn": radiusBtn,

        // --- VARIABLES DE ESCALA ---
        "--heading-scale": typoHeadingScale,
        "--body-font-size": `${typoBodyPx}px`,

        // --- VARIABLES DE SOMBRA Y ESPACIADO ---
        "--shadow-card": shadowValue,
        "--section-py": sectionPy,
    }}
>
    <head>
        <meta charset="UTF-8" />
        {heroProcessed && (
            <link
                rel="preload"
                as="image"
                href={heroProcessed.src}
                type="image/webp"
                fetchpriority="high"
                imagesizes="100vw"
            />
        )}
        <meta name="viewport" content="width=device-width" />
        {/* #5 — Staging noindex: bloquea indexación en previews de Netlify */}
        {import.meta.env.PUBLIC_SITE_ENV !== "production" && (
            <meta name="robots" content="noindex,nofollow" />
        )}
        {settings.favicon
            ? <link rel="icon" href={settings.favicon} />
            : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        }
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content={settings.themeColor || `rgb(${colors.primary})`} />
        {settings.customCss && <style set:html={settings.customCss}></style>}

        {/* --- CARGA DINÁMICA DE FUENTES DE GOOGLE --- */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
        <link
            href={`${activeFont.googleFontsUrl}&display=swap`}
            rel="stylesheet"
        />

        <SeoHead
            title={title}
            description={description || defaultDescription}
            image={image}
            schema={allSchemas}
            noindex={noindex}
            canonical={canonical || canonicalUrl}
            ogTitle={ogTitle}
            ogDescription={ogDescription}
            twitterTitle={twitterTitle}
            twitterDescription={twitterDescription}
        />

        <SearchConsoleVerification />

        {/* Google Tag Manager */}
        {
            settings.gtmId && (
                <script type="text/partytown">
                    {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${settings.gtmId}');`}
                </script>
            )
        }

        {/* Google Analytics 4 */}
        {
            settings.googleAnalyticsId && (
                <>
                    <script
                        type="text/partytown"
                        src={`https://www.googletagmanager.com/gtag/js?id=${settings.googleAnalyticsId}`}
                    />
                    <script type="text/partytown">
                        {`window.dataLayer = window.dataLayer || [];
                        function gtag(){dataLayer.push(arguments);}
                        gtag('consent', 'default', {analytics_storage:'denied',ad_storage:'denied',wait_for_update:500});
                        gtag('js', new Date());
                        gtag('config', '${settings.googleAnalyticsId}');`}
                    </script>
                    <script is:inline>
                        {/* Restore consent on page load if user already accepted */}
                        (function(){
                            try {
                                const match = document.cookie.match(/(?:^|;\s*)cookie_consent=([^;]*)/);
                                if (!match) return;
                                const consent = JSON.parse(decodeURIComponent(match[1]));
                                if (consent && consent.analytics) {
                                    window.dataLayer = window.dataLayer || [];
                                    (function gtag(){ window.dataLayer.push(arguments); })('consent','update',{analytics_storage:'granted'});
                                }
                            } catch(e){}
                        })();
                    </script>
                </>
            )
        }
    </head>

    <body
        class="bg-secondary text-text font-sans antialiased selection:bg-primary selection:text-white"
    >
        {/* GTM noscript fallback */}
        {
            settings.gtmId && (
                <noscript>
                    <iframe
                        src={`https://www.googletagmanager.com/ns.html?id=${settings.gtmId}`}
                        height="0"
                        width="0"
                        style="display:none;visibility:hidden"
                    />
                </noscript>
            )
        }
        <Navbar />

        <main>
            <slot />
        </main>

        <WhatsAppButton />
        <CookieBanner />
        <CallbackModal />
        <ClickTracker />

        {/* Scroll animations — respects data-anim attribute */}
        <script is:inline>
            (function () {
                var mode = document.documentElement.dataset.anim || 'subtle';
                if (mode === 'none') return;

                // ── Secciones: fade / slide al entrar en viewport ──
                var sections = document.querySelectorAll('main > * > section, main > section');
                if (!sections.length) sections = document.querySelectorAll('section');
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('anim-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.08 });
                sections.forEach(function (el, i) {
                    if (i === 0) return; // hero siempre visible
                    el.classList.add('anim-ready');
                    observer.observe(el);
                });

                // ── Tarjetas [data-stagger]: entrada escalonada ──
                var staggerEls = document.querySelectorAll('[data-stagger]');
                var staggerObs = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) return;
                        Array.from(entry.target.children).forEach(function (child, i) {
                            child.style.transitionDelay = (i * 90) + 'ms';
                            child.classList.add('anim-visible');
                        });
                        staggerObs.unobserve(entry.target);
                    });
                }, { threshold: 0.05 });
                staggerEls.forEach(function (container) {
                    Array.from(container.children).forEach(function (child) {
                        child.classList.add('anim-ready');
                    });
                    staggerObs.observe(container);
                });
            })();
        </script>
    </body>
</html>
