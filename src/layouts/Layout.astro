---
import SeoHead from "../components/SeoHead.astro";
import Navbar from "../components/Navbar.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CookieBanner from "../components/CookieBanner.astro";
import SearchConsoleVerification from "../components/SearchConsoleVerification.astro";
import "../styles/global.css";
import type { WithContext, Thing } from "schema-dts";
import { getEntry } from "astro:content";
import { themes } from "../config/themes";

// 1. Recuperar Configuración Global
const business = await getEntry("business", "global");
const design = await getEntry("design", "global");
const analytics = await getEntry("analytics", "global");

const { siteName, niche, city } = business?.data || {
    siteName: "Herrero Zaragoza",
    niche: "Herrería",
    city: "Zaragoza",
};

const { theme } = design?.data || { theme: "industrial" };
const { googleAnalyticsId, gtmId } = analytics?.data || {
    googleAnalyticsId: "",
    gtmId: "",
};

// 2. Lógica del Tema
const activeTheme = themes[theme as keyof typeof themes] || themes.industrial;
const colors = activeTheme.colors;
const gradient = activeTheme.gradient;

interface Props {
    title: string;
    description?: string;
    schema?: WithContext<Thing> | WithContext<Thing>[];
    noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;

// 3. Generar SEO por defecto dinámico
const defaultDescription = `${niche} en ${city}. Expertos profesionales, servicio rápido y presupuesto sin compromiso en ${siteName}.`;
---

<!doctype html>
<html
    lang="es"
    class="scroll-smooth"
    style={{
        "--color-primary": colors.primary,
        "--color-secondary": colors.secondary,
        "--color-surface": colors.surface,
        "--color-accent": colors.accent,
        "--color-text-heading": colors.textMain,
        "--color-text-body": colors.textMuted,
        "--theme-gradient": gradient,
    }}
>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700&family=Inter:wght@400;600&family=Oswald:wght@400;700&family=Roboto:wght@400;500&display=swap"
            rel="stylesheet"
        />

        <SeoHead
            title={title}
            description={description || defaultDescription}
            schema={schema}
            noindex={noindex}
        />

        <SearchConsoleVerification />

        {/* Google Tag Manager */}
        {
            gtmId && (
                <script type="text/partytown">
                    {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${gtmId}');`}
                </script>
            )
        }

        {/* Google Analytics 4 */}
        {
            googleAnalyticsId && (
                <script
                    type="text/partytown"
                    src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
                />
            )
        }
        {
            googleAnalyticsId && (
                <script type="text/partytown">
                    {`window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${googleAnalyticsId}');`}
                </script>
            )
        }
    </head>

    <body
        class="bg-secondary text-text font-sans antialiased selection:bg-primary selection:text-white"
    >
        {/* GTM noscript fallback */}
        {
            gtmId && (
                <noscript>
                    <iframe
                        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
                        height="0"
                        width="0"
                        style="display:none;visibility:hidden"
                    />
                </noscript>
            )
        }
        <Navbar />

        <main>
            <slot />
        </main>

        <WhatsAppButton />
        <CookieBanner />
    </body>
</html>
