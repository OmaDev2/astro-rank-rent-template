---
import SeoHead from "../components/SeoHead.astro";
import Navbar from "../components/Navbar.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CookieBanner from "../components/CookieBanner.astro";
import "../styles/global.css";
import type { WithContext, Thing } from "schema-dts";
import { getEntry } from "astro:content";
import { themes } from "../config/themes";

// 1. Recuperar Configuración Global
const settings = await getEntry("settings", "global");
const { siteName, niche, city, theme } = settings?.data || {
    siteName: "Herrero Zaragoza",
    niche: "Herrería",
    city: "Zaragoza",
    theme: "industrial",
};

// 2. Lógica del Tema
const activeTheme = themes[theme as keyof typeof themes] || themes.industrial;
const colors = activeTheme.colors;
const gradient = activeTheme.gradient;

interface Props {
    title: string;
    description?: string;
    schema?: WithContext<Thing> | WithContext<Thing>[];
    noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;

// 3. Generar SEO por defecto dinámico
const defaultDescription = `${niche} en ${city}. Expertos profesionales, servicio rápido y presupuesto sin compromiso en ${siteName}.`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <style
            define:vars={{
                "color-primary": colors.primary,
                "color-secondary": colors.secondary,
                "color-accent": colors.accent,
                "theme-gradient": gradient,
            }}
        >
            :root {
                --color-primary: var(--color-primary);
                --color-secondary: var(--color-secondary);
                --color-accent: var(--color-accent);
                --theme-gradient: var(--theme-gradient);
            }
        </style>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700&family=Inter:wght@400;600&family=Oswald:wght@400;700&family=Roboto:wght@400;500&display=swap"
            rel="stylesheet"
        />

        <SeoHead
            title={title}
            description={description || defaultDescription}
            schema={schema}
            noindex={noindex}
        />
    </head>

    <body
        class="bg-body text-text font-sans antialiased selection:bg-primary selection:text-white"
    >
        <Navbar />

        <main>
            <slot />
        </main>

        <WhatsAppButton />
        <CookieBanner />
    </body>
</html>
